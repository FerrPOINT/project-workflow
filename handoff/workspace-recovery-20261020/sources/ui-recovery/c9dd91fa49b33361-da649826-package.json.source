{
  "name": "project-workflow-react-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 17753",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "ssr:sync": "node ../../services-base/frontend/scripts/export-ssr.mjs --out ../project_workflow/interfaces/ui/static/base-ui",
    "ssr:check": "node ../../services-base/frontend/scripts/export-ssr.mjs --out ../project_workflow/interfaces/ui/static/base-ui --check",
    "ui:check": "node ../../services-base/frontend/scripts/check-ui-contract.mjs --repo .. --require-installed"
  },
  "dependencies": {
    "@sdlc/ui": "file:../../services-base/frontend",
    "@tanstack/react-query": "5.103.2",
    "i18next": "25.10.10",
    "lucide-react": "0.545.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "16.6.6",
    "react-router": "8.4.0",
    "yaml": "2.9.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
