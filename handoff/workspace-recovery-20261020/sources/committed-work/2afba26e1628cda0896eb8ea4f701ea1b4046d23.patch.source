diff --git a/frontend/src/jinjaNavigation.test.ts b/frontend/src/jinjaNavigation.test.ts
index b74a7c2..dd406d8 100644
--- a/frontend/src/jinjaNavigation.test.ts
+++ b/frontend/src/jinjaNavigation.test.ts
@@ -9,11 +9,18 @@ const template = readFileSync(resolve(cwd(), '../project_workflow/interfaces/ui/
 const handler = template.match(/function switchNamespace\(namespaceId\)\{[\s\S]*?(?=function setPlatformTheme)/)?.[0]
 if (!handler) throw new Error('Jinja namespace handler is missing')
 
-function switchNamespace(path: string, namespaceId: string) {
+function switchNamespace(path: string, namespaceId: string, allow = true) {
   const location = { href: `http://localhost${path}` }
-  const document = { cookie: '' }
-  runInNewContext(`${handler}\nswitchNamespace(namespaceId)`, { URL, window: { location }, document, namespaceId })
-  return { url: new URL(location.href), cookie: document.cookie }
+  const selector = { value: namespaceId, dataset: { currentNamespace: '1' } }
+  const document = { cookie: '', getElementById: () => selector }
+  const navigateWorkflow = (url: string, updateContext: () => void) => {
+    if (!allow) return Promise.resolve(false)
+    updateContext()
+    location.href = url
+    return Promise.resolve(true)
+  }
+  runInNewContext(`${handler}\nswitchNamespace(namespaceId)`, { URL, window: { location }, document, namespaceId, navigateWorkflow })
+  return { url: new URL(location.href), cookie: document.cookie, selector: selector.value }
 }
 
 describe('Jinja namespace navigation', () => {
@@ -41,4 +48,11 @@ describe('Jinja namespace navigation', () => {
     expect(url.href).toBe('http://localhost/phases?workflow_id=2&mode_id=3')
     expect(cookie).toBe('')
   })
+
+  it('restores the selector without changing context when navigation is rejected', () => {
+    const result = switchNamespace('/namespaces?namespace_id=1#editor', '9', false)
+    expect(result.url.href).toBe('http://localhost/namespaces?namespace_id=1#editor')
+    expect(result.cookie).toBe('')
+    expect(result.selector).toBe('1')
+  })
 })
