+var workflowDraftGuard = null;
+function registerWorkflowDraftGuard(state){
+  function attach(){
+    workflowDraftGuard = BaseDraftGuard.attach(Object.assign({}, state, {
+      dialog: document.querySelector('[data-base-draft-dialog]'),
+      fallbackFocus: function(){ return document.querySelector('main[tabindex="-1"]'); },
+    }));
+  }
+  if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', attach, {once:true}); }
+  else { attach(); }
+}
+function requestWorkflowTransition(transition){
+  if(workflowDraftGuard){ return workflowDraftGuard.requestLeave(transition); }
+  transition();
+  return Promise.resolve(true);
+}
+function navigateWorkflow(url, beforeNavigate){
+  if(workflowDraftGuard){ return workflowDraftGuard.navigate(url, beforeNavigate); }
+  if(beforeNavigate){ beforeNavigate(); }
+  window.location.assign(url);
+  return Promise.resolve(true);
+}
