+async function performNamespaceWrite(method, id, payload){
+  if(namespaceMutationPending || namespaceUnknownWrite || namespaceTerminalState){ return; }
+  var attempt = {method:method,id:id,payload:payload};
+  var destination;
+  namespaceMutationPending = true;
+  showNamespaceWriteError('');
+  updateNamespaceWriteControls();
+  document.getElementById('namespaceSubmitButton').textContent = method === 'POST' ? 'Создание…' : 'Сохранение…';
+  if(method === 'DELETE'){ document.getElementById('deleteNamespaceButton').textContent = 'Удаление…'; }
+  try {
+    var response = await fetch('/api/namespaces' + (id == null ? '' : '/' + id), {
+      method:method,headers:{'Content-Type':'application/json'},body:payload ? JSON.stringify(payload) : undefined,
+    });
+    var data;
+    try { data = await response.json(); } catch(_error){ data = null; }
+    if(!response.ok || !data || data.ok !== true){
+      if(response.status >= 500 || response.status === 408 || response.ok){ unknownNamespaceWrite(attempt); }
+      else {
+        namespaceTerminalState = response.status === 403 ? 'permission-denied' : response.status === 404 ? 'not-found' : null;
+        showNamespaceWriteError(data && typeof data.error === 'string' ? data.error : 'Изменения не сохранены. Проверьте поля и доступ.', namespaceTerminalState);
       }
-    })
-    .catch(showRequestError);
+      return;
+    }
+    if(method !== 'DELETE' && (!data.namespace || !Number.isInteger(data.namespace.id) || data.namespace.id <= 0 ||
+      (method === 'PUT' && data.namespace.id !== id) || (method === 'POST' && data.namespace_id !== data.namespace.id) ||
+      !namespaceMatchesPayload(data.namespace, payload))){ unknownNamespaceWrite(attempt); return; }
+    destination = acknowledgeNamespaceWrite(attempt, data.namespace);
+  } catch(_error){ unknownNamespaceWrite(attempt); }
+  finally {
+    namespaceMutationPending = false;
+    setNamespaceFormMode(namespaceFormMode);
+    updateNamespaceWriteControls();
+  }
+  return finishNamespaceDeparture(destination);
+}
+async function reconcileNamespaceWrite(){
+  if(namespaceMutationPending || !namespaceUnknownWrite){ return; }
+  var attempt = namespaceUnknownWrite;
+  var destination;
+  namespaceMutationPending = true;
+  updateNamespaceWriteControls();
+  try {
+    var response = await fetch('/api/namespaces');
+    var data = await response.json();
+    if(!response.ok || !data.ok || !Array.isArray(data.namespaces)){ throw new Error('Catalogue unavailable'); }
+    var saved = data.namespaces.find(function(item){ return attempt.method === 'POST' ? item.cli_command === attempt.payload.cli_command : item.id === attempt.id; });
+    if(attempt.method === 'DELETE' ? !saved : saved && namespaceMatchesPayload(saved, attempt.payload)){
+      destination = acknowledgeNamespaceWrite(attempt, saved);
+    } else {
+      showNamespaceWriteError('Сохранение пока не подтверждено. Повторная запись заблокирована.');
+    }
+  } catch(_error){ showNamespaceWriteError('Не удалось проверить сохранение. Значения сохранены в форме, повторная запись заблокирована.'); }
+  finally { namespaceMutationPending = false; updateNamespaceWriteControls(); }
+  return finishNamespaceDeparture(destination);
 }
