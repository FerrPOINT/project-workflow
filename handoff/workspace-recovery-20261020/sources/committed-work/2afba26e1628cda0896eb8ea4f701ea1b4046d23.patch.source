diff --git a/frontend/playwright.config.ts b/frontend/playwright.config.ts
new file mode 100644
index 0000000..4dec879
--- /dev/null
+++ b/frontend/playwright.config.ts
@@ -0,0 +1,20 @@
+import { defineConfig } from '@playwright/test'
+
+const origin = process.env.WORKFLOW_UI_QA_ORIGIN
+if (!origin) throw new Error('WORKFLOW_UI_QA_ORIGIN must identify an isolated, already-started Workflow fixture')
+const url = new URL(origin)
+if (!['127.0.0.1', 'localhost'].includes(url.hostname)) throw new Error('SSR state QA is loopback-only')
+
+export default defineConfig({
+  testDir: './e2e',
+  fullyParallel: false,
+  workers: 1,
+  retries: 0,
+  reporter: [['list'], ['json', { outputFile: '../.smoke/namespace-drafts/result.json' }]],
+  outputDir: '../.smoke/namespace-drafts/captures',
+  use: { baseURL: url.origin, screenshot: 'only-on-failure', trace: 'retain-on-failure' },
+  projects: [
+    { name: 'desktop', use: { viewport: { width: 1920, height: 1080 } } },
+    { name: 'mobile', use: { viewport: { width: 375, height: 1080 } } },
+  ],
+})
