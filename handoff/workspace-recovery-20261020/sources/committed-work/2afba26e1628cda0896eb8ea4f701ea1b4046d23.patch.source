diff --git a/CHANGELOG.md b/CHANGELOG.md
index 80a7d06..7095927 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -13,6 +13,13 @@
 - Standalone-режим: репозиторий собирается и запускается без соседнего `services-base` (убраны extra `cli-platform`, uv source, Docker additional_context и CI checkout). Token-режим CLI без `sdlc-cli-core` выдаёт понятную ошибку; запуск без `AUTH_ISSUER` работает без авторизации.
 
 ### Fixed
+- Namespace forms use the Base SSR draft guard for links, context selectors,
+  create cancellation and indexed Back/Forward. Pending writes block duplicates;
+  rejected writes retain fields, while unknown outcomes require read-only
+  reconciliation instead of another mutation. Acknowledged create/delete reload
+  the correct SSR composition; cancelled deletion restores trigger focus.
+- Namespace previews update canonical accent tokens, retaining the Base readable
+  foreground across themes instead of overriding its legacy aliases.
 - Jinja pages use the Base page header in the work area: one h1, one owner of
   page actions across desktop/mobile, and shared error/403/404 states. Phase mode
   controls use the Base responsive target token instead of a fixed 40 px height.
diff --git a/docs/UI_UX_MAP.md b/docs/UI_UX_MAP.md
index d52f48a..39870d2 100644
--- a/docs/UI_UX_MAP.md
+++ b/docs/UI_UX_MAP.md
@@ -50,7 +50,8 @@ runtime-build-manifest и ui-build. Совместимость со штатны
 
 ## Текущая Композиция Страниц
 
-Base snapshot `94169d1` поставляет React primitives и SSR `page_header`/`state`.
+Base поставляет React primitives и SSR `page_header`/`state`; фактическая версия
+определяется build fingerprint, а не историческим SHA из описания композиции.
 Jinja показывает единственный `h1` в рабочей области; верхний header содержит
 контекст, а действия страницы находятся в общем page header без мобильных дублей.
 Task title/context используют Base scale; error/403/404 используют Base states,
@@ -61,6 +62,14 @@ React URL `namespace_id=` означает явный default/all scope и не
 старую cookie после reload. Этот маркер сохраняется в pilot navigation, но не
 передаётся в numeric API/Jinja query. Ссылка Jinja редактора получает существующий
 namespace с matching workflow; при неразрешённом default context она скрыта.
+
+Редактор namespace использует Base SSR draft guard: ссылки, selector, отмена
+создания и indexed Back/Forward не сбрасывают черновик без подтверждения.
+Pending блокирует повтор и уход, известные ошибки сохраняют значения, 403/404
+блокируют CRUD. Неизвестный исход записи блокирует повтор до read-only сверки
+с существующим namespace catalogue; отрицательная сверка не считается успехом.
+После подтверждённого create/delete загружается соответствующая SSR-композиция.
+Preview задаёт canonical accent tokens, не переопределяя readable alias Base.
 Нет новых endpoint, auth store или изменений основного Jinja/runtime bridge.
 Актуальные source gates и browser evidence фиксируются отдельно; immutable image,
 SSO/roles/states/drafts и release provenance остаются обязательной отдельной проверкой.
diff --git a/docs/quality-gate.md b/docs/quality-gate.md
index 51fa4a6..bc0f67c 100644
--- a/docs/quality-gate.md
+++ b/docs/quality-gate.md
@@ -154,6 +154,25 @@ node scripts/capture_ui_screenshots.mjs
 Для backend-only тестовых или документационных изменений browser smoke не
 обязателен.
 
+## Namespace SSR State Tests
+
+Start the documented source preview with an isolated neutral SQLite smoke
+fixture (never a runtime database). In another terminal run:
+
+```powershell
+$env:WORKFLOW_UI_QA_ORIGIN = "http://127.0.0.1:8812"
+pnpm --dir frontend test:ssr
+```
+
+The runner requires an already-started loopback fixture with `workflow-dev`
+and `workflow-qa` namespaces. It does not launch containers or mutate fixture
+data: unexpected API writes are blocked; write/error scenarios use explicit
+route fixtures. It checks desktop/mobile draft, context/history, pending,
+reconciliation and focus behavior. Captures and JSON results are stored in
+`.smoke/namespace-drafts`; archive them with source/Base fingerprints before
+another run. These tests supplement, not replace, no-mock route smoke, full
+Python/PostgreSQL gates and actual-image/SSO acceptance.
+
 ## CLI Wrappers
 
 После изменений в CRUD неймспейсов, bootstrap или CLI selector path дополнительно
diff --git a/frontend/e2e/namespace-drafts.spec.ts b/frontend/e2e/namespace-drafts.spec.ts
new file mode 100644
index 0000000..88f21e4
--- /dev/null
+++ b/frontend/e2e/namespace-drafts.spec.ts
@@ -0,0 +1,267 @@
+import { expect, test, type Page } from '@playwright/test'
+
+type Namespace = { id: number; cli_command: string; name: string; [key: string]: unknown }
+let namespaces: Namespace[]
+let dev: Namespace
+let qa: Namespace
+
+const dialog = (page: Page) => page.locator('[data-base-draft-dialog]')
+const cancel = (page: Page) => page.locator('[data-base-draft-cancel]')
+const discard = (page: Page) => page.locator('[data-base-draft-discard]')
+
+test.beforeEach(async ({ page, request }) => {
+  const response = await request.get('/api/namespaces')
+  expect(response.ok()).toBeTruthy()
+  namespaces = (await response.json()).namespaces
+  dev = namespaces.find(item => item.cli_command === 'workflow-dev')!
+  qa = namespaces.find(item => item.cli_command === 'workflow-qa')!
+  expect(dev).toBeDefined()
+  expect(qa).toBeDefined()
+  await page.route('**/api/**', async route => {
+    if (route.request().method() === 'GET') return route.continue()
+    throw new Error(`Unplanned mutation: ${route.request().method()} ${route.request().url()}`)
+  })
+})
+
+async function openEditor(page: Page, create = false) {
+  await page.goto(`/namespaces${create ? '/new' : ''}?namespace_id=${dev.id}`)
+  await expect(page.locator('#namespaceName')).toBeEnabled()
+  await expect(dialog(page)).not.toBeVisible()
+}
+
+async function selectNamespace(page: Page, id: number) {
+  if (await page.locator('#namespaceSelect').isVisible()) {
+    await page.locator('#namespaceSelect').selectOption(String(id))
+  } else {
+    await page.locator(`[data-namespace-id="${id}"]`).click()
+  }
+}
+
+for (const theme of ['dark', 'gray', 'light']) {
+  test(`context cancellation preserves draft, cookie and focus (${theme})`, async ({ page }) => {
+    await page.addInitScript(value => {
+      localStorage.setItem('theme', value)
+      localStorage.setItem('workflow-theme', value)
+    }, theme)
+    await openEditor(page)
+    const url = page.url()
+    const cookie = await page.context().cookies()
+    await page.locator('#namespaceName').fill('Unsaved namespace')
+    await selectNamespace(page, qa.id)
+    await expect(dialog(page)).toBeVisible()
+    await expect(cancel(page)).toBeFocused()
+    await page.keyboard.press('Escape')
+    await expect(dialog(page)).not.toBeVisible()
+    await expect(page.locator('#namespaceName')).toHaveValue('Unsaved namespace')
+    expect(page.url()).toBe(url)
+    expect(await page.context().cookies()).toEqual(cookie)
+    await expect(page.locator('#namespaceSelector')).toHaveValue(String(dev.id))
+    await page.locator('#namespaceSelector').focus()
+    await page.locator('#namespaceSelector').selectOption(String(qa.id))
+    await expect(dialog(page)).toBeVisible()
+    await cancel(page).click()
+    await expect(page.locator('#namespaceSelector')).toBeFocused()
+    await expect(page.locator('#namespaceSelector')).toHaveValue(String(dev.id))
+    expect(page.url()).toBe(url)
+    await page.screenshot({ path: test.info().outputPath(`namespace-${theme}.png`), fullPage: true })
+  })
+}
+
+test('accepted global context transition has no second native prompt', async ({ page }) => {
+  await openEditor(page)
+  await page.locator('#namespaceName').fill('Unsaved context')
+  const nativeDialogs: string[] = []
+  page.on('dialog', async prompt => { nativeDialogs.push(prompt.type()); await prompt.dismiss() })
+  await page.locator('#namespaceSelector').selectOption(String(qa.id))
+  await expect(dialog(page)).toBeVisible()
+  await discard(page).click()
+  await expect(page).toHaveURL(new RegExp(`namespace_id=${qa.id}`))
+  await expect(page.locator('#namespaceName')).toHaveValue(qa.name)
+  expect(nativeDialogs).toEqual([])
+})
+
+test('Back cancellation restores the accepted URL; confirmed Back and Forward restore fields', async ({ page }) => {
+  await openEditor(page)
+  await selectNamespace(page, qa.id)
+  await expect(page.locator('#namespaceName')).toHaveValue(qa.name)
+  const accepted = page.url()
+  const length = await page.evaluate(() => history.length)
+  await page.locator('#namespaceName').fill('Unsaved history')
+  await page.evaluate(() => history.back())
+  await expect(dialog(page)).toBeVisible()
+  expect(page.url()).toBe(accepted)
+  await cancel(page).click()
+  await expect(page.locator('#namespaceName')).toHaveValue('Unsaved history')
+  expect(await page.evaluate(() => history.length)).toBe(length)
+  await page.evaluate(() => history.back())
+  await expect(dialog(page)).toBeVisible()
+  await discard(page).click()
+  await expect(page.locator('#namespaceName')).toHaveValue(dev.name)
+  await expect(page).toHaveURL(new RegExp(`namespace_id=${dev.id}`))
+  await page.evaluate(() => history.forward())
+  await expect(page.locator('#namespaceName')).toHaveValue(qa.name)
+  expect(await page.evaluate(() => history.length)).toBe(length)
+})
+
+test('create cancellation protects draft and reloads the catalogue composition on discard', async ({ page }) => {
+  await openEditor(page, true)
+  await expect(page.locator('[data-page-layout="reading"]')).toBeVisible()
+  await page.locator('#namespaceName').fill('Unsaved creation')
+  await page.locator('#cancelCreateButton').click()
+  await expect(dialog(page)).toBeVisible()
+  await cancel(page).click()
+  await expect(page.locator('#namespaceName')).toHaveValue('Unsaved creation')
+  await page.locator('#cancelCreateButton').click()
+  await discard(page).click()
+  await expect(page.locator('[data-page-layout="wide"]')).toBeVisible()
+  await expect(page.locator('#namespaceName')).toHaveValue(dev.name)
+})
+
+test('sidebar and native reload cancellation retain the draft', async ({ page }) => {
+  await openEditor(page)
+  await page.locator('#namespaceName').fill('Protected navigation')
+  const url = page.url()
+  if (await page.locator('#burgerBtn').isVisible()) await page.locator('#burgerBtn').click()
+  const link = page.locator('.sidebar-link:visible[href^="/tasks"]').first()
+  await link.click()
+  await expect(dialog(page)).toBeVisible()
+  await page.keyboard.press('Escape')
+  await expect(link).toBeFocused()
+  await expect(page.locator('#namespaceName')).toHaveValue('Protected navigation')
+  expect(page.url()).toBe(url)
+  if (await page.locator('[data-base-drawer]:open').count()) {
+    await page.locator('[data-base-drawer-close]').click()
+  }
+  const nativeDialog = page.waitForEvent('dialog')
+  await page.evaluate(() => { setTimeout(() => location.reload(), 0) })
+  const prompt = await nativeDialog
+  expect(prompt.type()).toBe('beforeunload')
+  await prompt.dismiss()
+  await expect(page.locator('#namespaceName')).toHaveValue('Protected navigation')
+  expect(page.url()).toBe(url)
+})
+
+test('hash navigation preserves draft and does not remove reload protection', async ({ page }) => {
+  await openEditor(page)
+  await page.locator('#namespaceName').fill('Fragment draft')
+  await page.evaluate(() => { location.hash = 'namespaceForm' })
+  await expect(page).toHaveURL(/#namespaceForm$/)
+  await page.evaluate(() => history.back())
+  await expect(page).toHaveURL(new RegExp(`namespace_id=${dev.id}$`))
+  await expect(page.locator('#namespaceName')).toHaveValue('Fragment draft')
+  await expect(dialog(page)).not.toBeVisible()
+})
+
+test('cancelled deletion restores focus without a mutation', async ({ page }) => {
+  await page.route('**/namespaces?**', async route => {
+    const response = await route.fetch()
+    const body = await response.text()
+    // Only change this isolated page's catalogue fixture, never the server data.
+    const match = body.match(/const namespaceStore = (\[[^\n]*\]);/)
+    expect(match).not.toBeNull()
+    const catalogue: Namespace[] = JSON.parse(match![1])
+    const fixture = catalogue.map(item => ({ ...item, task_count: 0 }))
+    await route.fulfill({ response, body: body.replace(match![0], `const namespaceStore = ${JSON.stringify(fixture)};`) })
+  })
+  await openEditor(page)
+  const trigger = page.locator('#deleteNamespaceButton')
+  await expect(trigger).toBeEnabled()
+  await trigger.click()
+  await expect(page.locator('#confirmDialog')).toBeVisible()
+  await page.keyboard.press('Escape')
+  await expect(page.locator('#confirmDialog')).not.toBeVisible()
+  await expect(trigger).toBeFocused()
+  await expect(page.locator('#namespaceName')).toBeEnabled()
+})
+
+for (const status of [409, 422, 403, 404]) {
+  test(`rejected write ${status} preserves values and classifies state`, async ({ page }) => {
+    await openEditor(page)
+    let writes = 0
+    await page.route(`**/api/namespaces/${dev.id}`, async route => {
+      expect(route.request().method()).toBe('PUT')
+      writes++
+      await route.fulfill({ status, json: { ok: false, error: `Fixture rejection ${status}` } })
+    })
+    await page.locator('#namespaceName').fill('Rejected draft')
+    await page.locator('#namespaceDescription').fill('Retained description')
+    await page.locator('#namespaceSubmitButton').click()
+    await expect(page.locator('#namespaceWriteError')).toContainText(`Fixture rejection ${status}`)
+    await expect(page.locator('#namespaceName')).toHaveValue('Rejected draft')
+    await expect(page.locator('#namespaceDescription')).toHaveValue('Retained description')
+    const kind = status === 403 ? 'permission-denied' : status === 404 ? 'not-found' : 'error'
+    await expect(page.locator(`#namespaceWriteError [data-page-state="${kind}"]`)).toBeVisible()
+    if (status === 403 || status === 404) await expect(page.locator('#namespaceName')).toBeDisabled()
+    else await expect(page.locator('#namespaceName')).toBeEnabled()
+    await expect(page.locator('#namespaceReconcileButton')).not.toBeVisible()
+    expect(writes).toBe(1)
+  })
+}
+
+test('pending save blocks duplicate submission and departure; acknowledged save clears the stale dialog', async ({ page }) => {
+  await openEditor(page)
+  let writes = 0
+  let release!: () => void
+  const held = new Promise<void>(resolve => { release = resolve })
+  await page.route(`**/api/namespaces/${dev.id}`, async route => {
+    writes++
+    const payload = route.request().postDataJSON()
+    await held
+    await route.fulfill({ json: { ok: true, namespace: { ...dev, ...payload } } })
+  })
+  try {
+    await page.locator('#namespaceName').fill('Acknowledged draft')
+    await page.locator('#namespaceSubmitButton').click()
+    await expect(page.locator('#namespaceName')).toBeDisabled()
+    await expect(page.locator('#namespaceForm')).toHaveAttribute('aria-busy', 'true')
+    await page.evaluate(() => { const ui = window as unknown as { submitNamespace: () => void }; ui.submitNamespace(); ui.submitNamespace() })
+    await selectNamespace(page, qa.id)
+    await expect(dialog(page)).toBeVisible()
+    await expect(discard(page)).toBeDisabled()
+    release()
+    await expect(dialog(page)).not.toBeVisible()
+    await expect(page.locator('#namespaceName')).toBeEnabled()
+    await expect(page.locator('#namespaceName')).toHaveValue('Acknowledged draft')
+    await expect(page).toHaveURL(new RegExp(`namespace_id=${dev.id}`))
+    expect(writes).toBe(1)
+    await selectNamespace(page, qa.id)
+    await expect(dialog(page)).not.toBeVisible()
+    await expect(page.locator('#namespaceName')).toHaveValue(qa.name)
+  } finally { release() }
+})
+
+for (const outcome of ['server-error', 'network-error', 'invalid-ack']) {
+  test(`unknown ${outcome} blocks retries until read-only reconciliation`, async ({ page }) => {
+    await openEditor(page)
+    let writes = 0
+    let payload: Record<string, unknown>
+    await page.route(`**/api/namespaces/${dev.id}`, async route => {
+      writes++
+      payload = route.request().postDataJSON()
+      if (outcome === 'network-error') await route.abort('failed')
+      else await route.fulfill({ status: outcome === 'server-error' ? 503 : 200, json: { ok: true } })
+    })
+    await page.locator('#namespaceName').fill('Unknown outcome')
+    await page.locator('#namespaceSubmitButton').click()
+    await expect(page.locator('#namespaceReconcileButton')).toBeVisible()
+    await expect(page.locator('#namespaceName')).toBeDisabled()
+    await page.evaluate(() => (window as unknown as { submitNamespace: () => void }).submitNamespace())
+    expect(writes).toBe(1)
+    await page.locator('#namespaceReconcileButton').click()
+    await expect(page.locator('#namespaceWriteError')).toContainText('Сохранение пока не подтверждено')
+    await expect(page.locator('#namespaceName')).toBeDisabled()
+    await expect(page.locator('#namespaceName')).toHaveValue('Unknown outcome')
+    await page.route('**/api/namespaces', route => route.fulfill({ status: 503, json: { ok: false } }))
+    await page.locator('#namespaceReconcileButton').click()
+    await expect(page.locator('#namespaceWriteError')).toContainText('Не удалось проверить сохранение')
+    await expect(page.locator('#namespaceName')).toBeDisabled()
+    await page.route('**/api/namespaces', route => route.fulfill({ json: {
+      ok: true, namespaces: namespaces.map(item => item.id === dev.id ? { ...item, ...payload } : item),
+    } }))
+    await page.locator('#namespaceReconcileButton').click()
+    await expect(page.locator('#namespaceName')).toBeEnabled()
+    await expect(page.locator('#namespaceReconcileButton')).not.toBeVisible()
+    await expect(page.locator('#namespaceName')).toHaveValue('Unknown outcome')
+    expect(writes).toBe(1)
+  })
+}
