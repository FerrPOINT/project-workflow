--- a/tests/test_ui.py
+++ b/tests/test_ui.py
@@ -19,6 +19,7 @@ from project_workflow.infrastructure.db.uow import SAUnitOfWork
 from project_workflow.interfaces.cli.core import cli
 from project_workflow.interfaces.ui import _app_state as ui_app_state
 from project_workflow.interfaces.ui import _load_cli_reference, app
+from project_workflow.interfaces.ui.platform_services import ServiceCatalog
 from tests._db_helpers import phase_by_code
 
 client = TestClient(app)
@@ -527,10 +528,35 @@ class TestPhasesPage:
         assert 'class="sidebar-service-menu"' in response.text
         assert 'id="sidebarThemeSelector"' in response.text
         assert 'id="themeSelector"' in response.text
-        assert ".header-actions > .theme-select,.header-actions > .service-menu{display:none}" in response.text
-        assert ".header-actions{width:auto;flex:1;min-width:0" in response.text
+        assert ".header-actions > .theme-select,.header-title-group > .service-menu{display:none}" in response.text
+        assert ".header-actions{width:auto;flex:0 1 auto;min-width:0;gap:6px;flex-wrap:nowrap" in response.text
+        assert ".header{flex-wrap:nowrap;align-items:center;height:var(--header-height)" in response.text
+        assert ".header-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}" in response.text
         assert response.text.count("document.querySelectorAll('.theme-select').forEach") == 2
 
+    def test_service_switcher_is_left_aligned_and_requires_admin_console(self):
+        admin = {"key": "admin-panel", "label": "Admin Panel", "url": "http://localhost:7772", "health": "healthy"}
+        with patch(
+            "project_workflow.interfaces.ui.routes.pages.load_service_catalog",
+            return_value=ServiceCatalog([admin], "runtime"),
+        ):
+            connected = client.get("/")
+
+        assert connected.status_code == 200
+        assert 'id="serviceMenu"' in connected.text
+        assert connected.text.index('id="serviceMenu"') < connected.text.index('<h1 class="header-title">')
+        assert "Project Workflow" in connected.text
+
+        with patch(
+            "project_workflow.interfaces.ui.routes.pages.load_service_catalog",
+            return_value=ServiceCatalog([admin], "fallback-unreachable"),
+        ):
+            disconnected = client.get("/")
+
+        assert disconnected.status_code == 200
+        assert 'id="serviceMenu"' not in disconnected.text
+        assert 'class="sidebar-service-menu"' not in disconnected.text
+
     def test_sidebar_places_namespaces_first(self):
         response = client.get("/phases")
         assert response.status_code == 200
