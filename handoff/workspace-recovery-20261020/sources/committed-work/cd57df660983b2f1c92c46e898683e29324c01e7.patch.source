diff --git a/tests/test_platform_services.py b/tests/test_platform_services.py
index 2effc02..25aeeb4 100644
--- a/tests/test_platform_services.py
+++ b/tests/test_platform_services.py
@@ -4,6 +4,7 @@ import json
 from pathlib import Path
 
 from project_workflow.interfaces.ui.platform_services import (
+    ServiceCatalog,
     _normalize,
     load_other_services,
     load_service_catalog,
@@ -27,6 +28,15 @@ def test_fallback_without_catalog_url():
     services = load_other_services(None)
     assert all(s["key"] != "project-workflow" for s in services)
     assert len(services) >= 5
+    assert not load_service_catalog(None).admin_console_connected
+
+
+def test_admin_console_visibility_requires_live_catalog_entry():
+    admin_service = {"key": "admin-panel", "label": "Admin Panel", "url": "http://admin"}
+
+    assert ServiceCatalog([admin_service], "runtime").admin_console_connected
+    assert not ServiceCatalog([admin_service], "runtime-cached").admin_console_connected
+    assert not ServiceCatalog([], "runtime").admin_console_connected
 
 
 def test_fallback_reuses_remote_request_host():
