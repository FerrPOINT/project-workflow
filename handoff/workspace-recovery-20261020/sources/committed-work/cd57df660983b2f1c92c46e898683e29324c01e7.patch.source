diff --git a/project_workflow/interfaces/ui/platform_services.py b/project_workflow/interfaces/ui/platform_services.py
index 20f021c..2a21131 100644
--- a/project_workflow/interfaces/ui/platform_services.py
+++ b/project_workflow/interfaces/ui/platform_services.py
@@ -34,6 +34,12 @@ class ServiceCatalog:
     services: list[dict[str, Any]]
     source: str
 
+    @property
+    def admin_console_connected(self) -> bool:
+        return self.source == "runtime" and any(
+            service["key"] == "admin-panel" for service in self.services
+        )
+
 
 def _normalize(entry: dict[str, Any]) -> dict[str, Any] | None:
     key = entry.get("key")
