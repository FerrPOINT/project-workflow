diff --cc tests/test_build_provenance.py
index 0000000,60252c3..11b67f0
mode 000000,100644..100644
--- a/tests/test_build_provenance.py
+++ b/tests/test_build_provenance.py
@@@ -1,0 -1,493 +1,631 @@@
+ from __future__ import annotations
+ 
+ import gzip
+ import hashlib
+ import importlib.util
+ import io
+ import json
+ import os
+ import re
+ import shlex
+ import shutil
