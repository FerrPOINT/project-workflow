diff --git a/tests/test_readiness_correlation.py b/tests/test_readiness_correlation.py
new file mode 100644
index 0000000..da13a20
--- /dev/null
+++ b/tests/test_readiness_correlation.py
@@ -0,0 +1,48 @@
+import asyncio
+import time
+from threading import Event
+from unittest.mock import patch
+from uuid import UUID, uuid4
+
+from fastapi.testclient import TestClient
+
+from project_workflow.interfaces.ui.app import _health, create_app
+
+
+def test_readiness_timeout_does_not_queue_more_workers():
+    release = Event()
+    entered = Event()
+
+    def blocked():
+        entered.set()
+        release.wait(10)
+        raise RuntimeError("synthetic blocked database")
+
+    async def check():
+        with patch("project_workflow.interfaces.ui.app._health_sync", side_effect=blocked) as probe:
+            started = time.monotonic()
+            try:
+                result = await _health()
+                assert result.status_code == 503
+                assert time.monotonic() - started < 4
+                assert entered.is_set()
+                second = await _health()
+                assert second.status_code == 503
+                assert probe.call_count == 1
+            finally:
+                release.set()
+                await asyncio.sleep(0.05)
+
+    asyncio.run(check())
+
+
+def test_error_response_preserves_uuid_and_old_json_shape():
+    client = TestClient(create_app(), raise_server_exceptions=False)
+    request_id = str(uuid4())
+    response = client.get("/api/unknown-page", headers={"X-Request-Id": request_id})
+    assert response.status_code == 404
+    assert response.headers["X-Request-Id"] == request_id
+    assert response.json() == {"ok": False, "error": "Ресурс не найден"}
+    assert "X-Request-Id" in response.headers["Access-Control-Expose-Headers"]
+    response = client.get("/api/unknown-page", headers={"X-Request-Id": "invalid"})
+    assert UUID(response.headers["X-Request-Id"])
