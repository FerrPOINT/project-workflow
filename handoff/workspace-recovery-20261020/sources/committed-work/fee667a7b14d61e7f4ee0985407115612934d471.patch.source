+async def _health() -> JSONResponse:
+    """Bound the probe, including pool acquisition, without blocking the ASGI loop."""
+    def unavailable() -> JSONResponse:
+        return JSONResponse({"ok": False, "version": __version__, "database": "error",
+                             "schema": "unknown", "catalog": "unknown",
+                             "error_code": "database-unavailable", "db_latency_ms": 2000}, status_code=503)
+
+    if not _readiness_worker.acquire(blocking=False):
+        return unavailable()
+
+    def check() -> JSONResponse:
