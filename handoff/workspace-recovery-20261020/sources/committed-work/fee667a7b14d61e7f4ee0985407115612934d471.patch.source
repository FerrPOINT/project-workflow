diff --git a/project_workflow/interfaces/ui/templates/base-assets/base-ui.css b/project_workflow/interfaces/ui/templates/base-assets/base-ui.css
new file mode 100644
index 0000000..574669c
--- /dev/null
+++ b/project_workflow/interfaces/ui/templates/base-assets/base-ui.css
@@ -0,0 +1,291 @@
+:root {
+  --color-background: #09090b;
+  --color-surface: #18181b;
+  --color-surface-raised: #27272a;
+  --color-border: #27272a;
+  --color-border-strong: #3f3f46;
+  --color-text-primary: #fafafa;
+  --color-text-secondary: #d4d4d8;
+  --color-text-muted: #a1a1aa;
+  --color-accent: #818cf8;
+  --color-accent-foreground: #18181b;
+  --color-accent-hover: #a5b4fc;
+  --color-danger: #f87171;
+  --color-success: #4ade80;
+  --color-warning: #fbbf24;
+  --color-focus: var(--color-accent);
+  --color-popover: var(--color-surface);
+  --color-popover-foreground: var(--color-text-primary);
+  /* Compatibility aliases for one release. */
+  --color-primary: var(--color-accent);
+  --color-primary-foreground: var(--color-accent-foreground);
+  --color-secondary: var(--color-surface-raised);
+  --color-secondary-foreground: var(--color-text-primary);
+  --color-muted: var(--color-surface-raised);
+  --color-muted-foreground: var(--color-text-muted);
+  --color-destructive: var(--color-danger);
+  --color-destructive-foreground: #18181b;
+}
+
+:root {
+  --shell-sidebar-expanded: 264px;
+  --shell-sidebar-compact: 72px;
+  --shell-header-height: 60px;
+  --shell-page-gutter: clamp(16px, 2vw, 32px);
+  --shell-page-block-gap: 20px;
+  --shell-control-min: 40px;
+  --shell-control-mobile-min: 44px;
+  --shell-readable-width: 760px;
+  --shell-aside-width: 320px;
+  --base-font-body: 14px;
+  --base-font-label: 12px;
+  --base-font-page-title: 24px;
+  --base-radius: 6px;
+}
+
+.base-control { min-height: var(--shell-control-min); }
+.base-icon-control { min-width: var(--shell-control-min); }
+.base-app-shell { min-height: 100dvh; background: var(--color-background); color: var(--color-text-primary); font-size: var(--base-font-body); letter-spacing: 0; }
+.base-shell-sidebar { position: fixed; inset: var(--shell-header-height) auto 0 0; z-index: 20; display: flex; width: var(--shell-sidebar-expanded); flex-direction: column; border-right: 1px solid var(--color-border); background: var(--color-surface); }
+.base-shell-brand { display: flex; height: var(--shell-header-height); flex-shrink: 0; align-items: center; padding: 0 20px; border-bottom: 1px solid var(--color-border); }
+.base-shell-identity { display: flex; min-width: 0; align-items: center; gap: 12px; }
+.base-shell-identity-text { min-width: 0; }
+.base-shell-navigation-scroll { min-height: 0; flex: 1; overflow-y: auto; padding: 12px; }
+.base-shell-navigation { display: flex; flex-direction: column; gap: 4px; }
+.base-shell-link { display: flex; min-height: var(--shell-control-min); min-width: 0; align-items: center; gap: 12px; padding: 8px 12px; border-radius: var(--base-radius); color: var(--color-text-secondary); }
+.base-shell-nav-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.base-shell-link:hover, .base-shell-link.is-active { background: var(--color-surface-raised); color: var(--color-text-primary); }
+.base-shell-link:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
+.base-shell-work { min-width: 0; padding-left: var(--shell-sidebar-expanded); }
+.base-shell-main { min-height: calc(100dvh - var(--shell-header-height)); outline: none; }
+.base-shell-drawer-trigger, .base-shell-mobile-title { display: none; }
+.base-shell-collapse { align-self: center; margin-top: 8px; }
+@media (min-width: 1280px) {
+  .base-app-shell[data-sidebar-collapsed="true"] .base-shell-sidebar { width: var(--shell-sidebar-compact); }
+  .base-app-shell[data-sidebar-collapsed="true"] .base-shell-work { padding-left: var(--shell-sidebar-compact); }
+  .base-app-shell[data-sidebar-collapsed="true"] .base-shell-nav-label { display: none; }
+  .base-app-shell[data-sidebar-collapsed="true"] .base-shell-link { justify-content: center; padding: 8px; }
+}
+@media (max-width: 1279px) { .base-shell-collapse { display: none; } }
+.base-shell-drawer { left: 0; top: 0; display: flex; height: 100dvh; max-height: 100dvh; width: min(320px, calc(100% - 2rem)); max-width: none; transform: none; flex-direction: column; gap: 0; border-radius: 0; border-top: 0; border-bottom: 0; border-left: 0; padding: 0; }
+dialog.base-shell-drawer { position: fixed; margin: 0; color: var(--color-text-primary); background: var(--color-surface); border-color: var(--color-border); }
+dialog.base-shell-drawer:not([open]) { display: none; }
+dialog.base-shell-drawer::backdrop { background: rgb(0 0 0 / 65%); }
+.base-shell-drawer-title { display: flex; height: var(--shell-header-height); flex-shrink: 0; align-items: center; border-bottom: 1px solid var(--color-border); padding: 0 56px 0 16px; }
+.base-page-stack { display: flex; min-width: 0; flex-direction: column; gap: var(--shell-page-block-gap); }
+.base-page-header { display: flex; min-width: 0; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 12px; }
+.base-page-title { overflow-wrap: anywhere; font-size: var(--base-font-page-title); font-weight: 600; line-height: 1.25; letter-spacing: 0; }
+.base-page-actions, .base-filter-row { display: flex; min-width: 0; flex-wrap: wrap; align-items: center; gap: 8px; }
+.base-form-field { display: flex; min-width: 0; flex-direction: column; gap: 6px; }
+
+@media (min-width: 768px) and (max-width: 1279px) {
+  .base-shell-sidebar { width: var(--shell-sidebar-compact); }
+  .base-shell-brand { justify-content: center; padding: 0 8px; }
+  .base-shell-identity-text, .base-shell-nav-label { display: none; }
+  .base-shell-navigation-scroll { padding: 12px 8px; }
+  .base-shell-link { justify-content: center; padding: 8px; }
+  .base-shell-work { padding-left: var(--shell-sidebar-compact); }
+}
+@media (max-width: 767px) {
+  .base-control, .base-shell-link { min-height: var(--shell-control-mobile-min); }
+  .base-icon-control { min-width: var(--shell-control-mobile-min); }
+  .base-shell-sidebar { display: none; }
+  .base-shell-work { padding-left: 0; }
+  .base-shell-drawer-trigger { display: inline-flex; }
+  .base-shell-mobile-title { display: block; max-width: 80px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
+  .base-page-header, .base-page-actions { width: 100%; }
+}
+
+.shell-main {
+  min-width: 0;
+  width: 100%;
+}
+
+.platform-header {
+  position: sticky;
+  top: 0;
+  z-index: 30;
+  display: flex;
+  min-width: 0;
+  height: var(--shell-header-height);
+  align-items: center;
+  gap: 8px;
+  padding-inline: 12px;
+  border-bottom: 1px solid var(--color-border);
+  background: var(--color-surface);
+}
+
+.platform-header-leading,
+.platform-header-context,
+.platform-header-actions {
+  display: flex;
+  min-width: 0;
+  align-items: center;
+  gap: 8px;
+}
+
+.platform-header-context {
+  flex: 1;
+}
+
+.platform-header-services,
+.platform-header-actions {
+  flex-shrink: 0;
+}
+
+.platform-header-actions {
+  margin-left: auto;
+}
+
+.platform-header [data-platform-header-slot] :is(button, a, input, select) {
+  min-height: var(--shell-control-mobile-min);
+  min-width: var(--shell-control-mobile-min);
+}
+
+.service-switcher-label {
+  max-width: 160px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+@media (min-width: 768px) {
+  .platform-header {
+    padding-inline: 16px;
+  }
+
+  .platform-header [data-platform-header-slot] :is(button, a, input, select) {
+    min-height: var(--shell-control-min);
+    min-width: var(--shell-control-min);
+  }
+}
+
+.page-frame {
+  min-width: 0;
+  width: 100%;
+  padding: var(--shell-page-gutter);
+}
+
+.page-wide,
+.page-detail {
+  min-width: 0;
+  width: 100%;
+}
+
+.page-readable {
+  min-width: 0;
+  width: min(100%, var(--shell-readable-width));
+}
+
+.page-split {
+  display: grid;
+  min-width: 0;
+  width: 100%;
+  grid-template-columns: minmax(0, 1fr) var(--shell-aside-width);
+  gap: var(--shell-page-block-gap);
+}
+
+@media (max-width: 1023px) {
+  .page-split {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+[data-theme='gray'] {
+  --color-background: #1f1f23;
+  --color-surface: #2a2a2f;
+  --color-surface-raised: #3f3f46;
+  --color-border: #3f3f46;
+  --color-border-strong: #52525b;
+  --color-text-primary: #f4f4f5;
+  --color-text-secondary: #e4e4e7;
+  --color-text-muted: #b4b4bd;
+  --color-accent: #a5b4fc;
+  --color-accent-foreground: #18181b;
+  --color-accent-hover: #818cf8;
+  --color-danger: #fca5a5;
+  --color-destructive-foreground: #18181b;
+  --color-success: #86efac;
+  --color-warning: #fde047;
+}
+
+[data-theme='light'] {
+  --color-background: #f4f4f5;
+  --color-surface: #ffffff;
+  --color-surface-raised: #f4f4f5;
+  --color-border: #e4e4e7;
+  --color-border-strong: #d4d4d8;
+  --color-text-primary: #18181b;
+  --color-text-secondary: #3f3f46;
+  --color-text-muted: #52525b;
+  --color-accent: #4f46e5;
+  --color-accent-foreground: #ffffff;
+  --color-accent-hover: #4338ca;
+  --color-danger: #b91c1c;
+  --color-destructive-foreground: #ffffff;
+  --color-success: #166534;
+  --color-warning: #92400e;
+}
+
+/* Adapter for server-rendered markup. Values come only from canonical tokens. */
+:root {
+  --bg: var(--color-background); --panel: var(--color-surface);
+  --surface: var(--color-surface-raised); --surface-hover: var(--color-surface-raised); --surface-active: var(--color-surface-raised);
+  --text: var(--color-text-primary); --text-secondary: var(--color-text-secondary); --text-muted: var(--color-text-muted); --text-dim: var(--color-text-muted);
+  --accent: var(--color-accent); --accent-hover: var(--color-accent-hover); --accent-readable: var(--color-accent);
+  --accent-foreground: var(--color-accent-foreground); --accent-hover-foreground: var(--color-accent-foreground);
+  --accent-soft: color-mix(in srgb, var(--color-accent) 15%, transparent);
+  --border: var(--color-border); --border-strong: var(--color-border-strong);
+  --green: var(--color-success); --red: var(--color-danger); --orange: var(--color-warning); --yellow: var(--color-warning); --blue: var(--color-accent);
+  --green-soft: color-mix(in srgb, var(--color-success) 12%, transparent); --red-soft: color-mix(in srgb, var(--color-danger) 12%, transparent);
+  --orange-soft: color-mix(in srgb, var(--color-warning) 12%, transparent); --yellow-soft: var(--orange-soft);
+  --sidebar-width: var(--shell-sidebar-expanded); --header-height: var(--shell-header-height);
+}
+.base-ssr-shell { font-size: var(--base-font-body); letter-spacing: 0; }
+.base-form-field { display: grid; gap: 8px; min-width: 0; }
+.base-form-field label { font-weight: 500; }
+.base-form-field p { margin: 0; color: var(--color-text-muted); font-size: var(--base-font-label); }
+.base-form-field [role='alert'] { color: var(--color-danger); }
+.base-form-field > .base-control { width: 100%; min-width: 0; padding: 8px 12px; border: 1px solid var(--color-border); border-radius: var(--base-radius); background: var(--color-surface); color: var(--color-text-primary); font: inherit; }
+.base-form-field > [aria-invalid='true'] { border-color: var(--color-danger); }
+.base-ssr-shell .base-control:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
+.base-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 8px 12px; border: 1px solid var(--color-border); border-radius: var(--base-radius); cursor: pointer; font: inherit; text-decoration: none; }
+.base-button-secondary { background: var(--color-surface); color: var(--color-text-primary); }
+.base-button-primary { background: var(--color-accent); color: var(--color-accent-foreground); border-color: var(--color-accent); }
+.base-button-danger { background: var(--color-danger); color: var(--color-destructive-foreground); border-color: var(--color-danger); }
+.base-button:disabled { opacity: .5; cursor: not-allowed; }
+.base-resource-state { padding: 20px 0; }
+.base-ssr-shell .main { min-width: 0; min-height: 100dvh; width: calc(100% - var(--sidebar-width)); margin-left: var(--sidebar-width); }
+.base-ssr-header { position: sticky; top: 0; z-index: 30; display: flex; height: var(--shell-header-height); align-items: center; justify-content: space-between; gap: 8px; padding: 0 var(--shell-page-gutter); border-bottom: 1px solid var(--color-border); background: var(--color-surface); }
+.base-ssr-shell .sidebar-header { height: var(--shell-header-height); flex: 0 0 auto; display: flex; align-items: center; padding: 0 20px; border-bottom: 1px solid var(--color-border); }
+.base-ssr-shell .sidebar-nav { flex: 1; min-height: 0; overflow-y: auto; padding: 12px; }
+.base-ssr-shell .sidebar-link { display: flex; min-height: var(--shell-control-min); align-items: center; gap: 12px; padding: 8px 12px; border-radius: var(--base-radius); color: var(--color-text-secondary); text-decoration: none; }
+.base-ssr-shell .sidebar-link:hover, .base-ssr-shell .sidebar-link.active { background: var(--color-surface-raised); color: var(--color-text-primary); }
+.base-ssr-shell .sidebar-link:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
+.base-ssr-shell .base-shell-drawer .sidebar-label { position: static; width: auto; height: auto; margin: 0; clip: auto; white-space: normal; overflow: visible; }
+.base-ssr-shell .base-shell-drawer .sidebar-section { display: block; }
+.base-drawer-close { position: absolute; right: 8px; top: 8px; background: transparent; color: inherit; border: 0; cursor: pointer; font-size: 24px; }
+.base-ssr-account { position: relative; }
+.base-ssr-account summary { display: flex; min-width: var(--shell-control-min); align-items: center; justify-content: center; cursor: pointer; list-style: none; }
+.base-ssr-account summary::-webkit-details-marker { display: none; }
+.base-ssr-account-menu { position: absolute; right: 0; top: calc(100% + 8px); min-width: 160px; padding: 8px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--base-radius); }
+.base-ssr-account-menu a { display: flex; align-items: center; min-height: var(--shell-control-min); padding: 8px; }
+.base-ssr-shell .base-shell-drawer .sidebar-nav { padding: 0; }
+.base-ssr-shell :where(button,select,textarea,input:not([type='checkbox']):not([type='radio']),.btn,summary,.namespace-icon-action,.brand-link,.sidebar-service-link) { min-height: var(--shell-control-min); }
+.base-ssr-shell :where(button,.namespace-icon-action) { min-width: var(--shell-control-min); }
+.base-ssr-shell label:has(input[type='checkbox']), .base-ssr-shell label:has(input[type='radio']) { min-height: var(--shell-control-min); display: flex; align-items: center; }
+.base-ssr-shell .btn-danger { background: var(--color-danger); color: var(--color-destructive-foreground); border-color: var(--color-danger); }
+@media (min-width: 768px) and (max-width: 1279px) {
+  .base-ssr-shell { --sidebar-width: var(--shell-sidebar-compact); }
+  .base-ssr-shell .sidebar-header { justify-content: center; padding: 0 8px; }
+  .base-ssr-shell .sidebar-nav { padding: 12px 8px; }
+  .base-ssr-shell .sidebar-link { justify-content: center; padding: 8px; }
+}
+@media (max-width: 767px) {
+  .base-ssr-shell { --shell-control-min: var(--shell-control-mobile-min); }
+  .base-ssr-account summary { min-width: var(--shell-control-mobile-min); }
+  .base-ssr-shell .main { width: 100%; margin-left: 0; }
+  .base-ssr-shell :where(button,select,textarea,input:not([type='checkbox']):not([type='radio']),.btn,summary,.namespace-icon-action,.brand-link,.sidebar-service-link,.sidebar-link) { min-height: var(--shell-control-mobile-min); }
+  .base-ssr-shell :where(button,.namespace-icon-action) { min-width: var(--shell-control-mobile-min); }
+  .base-ssr-shell label:has(input[type='checkbox']), .base-ssr-shell label:has(input[type='radio']) { min-height: var(--shell-control-mobile-min); }
+}
diff --git a/project_workflow/interfaces/ui/templates/base-assets/base-ui.js b/project_workflow/interfaces/ui/templates/base-assets/base-ui.js
new file mode 100644
index 0000000..e0d0b10
--- /dev/null
+++ b/project_workflow/interfaces/ui/templates/base-assets/base-ui.js
@@ -0,0 +1,25 @@
+(() => {
+  for (const account of document.querySelectorAll('.base-ssr-account')) {
+    const toggle = account.querySelector('summary');
+    function closeAccount(restoreFocus) { account.open = false; if (restoreFocus) toggle?.focus(); }
+    account.addEventListener('keydown', (event) => { if (event.key === 'Escape' && account.open) { event.preventDefault(); closeAccount(true); } });
+    document.addEventListener('click', (event) => { if (event.target instanceof Node && !account.contains(event.target)) closeAccount(false); });
+    account.addEventListener('focusout', (event) => { if (event.relatedTarget instanceof Node && !account.contains(event.relatedTarget)) closeAccount(false); });
+  }
+  const trigger = document.querySelector('[data-base-drawer-trigger]');
+  const drawer = document.querySelector('[data-base-drawer]');
+  if (!trigger || !drawer) return;
+  const focusable = () => [...drawer.querySelectorAll('a[href],button,input,select,textarea,[tabindex="0"]')].filter((item) => !item.disabled && item.getClientRects().length);
+  function close() { drawer.close(); trigger.setAttribute('aria-expanded', 'false'); const target = trigger.getClientRects().length ? trigger : document.querySelector('main[tabindex="-1"]'); target?.focus(); }
+  trigger.addEventListener('click', () => { drawer.showModal(); trigger.setAttribute('aria-expanded', 'true'); focusable()[0]?.focus(); });
+  drawer.addEventListener('cancel', (event) => { event.preventDefault(); close(); });
+  drawer.addEventListener('click', (event) => { if (event.target instanceof Element && event.target.closest('[data-base-drawer-close],a[href]')) close(); });
+  drawer.addEventListener('keydown', (event) => {
+    if (event.key !== 'Tab') return;
+    const items = focusable();
+    if (!items.length) { event.preventDefault(); return; }
+    if (event.shiftKey && document.activeElement === items[0]) { event.preventDefault(); items.at(-1).focus(); }
+    else if (!event.shiftKey && document.activeElement === items.at(-1)) { event.preventDefault(); items[0].focus(); }
+  });
+  window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => { if (event.matches && drawer.open) close(); });
+})();
diff --git a/project_workflow/interfaces/ui/templates/base-assets/fingerprint.json b/project_workflow/interfaces/ui/templates/base-assets/fingerprint.json
