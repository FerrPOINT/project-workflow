diff --git a/project_workflow/interfaces/ui/AGENTS.md b/project_workflow/interfaces/ui/AGENTS.md
new file mode 100644
index 0000000..0adfc50
--- /dev/null
+++ b/project_workflow/interfaces/ui/AGENTS.md
@@ -0,0 +1,19 @@
+<!-- BEGIN BASE FRONTEND RULES -->
+## Общий UI-контракт Base
+
+- Использовать общий shell, branding и tokens Base. Контент и доменные решения
+  принадлежат продукту; страницы входа Auth не требуют доступности Admin.
+- Описать маршруты, роли, состояния и layout modes в route contract. Приватный
+  operational route сохраняет SSO; fixtures используют synthetic данные.
+- Перед коммитом выполнить route/acceptance gates и матрицу viewport, тем,
+  direct/reload, keyboard/focus, geometry, console/network.
+- Browser evidence относится к committed source SHA и реальному candidate image.
+  После evidence допускаются документационные коммиты, если runtime fingerprints
+  не изменились. Secrets и реальные пользовательские данные исключить.
+- Изменение публичных контрактов сверять с backend/OpenAPI; SDK сохраняет HTTP
+  status, бизнес-код и correlation id, включая пустые error responses.
+- Compose-кандидаты работают только в собственном временном project; cleanup
+  выполняется при успехе, ошибке и отмене. Runtime workspace не пересоздавать.
+
+Этот блок обновляется `services-base/scripts/sync_frontend_agents.mjs`.
+<!-- END BASE FRONTEND RULES -->
diff --git a/project_workflow/interfaces/ui/app.py b/project_workflow/interfaces/ui/app.py
index 6cbb8c2..00fb538 100644
--- a/project_workflow/interfaces/ui/app.py
+++ b/project_workflow/interfaces/ui/app.py
@@ -2,14 +2,17 @@
 
 from __future__ import annotations
 
+import asyncio
 import logging
 import time
 from collections.abc import AsyncIterator
 from contextlib import asynccontextmanager
+from threading import BoundedSemaphore
+from uuid import UUID, uuid4
 
 from fastapi import FastAPI, Request
 from fastapi.exceptions import RequestValidationError
-from fastapi.responses import HTMLResponse, JSONResponse
+from fastapi.responses import HTMLResponse, JSONResponse, PlainTextResponse
 from pydantic import ValidationError
 from sqlalchemy import text
 from sqlalchemy.exc import SQLAlchemyError
@@ -24,6 +27,7 @@ from .routes import api, cli_api, pages, runtime_api
 from .sso import install_sso
 
 logger = logging.getLogger(__name__)
+_readiness_worker = BoundedSemaphore(1)
 
 _VALIDATION_MESSAGES = {
     "missing": "Обязательное поле не указано",
@@ -107,10 +111,29 @@ class _RequestLoggingMiddleware(BaseHTTPMiddleware):
 
     async def dispatch(self, request: Request, call_next):
         start = time.perf_counter()
-        response = await call_next(request)
+        supplied = request.headers.get("X-Request-Id", "")
+        try:
+            if len(supplied) != 36:
+                raise ValueError("Non-canonical UUID")
+            UUID(supplied)
+            request_id = supplied
+        except ValueError:
+            request_id = str(uuid4())
+        request.state.request_id = request_id
+        try:
+            response = await call_next(request)
+        except Exception as error:
+            logger.error("request_id=%s unhandled_error=%s", request_id, type(error).__name__)
+            response = PlainTextResponse("Internal Server Error", status_code=500)
+        response.headers["X-Request-Id"] = request_id
+        exposed = response.headers.get("Access-Control-Expose-Headers", "")
+        response.headers["Access-Control-Expose-Headers"] = ", ".join(
+            value for value in (exposed, "X-Request-Id") if value
+        )
