+@pytest.mark.parametrize(
+    ("source", "contains_internal_label"),
+    [
+        ('<label>Ключ запуска</label><script>const key = agent.hermes_profile;</script>', False),
+        ('{% block extra_script %}const key = agent.hermes_profile;{% endblock %}<label>Ключ запуска</label>', False),
+        ("{{ base.button('Профиль Hermes') }}<label>Ключ запуска</label>", True),
+    ],
+)
+def test_localization_gate_separates_labels_from_script_identifiers(source: str, contains_internal_label: bool) -> None:
+    markup = markup_source(source)
+
+    assert "Ключ запуска" in markup
+    assert ("hermes" in markup.lower()) is contains_internal_label
+
+
