+
+for (const status of [401, 403, 404, 409, 422]) {
+  test(`agent create distinguishes confirmed HTTP ${status} from unknown outcome`, async ({ page }) => {
+    let writes = 0
+    await page.route('**/api/agents', async route => {
+      expect(route.request().method()).toBe('POST')
+      writes++
+      await route.fulfill({ status, json: { ok: false, error: `Confirmed rejection ${status}` } })
+    })
+    await openCreate(page)
+    const form = page.locator('#agentCreatePanel form')
+    await form.locator('[type="submit"]').click()
+    const state = form.locator('[data-page-state]')
+    await expect(state).toHaveText(`Confirmed rejection ${status}`)
+    await expect(form).toHaveAttribute('aria-busy', 'false')
+    await expect(form.locator('[data-agent-reconcile]')).not.toBeVisible()
+    await expect(page.locator('#newName')).toHaveValue('Unsaved agent draft')
+    if (status === 401 || status === 403 || status === 404) {
+      await expect(state).toHaveAttribute('data-page-state', status === 404 ? 'not-found' : 'permission-denied')
+      await expect(state).toBeFocused()
+      await expect(page.locator('#newName')).toBeDisabled()
+      await expect(form.locator('[type="submit"]')).toBeDisabled()
+      await page.evaluate(() => {
+        const ui = window as unknown as { addAgent: (event: { preventDefault: () => void; target: HTMLFormElement }) => Promise<void> }
+        void ui.addAgent({ target: document.querySelector<HTMLFormElement>('#agentCreatePanel form')!, preventDefault() {} })
+      })
+      expect(writes).toBe(1)
+    } else {
+      await expect(page.locator('#newName')).toBeEnabled()
+      await expect(form.locator('[type="submit"]')).toBeEnabled()
+    }
+  })
+}
+
+for (const failure of ['lost-response', 'malformed-ack', 'wrong-id-ack']) {
+  test(`created agent with ${failure} is reconciled by GET, never replayed`, async ({ page, request }) => {
+    let writes = 0
+    let id: number | undefined
+    const name = `agent-reconcile-${crypto.randomUUID()}`
+    try {
+      await page.route('**/api/agents', async route => {
+        if (route.request().method() === 'GET') { await route.continue(); return }
+        expect(route.request().method()).toBe('POST')
+        writes++
+        const result = await route.fetch()
+        expect(result.ok()).toBeTruthy()
+        const data = await result.json()
+        id = data.agent_id as number
+        if (failure === 'lost-response') await route.abort('failed')
+        else if (failure === 'malformed-ack') await route.fulfill({ status: 200, body: '{invalid', contentType: 'application/json' })
+        else await route.fulfill({ status: 200, json: { ...data, agent_id: id + 1 } })
+      })
+      await openCreate(page)
+      await page.locator('#newName').fill(name)
+      const form = page.locator('#agentCreatePanel form')
+      await form.locator('[type="submit"]').click()
+      await expect(form.locator('[data-page-state]')).toHaveText(/Результат записи неизвестен/)
+      await expect(page.locator('#newName')).toBeDisabled()
+      await expect(form.locator('[data-agent-reconcile]')).toBeFocused()
+      await page.locator('#agentCreatePanel > summary').click()
+      await expect(page.locator('#agentCreatePanel')).toHaveAttribute('open', '')
+      await page.evaluate(() => {
+        const ui = window as unknown as { addAgent: (event: { preventDefault: () => void; target: HTMLFormElement }) => Promise<void> }
+        void ui.addAgent({ target: document.querySelector<HTMLFormElement>('#agentCreatePanel form')!, preventDefault() {} })
+      })
+      expect(writes).toBe(1)
+      await page.screenshot({ path: test.info().outputPath(`agent-unknown-${failure}-${page.viewportSize()!.width}.png`), fullPage: true })
+      await form.locator('[data-agent-reconcile]').click()
+      await expect(page.locator(`.agent-entry[data-id="${id}"] .agent-name`)).toHaveText(name)
+      expect(writes).toBe(1)
+    } finally {
+      if (id !== undefined) expect((await request.delete(`/api/agents/${id}`)).ok()).toBeTruthy()
+    }
+  })
+}
+
+for (const status of [403, 404]) {
+  test(`agent readback HTTP ${status} stops reconciliation without unlocking CRUD`, async ({ page }) => {
+    let writes = 0
+    let reads = 0
+    await page.route('**/api/agents', async route => {
+      if (route.request().method() === 'POST') {
+        writes++
+        await route.fulfill({ status: 503, json: { ok: false } })
+      } else {
+        expect(route.request().method()).toBe('GET')
+        reads++
+        await route.fulfill({ status, json: { ok: false, error: `Readback rejection ${status}` } })
+      }
+    })
+    await openCreate(page)
+    const form = page.locator('#agentCreatePanel form')
+    await form.locator('[type="submit"]').click()
+    await expect(form.locator('[data-page-state]')).toHaveText(/Результат записи неизвестен/)
+    await form.locator('[data-agent-reconcile]').click()
+    await expect(form.locator('[data-page-state]')).toHaveText(`Readback rejection ${status}`)
+    await expect(form.locator('[data-page-state]')).toHaveAttribute('data-page-state', status === 404 ? 'not-found' : 'permission-denied')
+    await expect(form.locator('[data-page-state]')).toBeFocused()
+    await expect(form.locator('[data-agent-reconcile]')).not.toBeVisible()
+    await expect(page.locator('#newName')).toBeDisabled()
+    await expect(page.locator('#newName')).toHaveValue('Unsaved agent draft')
+    await page.evaluate(async () => {
+      const ui = window as unknown as { reconcileAgent: (form: HTMLFormElement) => Promise<void>; addAgent: (event: { preventDefault: () => void; target: HTMLFormElement }) => Promise<void> }
+      const form = document.querySelector<HTMLFormElement>('#agentCreatePanel form')!
+      await ui.reconcileAgent(form)
+      await ui.addAgent({ target: form, preventDefault() {} })
+    })
+    expect(writes).toBe(1)
+    expect(reads).toBe(1)
+  })
+}
