diff --git a/tests/ui_markup.py b/tests/ui_markup.py
new file mode 100644
index 0000000..adeabe6
--- /dev/null
+++ b/tests/ui_markup.py
@@ -0,0 +1,53 @@
+"""Extract UI markup, including Jinja macro labels, without JS/CSS identifiers."""
+
+from html.parser import HTMLParser
+
+from jinja2 import Environment, nodes
+
+
+def markup_html(source: str) -> str:
+    class MarkupParser(HTMLParser):
+        def __init__(self) -> None:
+            super().__init__(convert_charrefs=False)
+            self.in_script = False
+            self.parts: list[str] = []
+
+        def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+            if tag in {"script", "style"}:
+                self.in_script = True
+            elif not self.in_script:
+                self.parts.append(self.get_starttag_text() or "")
+
+        def handle_endtag(self, tag: str) -> None:
+            if tag in {"script", "style"}:
+                self.in_script = False
+            elif not self.in_script:
+                self.parts.append(f"</{tag}>")
+
+        def handle_data(self, data: str) -> None:
+            if not self.in_script:
+                self.parts.append(data)
+
+        def handle_entityref(self, name: str) -> None:
+            self.handle_data(f"&{name};")
+
+        def handle_charref(self, name: str) -> None:
+            self.handle_data(f"&#{name};")
+
+    parser = MarkupParser()
+    parser.feed(source)
+    parser.close()
+    return "".join(parser.parts)
+
+
+def markup_source(source: str) -> str:
+    def fragments(node: nodes.Node) -> list[str]:
+        if isinstance(node, nodes.Block) and node.name in {"extra_script", "extra_style"}:
+            return []
+        if isinstance(node, nodes.TemplateData):
+            return [node.data]
+        if isinstance(node, nodes.Const) and isinstance(node.value, str):
+            return [node.value]
+        return [text for child in node.iter_child_nodes() for text in fragments(child)]
+
+    return markup_html("".join(fragments(Environment().parse(source))))
