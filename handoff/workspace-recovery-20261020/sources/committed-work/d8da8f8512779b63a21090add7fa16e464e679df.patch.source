+async function writeAgent(form,id){
+  if(agentPendingForms.has(form)||agentUnknownWrites.has(form)||agentTerminalStates.has(form))return;
+  var payload={name:form.elements.namedItem('name').value.trim(),description:form.elements.namedItem('description').value.trim(),launch_profile:form.elements.namedItem('launch_profile').value.trim()||null};
+  if(!payload.name){
