@@ -8,6 +8,11 @@
 
 ### Changed
 
+- Create/edit поля агентов используют общий Base SSR field macro: canonical
+  labels и явные связи label/control вместо локального 11px uppercase CSS.
+  Required/pattern/maxlength и значения сохранены; lifecycle записи, drafts,
+  pending/unknown guards и focus не изменяются.
+
 - Base snapshot обновлён до a434ee2; SSR assets экспортированы штатным
   sync с fingerprint. Длинные непрерывные ошибки не растягивают страницу;
   значения формы и защита повторной отправки сохранены. API и runtime прежние.
diff --git a/frontend/e2e/base-agent-fields.spec.ts b/frontend/e2e/base-agent-fields.spec.ts
new file mode 100644
index 0000000..73706b1
--- /dev/null
+++ b/frontend/e2e/base-agent-fields.spec.ts
@@ -0,0 +1,71 @@
+import { expect, test } from '@playwright/test'
+
+if (process.env.WORKFLOW_UI_QA_MUTATIONS !== 'isolated-fixture') throw new Error('UI QA requires an isolated fixture')
+
+for (const theme of ['dark', 'gray', 'light']) {
+  test(`Base agent fields use shared labels and native constraints (${theme})`, async ({ page }, testInfo) => {
+    await page.addInitScript(value => localStorage.setItem('workflow-theme', value), theme)
+    const errors: string[] = []
+    page.on('pageerror', error => errors.push(error.message))
+    page.on('console', message => { if (message.type() === 'error') errors.push(message.text()) })
+    page.on('request', request => {
+      if (!['GET', 'HEAD'].includes(request.method())) errors.push(`Unexpected write: ${request.method()}`)
+    })
+    page.on('response', response => { if (response.status() >= 400) errors.push(`${response.status()} ${response.url()}`) })
+    await page.goto('/agents?namespace_id=1')
+    await page.reload()
+    await page.locator('.agent-entry').first().locator('summary').click()
+    await page.locator('#agentCreatePanel > summary').click()
+    const forms = page.locator('.agent-editor:visible')
+    await expect(forms).toHaveCount(2)
+    const widths = testInfo.project.name === 'desktop' ? [1023, 1024, 1279, 1280, 1440, 1920, 2560] : [375, 767, 768]
+    for (const width of widths) {
+      await page.setViewportSize({ width, height: 1080 })
+      await expect(forms.locator('.base-form-field > label:visible')).toHaveCount(6)
+      await expect(page.locator('.agent-field-label')).toHaveCount(0)
+      for (const form of await forms.all()) {
+        const name = form.getByRole('textbox', { name: 'Имя', exact: true })
+        const profile = form.getByRole('textbox', { name: 'Ключ запуска', exact: true })
+        const description = form.getByRole('textbox', { name: 'Описание', exact: true })
+        await expect(name).toHaveAttribute('required', '')
+        await expect(profile).toHaveAttribute('maxlength', '251')
+        await expect(profile).toHaveAttribute('pattern', '[a-z0-9][a-z0-9_\\-]*')
+        await expect(profile).toHaveAttribute('title', /251/)
+        for (const control of [name, profile, description]) {
+          const id = await control.getAttribute('id')
+          expect(id).toBeTruthy()
+          const label = form.locator(`.base-form-field > label[for="${id}"]`)
+          const metrics = await label.evaluate(element => {
+            const control = (element as HTMLLabelElement).control!
+            const labelBox = element.getBoundingClientRect()
+            const controlBox = control.getBoundingClientRect()
+            const style = getComputedStyle(element)
+            return { fontSize: style.fontSize, textTransform: style.textTransform, associated: control.id === element.getAttribute('for'),
+              labelBottom: labelBox.bottom, controlTop: controlBox.top, controlHeight: controlBox.height }
+          })
+          expect(metrics.fontSize).toBe('12px')
+          expect(metrics.textTransform).toBe('none')
+          expect(metrics.associated).toBe(true)
+          expect(metrics.labelBottom).toBeLessThanOrEqual(metrics.controlTop)
+          expect(metrics.controlHeight).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
+          await label.click()
+          await expect(control).toBeFocused()
+        }
+        await profile.fill('Invalid Profile')
+        expect(await profile.evaluate(element => (element as HTMLInputElement).checkValidity())).toBe(false)
+        await profile.fill('valid-profile_1')
+        expect(await profile.evaluate(element => (element as HTMLInputElement).checkValidity())).toBe(true)
+      }
+      expect(await forms.locator('input, textarea').evaluateAll(elements => {
+        const ids = elements.map(element => element.id)
+        return ids.every(Boolean) && new Set(ids).size === ids.length
+      })).toBe(true)
+      expect(await page.evaluate(() => document.documentElement.scrollWidth - innerWidth)).toBeLessThanOrEqual(1)
+      if ([375, 1920].includes(width)) {
+        await page.evaluate(() => window.scrollTo(0, 0))
+        await page.screenshot({ path: testInfo.outputPath(`base-agent-fields-${theme}-${width}.png`), fullPage: true })
+      }
+    }
+    expect(errors).toEqual([])
+  })
+}
