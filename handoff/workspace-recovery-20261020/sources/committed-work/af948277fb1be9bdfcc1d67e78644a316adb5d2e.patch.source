 +def test_base_ui_archive_has_deterministic_metadata(git_base: Path):
 +    snapshot = _builder_module().immutable_base_ui_snapshot(git_base, "HEAD")
 +    committed_at = int(_run_git(git_base, "show", "--no-patch", "--format=%ct", snapshot.revision).stdout)
 +    with tarfile.open(fileobj=io.BytesIO(snapshot.archive)) as archive:
 +        members = archive.getmembers()
 +        assert members
 +        assert {member.mtime for member in members} == {committed_at}
