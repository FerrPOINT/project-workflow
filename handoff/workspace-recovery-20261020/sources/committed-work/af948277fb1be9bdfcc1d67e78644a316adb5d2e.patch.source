 +        (git_base / "frontend/src/ui/tokens.css").write_text("mutated while building", encoding="utf-8")
 +        assert (context / "src/ui/tokens.css").read_bytes() != b"mutated while building"
 +        raise subprocess.CalledProcessError(1, command)
 +
 +    snapshot = builder.immutable_git_snapshot(git_source, "HEAD")
 +    with (
 +        patch.object(builder, "immutable_git_snapshot", return_value=snapshot),
 +        patch.object(builder, "immutable_base_ui_snapshot", return_value=ui),
 +        patch.object(builder.subprocess, "run", side_effect=docker_run),
++        patch.object(builder, "compatible_build_context",
