 +@pytest.mark.parametrize("kind", [tarfile.SYMTYPE, tarfile.LNKTYPE, tarfile.FIFOTYPE])
 +def test_base_ui_archive_rejects_nonregular_entries(kind: bytes, tmp_path: Path):
 +    builder = _builder_module()
 +    output = io.BytesIO()
 +    with tarfile.open(fileobj=output, mode="w") as archive:
 +        entry = tarfile.TarInfo("frontend/src/injected")
 +        entry.type = kind
 +        entry.linkname = "outside"
 +        archive.addfile(entry)
 +    with pytest.raises(BuildProvenanceError, match="недопустимый тип"):
 +        builder.extract_base_ui(builder.BaseUiSnapshot("a" * 40, output.getvalue()), tmp_path / "context")
