diff --git a/tests/test_local_fonts.py b/tests/test_local_fonts.py
new file mode 100644
index 0000000..d021150
--- /dev/null
+++ b/tests/test_local_fonts.py
@@ -0,0 +1,17 @@
+"""The server-rendered UI works without third-party font requests."""
+
+import pytest
+from fastapi.testclient import TestClient
+
+from project_workflow.interfaces.ui import app
+
+pytestmark = [pytest.mark.ui]
+
+
+@pytest.mark.parametrize("route", ["/", "/phases"])
+def test_rendered_ui_does_not_load_third_party_fonts(route):
+    response = TestClient(app).get(route)
+    assert response.status_code == 200
+    assert "fonts.googleapis.com" not in response.text
+    assert "fonts.gstatic.com" not in response.text
+    assert "system-ui" in response.text
