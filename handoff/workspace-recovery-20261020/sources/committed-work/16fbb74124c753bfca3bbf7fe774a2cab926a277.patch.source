index 0e23875..c8b0dc4 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,4 +1,27 @@
 # syntax=docker/dockerfile:1
+FROM node:22.20.0-bookworm-slim@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e AS frontend
+
+RUN npm install --global pnpm@10.28.1
+WORKDIR /workspace/services-base/frontend
+COPY --from=sdlc_ui /package.json /pnpm-lock.yaml ./
+COPY --from=sdlc_ui /src ./src
+COPY --from=sdlc_ui /ssr ./ssr
+COPY --from=sdlc_ui /scripts ./scripts
+RUN pnpm install --frozen-lockfile
+
+WORKDIR /workspace/project-workflow
+COPY frontend/ ./frontend/
+COPY project_workflow/ ./project_workflow/
+COPY docs/ui-routes.json ./docs/ui-routes.json
+COPY Dockerfile pyproject.toml constraints.txt ./
+WORKDIR /workspace/project-workflow/frontend
+RUN pnpm install --frozen-lockfile && pnpm ssr:check && pnpm build
+
+ARG VCS_REF=unknown
+ARG BASE_VCS_REF=unknown
+RUN node ../../services-base/frontend/scripts/write-ui-build.mjs --repo .. \
+    --out /workspace/ui-build.json --product-sha "$VCS_REF" --base-sha "$BASE_VCS_REF"
+
 FROM python:3.11-slim-bookworm@sha256:0bee7276f83efd4a1ee05bbbf4281d95ed28e079220a9457f25a93e3f1e3c31b AS builder
 
 WORKDIR /app
