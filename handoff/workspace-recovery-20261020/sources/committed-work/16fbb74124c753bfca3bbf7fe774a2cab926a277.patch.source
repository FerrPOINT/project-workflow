diff --git a/scripts/verify_ui_image.py b/scripts/verify_ui_image.py
new file mode 100644
index 0000000..42ed7a2
--- /dev/null
+++ b/scripts/verify_ui_image.py
@@ -0,0 +1,66 @@
+"""Verify packaged UI bytes against immutable build provenance without network calls."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import re
+from pathlib import Path
+
+
+def verify_ui_assets(record_path: Path, static_path: Path, require_revisions: bool = False) -> dict:
+    record = json.loads(record_path.read_text(encoding="utf-8"))
+    if record.get("schemaVersion") != 1 or record.get("product") != "project-workflow":
+        raise ValueError("Invalid Workflow UI build record")
+    for name in ("baseFingerprint", "productFingerprint"):
+        if not re.fullmatch(r"[a-f0-9]{64}", str(record.get(name, ""))):
+            raise ValueError(f"Missing {name}")
+    if require_revisions:
+        for name in ("productSha", "baseSha"):
+            if not re.fullmatch(r"[a-f0-9]{40}", str(record.get(name, ""))):
+                raise ValueError(f"Missing attested {name}")
+
+    def verify(directory: Path, expected: dict) -> None:
+        actual = {file.relative_to(directory).as_posix() for file in directory.rglob("*") if file.is_file()}
+        if actual != set(expected):
+            raise ValueError(f"Unexpected or missing UI assets: {directory}")
+        for relative, digest in expected.items():
+            file = (directory / relative).resolve()
+            if not file.is_relative_to(directory.resolve()):
+                raise ValueError(f"Asset escapes static directory: {relative}")
+            if hashlib.sha256(file.read_bytes()).hexdigest() != digest:
+                raise ValueError(f"UI asset digest mismatch: {relative}")
+
+    assets = record.get("assets")
+    if (
+        not isinstance(assets, dict) or "index.html" not in assets
+        or not any(name.startswith("assets/") for name in assets)
+    ):
+        raise ValueError("Missing built React assets")
+    verify(static_path / "react", assets)
+    html = (static_path / "react" / "index.html").read_text(encoding="utf-8")
+    if html.count("<!--workflow-bootstrap-->") != 1:
+        raise ValueError("Missing safe bootstrap marker")
+    ssr = json.loads((static_path / "base-ui" / "fingerprint.json").read_text(encoding="utf-8"))
+    if ssr.get("package") != "@sdlc/ui" or set(ssr.get("files", {})) != {"base-ui.css", "base-ui.js", "macros.html"}:
+        raise ValueError("Invalid Base SSR asset fingerprint")
+    verify(static_path / "base-ui", {**ssr["files"], "fingerprint.json": hashlib.sha256(
+        (static_path / "base-ui" / "fingerprint.json").read_bytes(),
+    ).hexdigest()})
+    return {"productSha": record.get("productSha"), "baseSha": record.get("baseSha"),
+            "reactAssets": len(assets), "ssrAssets": len(ssr["files"])}
+
+
+def main() -> None:
+    from project_workflow.interfaces.ui.react_ui import FRONTEND_DIST
+
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--record", type=Path, default=Path("/app/ui-build.json"))
+    parser.add_argument("--require-revisions", action="store_true")
+    args = parser.parse_args()
+    print(json.dumps(verify_ui_assets(args.record, FRONTEND_DIST.parent, args.require_revisions)))
+
+
+if __name__ == "__main__":
+    main()
