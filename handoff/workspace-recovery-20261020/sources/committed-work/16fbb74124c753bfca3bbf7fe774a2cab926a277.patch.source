+def test_image_builds_read_only_pilot_from_frozen_sources_instead_of_local_dist():
+    dockerfile = DOCKERFILE_PATH.read_text(encoding="utf-8")
+    dockerignore = (REPO_ROOT / ".dockerignore").read_text(encoding="utf-8")
+    compose = COMPOSE_PATH.read_text(encoding="utf-8")
+    assert "FROM node:22.20.0-bookworm-slim@sha256:" in dockerfile
+    assert "pnpm@10.28.1" in dockerfile
+    assert "pnpm install --frozen-lockfile && pnpm ssr:check && pnpm build" in dockerfile
+    assert "COPY --from=sdlc_ui /src ./src" in dockerfile
+    assert "COPY --from=frontend /workspace/project-workflow/project_workflow/interfaces/ui/static/react" in dockerfile
+    assert "COPY --from=frontend /workspace/ui-build.json /app/ui-build.json" in dockerfile
+    assert "org.sdlc.ui.base.revision=$BASE_VCS_REF" in dockerfile
+    assert "project_workflow/interfaces/ui/static/react" in dockerignore.splitlines()
+    assert "!docs/ui-routes.json" in dockerignore.splitlines()
+    assert compose.count("sdlc_ui: ../services-base/frontend") == 2
+    assert "WORKFLOW_REACT_UI_ENABLED: ${WORKFLOW_REACT_UI_ENABLED:-false}" in compose
+    pyproject = (REPO_ROOT / "pyproject.toml").read_text(encoding="utf-8")
+    assert 'exclude = ["project_workflow/interfaces/ui/static/**"]' in pyproject
+
+
 @pytest.mark.parametrize("raises", [False, True])
 def test_uow_context_always_closes_session(tmp_path, monkeypatch, raises):
     uow = SAUnitOfWork(f"sqlite:///{tmp_path / f'uow-{raises}.db'}")
diff --git a/tests/test_ui_image.py b/tests/test_ui_image.py
new file mode 100644
index 0000000..06b27b8
--- /dev/null
+++ b/tests/test_ui_image.py
@@ -0,0 +1,69 @@
+"""Image verification rejects stale, incomplete or unattested packaged frontend assets."""
+
+import hashlib
+import json
+
+import pytest
+
+from scripts.verify_ui_image import verify_ui_assets
+
+
+def fixture(tmp_path):
+    static = tmp_path / "static"
+    contents = {
+        "react/index.html": "<html><!--workflow-bootstrap--></html>",
+        "react/assets/app.js": "export const fixture=true;",
+        "base-ui/base-ui.css": ":root {--shell-header-height:60px;}",
+        "base-ui/base-ui.js": "export const fixture=true;",
+        "base-ui/macros.html": "{% macro header() %}<header></header>{% endmacro %}",
+    }
+    for file, text in contents.items():
+        target = static / file
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_text(text, encoding="utf-8")
+    def digest(name):
+        return hashlib.sha256((static / name).read_bytes()).hexdigest()
+    ssr = {"schemaVersion": 1, "package": "@sdlc/ui", "files": {
+        name: digest(f"base-ui/{name}") for name in ("base-ui.css", "base-ui.js", "macros.html")}}
+    (static / "base-ui/fingerprint.json").write_text(json.dumps(ssr), encoding="utf-8")
+    record = tmp_path / "ui-build.json"
+    record.write_text(json.dumps({"schemaVersion": 1, "product": "project-workflow",
+        "productSha": "a" * 40, "baseSha": "b" * 40, "baseFingerprint": "c" * 64, "productFingerprint": "d" * 64,
+        "assets": {name.removeprefix("react/"): digest(name) for name in contents if name.startswith("react/")}}),
+        encoding="utf-8")
+    return static, record
+
+
+def test_image_assets_and_revisions_are_verified(tmp_path):
+    static, record = fixture(tmp_path)
+    assert verify_ui_assets(record, static, True) == {
+        "productSha": "a" * 40, "baseSha": "b" * 40, "reactAssets": 2, "ssrAssets": 3}
+
+
+@pytest.mark.parametrize("file", ["react/assets/app.js", "base-ui/base-ui.css"])
+def test_modified_image_asset_is_rejected(tmp_path, file):
+    static, record = fixture(tmp_path)
+    (static / file).write_text("stale build", encoding="utf-8")
+    with pytest.raises(ValueError, match="digest mismatch"):
+        verify_ui_assets(record, static)
+
+
+@pytest.mark.parametrize("extra", [False, True])
+def test_missing_or_extra_image_asset_is_rejected(tmp_path, extra):
+    static, record = fixture(tmp_path)
+    if extra:
+        (static / "react/assets/stale.js").write_text("stale", encoding="utf-8")
+    else:
+        (static / "react/assets/app.js").unlink()
+    with pytest.raises(ValueError, match="Unexpected or missing UI assets"):
+        verify_ui_assets(record, static)
+
+
+def test_unknown_source_revision_cannot_pass_release_verification(tmp_path):
+    static, record = fixture(tmp_path)
+    value = json.loads(record.read_text(encoding="utf-8"))
+    value["baseSha"] = "unknown"
+    record.write_text(json.dumps(value), encoding="utf-8")
+    assert verify_ui_assets(record, static)["baseSha"] == "unknown"
+    with pytest.raises(ValueError, match="attested baseSha"):
+        verify_ui_assets(record, static, True)
