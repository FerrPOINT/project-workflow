@@ -260,6 +265,85 @@ def test_catalog_cache_is_scoped_to_url_and_respects_ttl(monkeypatch):
     assert len(calls) == 3
 
 
+@pytest.mark.parametrize("failure,expected_source", [
+    (None, "fallback-unreachable"),
+    ([], "fallback-empty"),
+    ([{"key": "bad"}], "fallback-invalid"),
+])
+def test_failure_cache_has_bounded_ttl_and_preserves_diagnostic_source(monkeypatch, failure, expected_source):
+    from project_workflow.interfaces.ui import platform_services as ps
+
+    calls = []
+    now = [100.0]
+    monkeypatch.setattr(ps.time, "monotonic", lambda: now[0])
+
+    def failed(url, **kwargs):
+        calls.append(url)
+        assert kwargs["timeout"] == 2.0
+        now[0] += 4.0
+        if failure is None:
+            raise OSError("catalog unavailable")
+        return _response(failure)
+
+    monkeypatch.setattr(ps, "urlopen", failed)
+    first = load_service_catalog("http://admin/api")
+    assert first.source == expected_source
+    assert not first.admin_console_connected
+    assert {service["health"] for service in first.services} == {"unknown"}
+    now[0] += ps._FAILURE_CACHE_TTL_SECONDS - 0.01
+    assert load_service_catalog("http://admin/api") == first
+    assert len(calls) == 1
+    now[0] += 0.01
+    assert load_service_catalog("http://admin/api") == first
+    assert len(calls) == 2
+
+
+def test_failure_cache_is_url_scoped_and_does_not_cache_request_host(monkeypatch):
+    from project_workflow.interfaces.ui import platform_services as ps
+
+    calls = []
+
+    def failed(url, **_kwargs):
+        calls.append(url)
+        raise OSError("catalog unavailable")
+
+    monkeypatch.setattr(ps, "urlopen", failed)
+    first = load_service_catalog("http://admin-a/api", request_url="http://192.168.1.10/tasks")
+    second = load_service_catalog("http://admin-a/api", request_url="http://192.168.1.11/tasks")
+    assert len(calls) == 1
+    assert all("192.168.1.10" in service["url"] for service in first.services)
+    assert all("192.168.1.11" in service["url"] for service in second.services)
+    canonical = load_service_catalog("http://admin-a/api")
+    assert all("localhost" in service["url"] for service in canonical.services)
+    load_service_catalog(None)
+    assert load_service_catalog("http://admin-a/api") == canonical
+    assert len(calls) == 1
+    load_service_catalog("http://admin-b/api")
+    assert calls == ["http://admin-a/api", "http://admin-b/api"]
+
+
+def test_success_cache_ttl_starts_after_fetch_completes(monkeypatch):
+    from project_workflow.interfaces.ui import platform_services as ps
+
+    calls = []
+    now = [100.0]
+    monkeypatch.setattr(ps.time, "monotonic", lambda: now[0])
+
+    def response(url, **_kwargs):
+        calls.append(url)
+        now[0] += 4.0
+        return _response(_runtime_services())
+
+    monkeypatch.setattr(ps, "urlopen", response)
+    first = load_service_catalog("http://admin/api")
+    now[0] += ps._CACHE_TTL_SECONDS - 0.01
+    assert load_service_catalog("http://admin/api") == first
+    assert len(calls) == 1
+    now[0] += 0.01
+    assert load_service_catalog("http://admin/api") == first
+    assert len(calls) == 2
+
+
 @pytest.mark.parametrize("invalid", [None, {"key": "wiki", "label": "Duplicate", "ui_url": "http://x"},
                                      {"key": "broken", "label": "Broken", "ui_url": "javascript:alert(1)"}])
 def test_mixed_invalid_catalog_does_not_silently_drop_bad_rows(monkeypatch, invalid):
