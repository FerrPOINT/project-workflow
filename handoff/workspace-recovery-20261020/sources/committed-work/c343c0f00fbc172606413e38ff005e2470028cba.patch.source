diff --git a/CHANGELOG.md b/CHANGELOG.md
index 61eed8e..2a3eb22 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -7,6 +7,15 @@
 ## [Unreleased]
 
 ### Changed
+- Каталог фаз использует Base SSR controls/states и общий navigation guard.
+  Создание, порядок, режим и удаление имеют единую блокировку записи. Создание,
+  порядок и режим подтверждаются scoped GET-каталогом; неизвестный результат не повторяется,
+  а создание без возвращённого ID не определяется по имени или новым строкам.
+  Ошибки 403/404 отключают CRUD, 409/422 сохраняют каталог; API и runtime pins
+  не меняются. Локальные повторяемые карточки и mobile targets приведены к Base.
+- Неудачные чтения каталога сервисов кешируются на 10 секунд с сохранением
+  причины fallback и неизвестного health. Недоступный Admin не добавляет
+  сетевой timeout к каждому переходу; успешный каталог сохраняет TTL 60 секунд.
 - Общий Base snapshot обновлён до 0ffb99e: verified profile/directory contracts
   и UI dependency graph без замены shell. SSR assets сохраняются byte-for-byte;
   active skills catalog и принятый runtime не переключаются.
diff --git a/frontend/e2e/phase-catalog.spec.ts b/frontend/e2e/phase-catalog.spec.ts
new file mode 100644
index 0000000..b27d26c
--- /dev/null
+++ b/frontend/e2e/phase-catalog.spec.ts
@@ -0,0 +1,321 @@
+import { expect, test, type Page, type APIRequestContext } from '@playwright/test'
+
+if (process.env.WORKFLOW_UI_QA_MUTATIONS !== 'isolated-fixture') throw new Error('Phase catalog QA requires an isolated fixture')
+
+interface Phase { id: number; workflow_id: number; mode_id: number; phase_order: number; execution_type: string }
+let workflowId: number
+let namespaceId: number
+let modeId: number
+let initial: Phase[]
+const state = (page: Page) => page.locator('#phaseWriteError [data-page-state]')
+const recovery = (page: Page) => page.locator('#phaseReconcileButton')
+const items = (page: Page) => page.locator('#phasesTimeline .timeline-item')
+const draftDialog = (page: Page) => page.locator('[data-base-draft-dialog]')
+const catalogue = () => `/api/phases?workflow_id=${workflowId}&mode_id=${modeId}&namespace_id=${namespaceId}`
+const pageUrl = () => `/phases?workflow_id=${workflowId}&mode_id=${modeId}&namespace_id=${namespaceId}&foreign=keep`
+async function rows(request: APIRequestContext) {
+  const response = await request.get(catalogue())
+  expect(response.ok()).toBeTruthy()
+  return (await response.json()).phases as Phase[]
+}
+async function action(page: Page, index: number, selector: string) {
+  const item = items(page).nth(index)
+  await item.locator('summary').click()
+  await item.locator(selector).click()
+}
+
+test.beforeEach(async ({ request }) => {
+  workflowId = 0
+  namespaceId = 0
+  const response = await request.post('/api/workflows', { data: { name: `Phase catalog ${crypto.randomUUID()}` } })
+  expect(response.ok()).toBeTruthy()
+  workflowId = (await response.json()).workflow_id as number
+  const data = await (await request.get(`/api/phases?workflow_id=${workflowId}`)).json()
+  modeId = data.mode.id as number
+  const namespace = await request.post('/api/namespaces', { data: { name: `Phase QA ${crypto.randomUUID()}`, cli_command: `phase-${crypto.randomUUID()}`, workflow_id: workflowId } })
+  expect(namespace.ok()).toBeTruthy()
+  namespaceId = (await namespace.json()).namespace_id as number
+  const second = await request.post('/api/phases', { data: { workflow_id: workflowId, mode_id: modeId, phase_order: 2, name: 'Second catalog phase' } })
+  expect(second.ok()).toBeTruthy()
+  initial = await rows(request)
+  expect(initial).toHaveLength(2)
+})
+test.afterEach(async ({ request }) => {
+  if (namespaceId) expect((await request.delete(`/api/namespaces/${namespaceId}`)).ok()).toBeTruthy()
+  if (workflowId) expect((await request.delete(`/api/workflows/${workflowId}`)).ok()).toBeTruthy()
+})
+
+for (const theme of ['dark', 'gray', 'light']) {
+  test(`phase catalog Base geometry, targets, keyboard and native writes (${theme})`, async ({ page, request }, testInfo) => {
+    const widths = testInfo.project.name === 'desktop' ? [1023, 1024, 1279, 1280, 1440, 1920, 2560] : [375, 767, 768]
+    expect((await request.put(`/api/phases/${initial[0].id}`, { data: { name: 'Длинное название фазы '.repeat(18), description: 'Длинное описание '.repeat(40) } })).ok()).toBeTruthy()
+    await page.addInitScript(value => localStorage.setItem('workflow-theme', value), theme)
+    const errors: string[] = []
+    page.on('pageerror', error => errors.push(error.message))
+    for (const width of widths) {
+      await page.setViewportSize({ width, height: 1080 })
+      await page.goto(pageUrl())
+      await page.reload()
+      await expect(page.locator('[data-page-layout]')).toHaveAttribute('data-page-layout', 'wide')
+      const geometry = await page.evaluate(() => {
+        const frame = document.querySelector('.page-frame')!.getBoundingClientRect()
+        const header = document.querySelector('.base-ssr-header')!.getBoundingClientRect()
+        const panel = document.querySelector('.timeline-panel')!.getBoundingClientRect()
+        return { overflow: document.documentElement.scrollWidth - innerWidth, left: frame.left, right: frame.right, header: header.height, panelRight: panel.right }
+      })
+      expect(geometry.overflow).toBe(0)
+      expect(geometry.left).toBe(width >= 1280 ? 264 : width >= 768 ? 72 : 0)
+      expect(geometry.right).toBe(width)
+      expect(geometry.header).toBe(60)
+      expect(geometry.panelRight).toBeLessThanOrEqual(width - 16)
+      const item = items(page).first()
+      const summary = item.locator('summary')
+      await summary.focus()
+      await page.keyboard.press('Enter')
+      await expect(item.locator('.phase-actions-menu')).toBeVisible()
+      for (const control of [summary, item.locator('.execution-toggle'), page.locator('.phase-add-btn').first(), page.locator('[data-phase-view="compact"]')]) {
+        const bounds = (await control.boundingBox())!
+        expect(bounds.height).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
+        expect(bounds.width).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
+      }
+      await page.keyboard.press('Escape')
+      await expect(summary).toBeFocused()
+      await expect(item.locator('.phase-actions-menu')).toBeHidden()
+      if ([375, 1920].includes(width)) await page.screenshot({ path: testInfo.outputPath(`phase-catalog-${theme}-${width}.png`), fullPage: true })
+    }
+    await action(page, 0, '.execution-toggle')
+    await expect(items(page).first()).toHaveAttribute('data-execution-type', 'parallel')
+    expect((await rows(request))[0].execution_type).toBe('parallel')
+    await action(page, 0, '.move-down-btn')
+    await expect(items(page).first()).toHaveAttribute('data-phase-id', String(initial[1].id))
+    expect((await rows(request)).map(row => row.id)).toEqual([initial[1].id, initial[0].id])
+    await page.locator('.phase-add-btn').last().click()
+    await expect(items(page)).toHaveCount(3)
+    expect(await rows(request)).toHaveLength(3)
+    expect(new URL(page.url()).searchParams.get('namespace_id')).toBe(String(namespaceId))
+    expect(new URL(page.url()).searchParams.get('foreign')).toBe('keep')
+    expect(errors).toEqual([])
+  })
+}
+
+test('phase catalog same-tick locks all writes, preserves DOM until scoped readback', async ({ page }) => {
+  await page.goto(pageUrl())
+  let writes = 0
+  let release!: () => void
+  const pending = new Promise<void>(resolve => { release = resolve })
+  await page.route('**/api/phases/order*', async route => {
+    writes++
+    await pending
+    await route.fulfill({ status: 409, json: { ok: false, error: 'Catalog conflict' } })
+  })
+  await page.evaluate(() => {
+    const button = document.querySelector<HTMLElement>('.move-down-btn')!
+    button.click()
+    button.click()
+    document.querySelector<HTMLElement>('.phase-add-btn')!.click()
+    document.querySelector<HTMLElement>('.execution-toggle')!.click()
+    document.querySelector<HTMLElement>('.phase-delete-btn')!.click()
+  })
+  await expect.poll(() => writes).toBe(1)
+  await expect(page.locator('#phasesTimeline')).toHaveAttribute('aria-busy', 'true')
+  await expect(page.locator('.phase-add-btn').first()).toBeDisabled()
+  await page.locator('.phases-header-action').click()
+  await expect(draftDialog(page)).toBeVisible()
+  await expect(draftDialog(page).locator('[data-base-draft-discard]')).toBeDisabled()
+  await draftDialog(page).locator('[data-base-draft-cancel]').click()
+  release()
+  await expect(state(page)).toContainText('Catalog conflict')
+  await expect(state(page)).toBeFocused()
+  await expect(items(page).first()).toHaveAttribute('data-phase-id', String(initial[0].id))
+  await expect(page.locator('.phase-add-btn').first()).toBeEnabled()
+  await expect(items(page).first().locator('.move-up-btn')).toBeDisabled()
+  await expect(items(page).last().locator('.move-down-btn')).toBeDisabled()
+  expect(writes).toBe(1)
+})
+
+for (const kind of ['type', 'reorder'] as const) {
+  test(`phase catalog committed ${kind} with lost reply only reconciles, never repeats`, async ({ page, request }) => {
+    await page.goto(pageUrl())
+    let writes = 0
+    const pattern = kind === 'type' ? `**/api/phases/${initial[0].id}*` : '**/api/phases/order*'
+    await page.route(pattern, async route => {
+      writes++
+      const response = await route.fetch()
+      expect(response.ok()).toBeTruthy()
+      await route.abort('failed')
+    })
+    await action(page, 0, kind === 'type' ? '.execution-toggle' : '.move-down-btn')
+    await expect(recovery(page)).toBeVisible()
+    await expect(recovery(page)).toBeFocused()
+    await expect(page.locator('.phase-add-btn').first()).toBeDisabled()
+    await expect(items(page).first()).toHaveAttribute('data-phase-id', String(initial[0].id))
+    await page.locator('.phases-header-action').click()
+    await expect(draftDialog(page)).toBeVisible()
+    await draftDialog(page).locator('[data-base-draft-cancel]').click()
+    await recovery(page).click()
+    if (kind === 'type') {
+      await expect(items(page).first()).toHaveAttribute('data-execution-type', 'parallel')
+      expect((await rows(request))[0].execution_type).toBe('parallel')
+    } else {
+      await expect(items(page).first()).toHaveAttribute('data-phase-id', String(initial[1].id))
+      expect((await rows(request)).map(row => row.id)).toEqual([initial[1].id, initial[0].id])
+    }
+    expect(writes).toBe(1)
+  })
+}
+
+test('phase catalog lost create reply never claims a new object without its returned ID', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  let writes = 0
+  await page.route('**/api/phases?*', async route => {
+    if (route.request().method() !== 'POST') { await route.continue(); return }
+    writes++
+    expect((await route.fetch()).ok()).toBeTruthy()
+    await route.abort('failed')
+  })
+  await page.locator('.phase-add-btn').first().click()
+  await expect(recovery(page)).toBeVisible()
+  await recovery(page).click()
+  await expect(state(page)).toContainText('ID созданной фазы не получен')
+  await expect(items(page)).toHaveCount(2)
+  await expect(page.locator('.phase-add-btn').first()).toBeDisabled()
+  await expect(page.locator('#phaseInspectCatalogue')).toBeVisible()
+  await expect(page.locator('#phaseInspectCatalogue')).toHaveAttribute('target', '_blank')
+  expect(await rows(request)).toHaveLength(3)
+  expect(writes).toBe(1)
+})
+
+test('phase catalog create ACK keeps returned ID while readback fails, then reconciles safely', async ({ page }) => {
+  await page.goto(pageUrl())
+  let writes = 0
+  let allowRead = false
+  let createdId: number | undefined
+  await page.route('**/api/phases?*', async route => {
+    if (route.request().method() === 'POST') {
+      writes++
+      const response = await route.fetch()
+      createdId = (await response.json()).phase_id as number
+      await route.fulfill({ response })
+    } else if (!allowRead) await route.fulfill({ status: 503, json: { ok: false } })
+    else await route.continue()
+  })
+  await page.locator('.phase-add-btn').first().click()
+  await expect(recovery(page)).toBeVisible()
+  await expect(state(page)).toContainText('Не удалось проверить')
+  await expect(page.locator('#phaseInspectCatalogue')).toBeHidden()
+  allowRead = true
+  await recovery(page).click()
+  await expect(items(page)).toHaveCount(3)
+  await expect(items(page).nth(1)).toHaveAttribute('data-phase-id', String(createdId))
+  expect(writes).toBe(1)
+})
+
+for (const status of [401, 403, 404, 409, 422]) {
+  test(`phase catalog distinguishes write rejection ${status}, no reload or false success`, async ({ page }) => {
+    await page.goto(pageUrl())
+    await page.route(`**/api/phases/${initial[0].id}*`, route => route.fulfill({ status, json: { ok: false, error: `Rejected ${status}` } }))
+    await action(page, 0, '.execution-toggle')
+    await expect(state(page)).toContainText(`Rejected ${status}`)
+    await expect(state(page)).toHaveAttribute('data-page-state', status === 404 ? 'not-found' : [401, 403].includes(status) ? 'permission-denied' : 'error')
+    await expect(recovery(page)).toBeHidden()
+    await expect(items(page)).toHaveCount(2)
+    await expect(items(page).first()).toHaveAttribute('data-execution-type', 'sync')
+    if ([401, 403, 404].includes(status)) await expect(page.locator('.phase-add-btn').first()).toBeDisabled()
+    else await expect(page.locator('.phase-add-btn').first()).toBeEnabled()
+  })
+}
+
+for (const invalid of ['wrong-scope', 'duplicate', 'gap', 'wrong-order', 'failed-envelope']) {
+  test(`phase catalog rejects ${invalid} readback, keeps uncertain write blocked`, async ({ page, request }) => {
+    await page.goto(pageUrl())
+    await page.route('**/api/phases/order*', async route => {
+      expect((await route.fetch()).ok()).toBeTruthy()
+      await route.abort('failed')
+    })
+    await action(page, 0, '.move-down-btn')
+    await expect(recovery(page)).toBeVisible()
+    const response = await request.get(catalogue())
+    const data = await response.json()
+    if (invalid === 'wrong-scope') data.workflow.id = workflowId + 100000
+    if (invalid === 'duplicate') data.phases[1].id = data.phases[0].id
+    if (invalid === 'gap') data.phases[1].phase_order = 999
+    if (invalid === 'wrong-order') data.phases = initial
+    if (invalid === 'failed-envelope') data.ok = false
+    await page.route('**/api/phases?*', route => route.fulfill({ json: data }))
+    await recovery(page).click()
+    await expect(state(page)).toBeVisible()
+    await expect(recovery(page)).toBeEnabled()
+    await expect(page.locator('.phase-add-btn').first()).toBeDisabled()
+    await expect(items(page).first()).toHaveAttribute('data-phase-id', String(initial[0].id))
+  })
+}
+
+test('phase catalog deletion shares the write lock, cancelled unknown delete is readback-only', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  let deletes = 0
+  await page.route(`**/api/phases/${initial[0].id}*`, async route => {
+    deletes++
+    expect((await route.fetch()).ok()).toBeTruthy()
+    await route.abort('failed')
+  })
+  await action(page, 0, '.phase-delete-btn')
+  const confirm = page.locator('#confirmDialog')
+  await expect(confirm).toBeVisible()
+  await expect(page.locator('.phase-add-btn').first()).toBeDisabled()
+  await confirm.locator('[data-base-confirm-accept]').click()
+  await expect(confirm.locator('#confirmReconcile')).toBeVisible()
+  await page.keyboard.press('Escape')
+  await expect(page.locator('.phase-add-btn').first()).toBeDisabled()
+  const trigger = items(page).first().locator('.phase-delete-btn')
+  await expect(trigger).toBeFocused()
+  await trigger.click()
+  await expect(confirm.locator('[data-base-confirm-accept]')).toBeDisabled()
+  await confirm.locator('#confirmReconcile').click()
+  await expect(items(page)).toHaveCount(1)
+  expect(await rows(request)).toHaveLength(1)
+  expect(deletes).toBe(1)
+})
+
+for (const reply of ['timeout', 'server-error', 'invalid-json', 'failed-envelope']) {
+  test(`phase catalog ${reply} is uncertain, unchanged readback does not authorize a repeat`, async ({ page }) => {
+    await page.goto(pageUrl())
+    let writes = 0
+    await page.route(`**/api/phases/${initial[0].id}*`, async route => {
+      writes++
+      if (reply === 'invalid-json') await route.fulfill({ status: 200, contentType: 'application/json', body: '{' })
+      else await route.fulfill({ status: reply === 'timeout' ? 408 : reply === 'server-error' ? 503 : 200, json: { ok: false } })
+    })
+    await action(page, 0, '.execution-toggle')
+    await expect(recovery(page)).toBeVisible()
+    await recovery(page).click()
+    await expect(state(page)).toContainText('запрошенное изменение не подтверждено')
+    await expect(page.locator('.phase-add-btn').first()).toBeDisabled()
+    await page.evaluate(() => {
+      document.querySelector<HTMLElement>('.execution-toggle')!.click()
+      document.querySelector<HTMLElement>('.phase-add-btn')!.click()
+    })
+    expect(writes).toBe(1)
+    await expect(items(page).first()).toHaveAttribute('data-execution-type', 'sync')
+  })
+}
+
+for (const status of [401, 403, 404]) {
+  test(`phase catalog readback ${status} removes retry and CRUD without treating failure as empty`, async ({ page }) => {
+    await page.goto(pageUrl())
+    await page.route(`**/api/phases/${initial[0].id}*`, async route => {
+      expect((await route.fetch()).ok()).toBeTruthy()
+      await route.abort('failed')
+    })
+    await action(page, 0, '.execution-toggle')
+    await expect(recovery(page)).toBeVisible()
+    await page.route('**/api/phases?*', route => route.fulfill({ status, json: { ok: false, error: `Readback ${status}` } }))
+    await recovery(page).click()
+    await expect(state(page)).toContainText(`Readback ${status}`)
+    await expect(state(page)).toHaveAttribute('data-page-state', status === 404 ? 'not-found' : 'permission-denied')
+    await expect(state(page)).toBeFocused()
+    await expect(recovery(page)).toBeHidden()
+    await expect(page.locator('.phase-add-btn').first()).toBeDisabled()
+    await expect(page.locator('[data-testid="workflow-mode-empty"]')).toHaveCount(0)
+    await expect(items(page)).toHaveCount(2)
+  })
+}
diff --git a/project_workflow/interfaces/ui/platform_services.py b/project_workflow/interfaces/ui/platform_services.py
index 582710f..c54b65f 100644
--- a/project_workflow/interfaces/ui/platform_services.py
+++ b/project_workflow/interfaces/ui/platform_services.py
@@ -1,8 +1,8 @@
 """Base runtime catalog for the native project-workflow service selector.
 
 The UI is server-rendered, so it reads the public Admin Panel catalog on the
-server with a short TTL cache. An unreachable Admin Panel never blocks a page:
-the local fallback is rendered instead.
+server with a short TTL cache. Failed reads render the local fallback and are
+cached briefly, so an outage does not add a network timeout to every page.
 """
 
 from __future__ import annotations
@@ -24,9 +24,11 @@ _FALLBACK_SERVICES: list[dict[str, Any]] = [
 ]
 _CURRENT_KEY = "project-workflow"
 _CACHE_TTL_SECONDS = 60.0
+_FAILURE_CACHE_TTL_SECONDS = 10.0
 _cached_at = 0.0
 _cached_services: list[dict[str, Any]] = []
 _cached_url: str | None = None
+_cached_source = "runtime"
 _VALID_HEALTH = {"healthy", "unreachable", "unknown"}
 _ORDER = {service["key"]: index for index, service in enumerate(_FALLBACK_SERVICES)}
 
@@ -85,20 +87,31 @@ def _with_request_host(services: list[dict[str, Any]], request_url: str | None)
     return adjusted
 
 
+def _cache_catalog(
+    catalog_url: str, services: list[dict[str, Any]], source: str, request_url: str | None,
+) -> ServiceCatalog:
+    global _cached_at, _cached_services, _cached_url, _cached_source
+    _cached_services = services
+    _cached_at = time.monotonic()
+    _cached_url = catalog_url
+    _cached_source = source
+    return ServiceCatalog(_with_request_host(services, request_url), source)
+
+
 def load_service_catalog(catalog_url: str | None, *, request_url: str | None = None) -> ServiceCatalog:
     """Return UI services, including current health, and the diagnostic source."""
-    global _cached_at, _cached_services, _cached_url
     if not catalog_url:
         return ServiceCatalog(_with_request_host(_FALLBACK_SERVICES, request_url), "fallback-unreachable")
     now = time.monotonic()
-    if _cached_url == catalog_url and _cached_services and now - _cached_at < _CACHE_TTL_SECONDS:
-        return ServiceCatalog(_with_request_host(_cached_services, request_url), "runtime")
+    ttl = _CACHE_TTL_SECONDS if _cached_source == "runtime" else _FAILURE_CACHE_TTL_SECONDS
+    if _cached_url == catalog_url and _cached_services and now - _cached_at < ttl:
+        return ServiceCatalog(_with_request_host(_cached_services, request_url), _cached_source)
     try:
         with urlopen(catalog_url, timeout=2.0) as response:  # nosec B310: configured internal URL
             body = response.read()
     except Exception:
-        return ServiceCatalog(
-            _with_request_host(_FALLBACK_SERVICES, request_url), "fallback-unreachable",
+        return _cache_catalog(
+            catalog_url, _FALLBACK_SERVICES, "fallback-unreachable", request_url,
         )
     try:
         payload = json.loads(body.decode("utf-8"))
@@ -123,19 +136,16 @@ def load_service_catalog(catalog_url: str | None, *, request_url: str | None = N
                 raise ValueError("invalid UI URL")
             services.append(normalized)
     except Exception:
-        return ServiceCatalog(
-            _with_request_host(_FALLBACK_SERVICES, request_url), "fallback-invalid",
+        return _cache_catalog(
+            catalog_url, _FALLBACK_SERVICES, "fallback-invalid", request_url,
         )
     if not services:
-        return ServiceCatalog(
-            _with_request_host(_FALLBACK_SERVICES, request_url),
-            "fallback-empty" if not raw_entries else "fallback-invalid",
+        return _cache_catalog(
+            catalog_url, _FALLBACK_SERVICES,
+            "fallback-empty" if not raw_entries else "fallback-invalid", request_url,
         )
     services.sort(key=lambda service: (_ORDER.get(service["key"], len(_ORDER)), service["key"]))
-    _cached_services = services
-    _cached_at = now
-    _cached_url = catalog_url
-    return ServiceCatalog(_with_request_host(services, request_url), "runtime")
+    return _cache_catalog(catalog_url, services, "runtime", request_url)
 
 
 def load_other_services(catalog_url: str | None, *, request_url: str | None = None) -> list[dict[str, Any]]:
diff --git a/project_workflow/interfaces/ui/templates/phase_catalog.js b/project_workflow/interfaces/ui/templates/phase_catalog.js
new file mode 100644
index 0000000..9e69a17
--- /dev/null
+++ b/project_workflow/interfaces/ui/templates/phase_catalog.js
@@ -0,0 +1,211 @@
+// Product owns phase mutations; Base owns controls, states, dialogs and navigation guards.
+const phaseNamespaceId={{ selected_namespace.id if selected_namespace else 'null' }};
+let phaseMutationPending=false;
+let phaseUnknownWrite=null;
+let phaseTerminalState=null;
+let phaseDeletionAttempt=null;
+
+function phaseApiUrl(path){
+  const url=new URL(path,window.location.origin);
+  if(phaseNamespaceId)url.searchParams.set('namespace_id',String(phaseNamespaceId));
+  return url.pathname+url.search;
+}
+function phaseScope(){
+  const timeline=document.getElementById('phasesTimeline');
+  return {workflow_id:Number(timeline.dataset.workflowId),mode_id:Number(timeline.dataset.modeId)};
+}
+function phaseWritesBlocked(){return phaseMutationPending||Boolean(phaseUnknownWrite||phaseTerminalState||phaseDeletionAttempt);}
+function showPhaseError(message,kind='error'){
+  const container=document.getElementById('phaseWriteError');
+  container.hidden=!message;
+  const state=container.querySelector('[data-page-state]');
+  state.dataset.pageState=kind;
+  state.setAttribute('role',['error','partial-error'].includes(kind)?'alert':'status');
+  state.querySelector('p').textContent=message;
+  state.tabIndex=-1;
+}
+function updatePhaseControls(){
+  const items=getPhaseTimelineItems();
+  items.forEach((item,index)=>{
+    item.querySelectorAll('button').forEach(button=>{
+      button.disabled=phaseWritesBlocked()||
+        (button.classList.contains('move-up-btn')&&index===0)||
+        (button.classList.contains('move-down-btn')&&index===items.length-1)||
+        (button.classList.contains('phase-delete-btn')&&items.length<=1);
+    });
+  });
+  document.querySelectorAll('.phase-add-btn').forEach(button=>{button.disabled=phaseWritesBlocked();});
+  if(phaseDeletionAttempt&&!phaseTerminalState){
+    // Keep the initiator focusable for Base's cancel/return-focus lifecycle.
+    phaseDeletionAttempt.button.disabled=false;
+  }
+  const recovery=document.getElementById('phaseRecoveryActions');
+  recovery.hidden=!phaseUnknownWrite||Boolean(phaseTerminalState);
+  document.getElementById('phaseReconcileButton').disabled=phaseMutationPending;
+  document.getElementById('phaseInspectCatalogue').hidden=phaseUnknownWrite?.kind!=='create'||Boolean(phaseUnknownWrite?.receivedId);
+  document.getElementById('phasesTimeline').setAttribute('aria-busy',String(phaseMutationPending));
+  refreshWorkflowDraftGuard();
+}
+function focusPhaseRecovery(){
+  if(phaseUnknownWrite&&!phaseTerminalState)document.getElementById('phaseReconcileButton').focus();
+  else if(!document.getElementById('phaseWriteError').hidden)document.querySelector('#phaseWriteError [data-page-state]').focus();
+}
+function rejectPhaseWrite(response,data){
+  phaseTerminalState=[401,403].includes(response.status)?'permission-denied':response.status===404?'not-found':null;
+  showPhaseError(data&&typeof data.error==='string'?data.error:'Изменения отклонены. Проверьте доступ и состояние фаз.',phaseTerminalState||'error');
+}
+async function readPhaseCatalogue(){
+  const scope=phaseScope();
+  const response=await fetch(phaseApiUrl('/api/phases?workflow_id='+scope.workflow_id+'&mode_id='+scope.mode_id),{cache:'no-store'});
+  const data=await response.json().catch(()=>null);
+  if([401,403,404].includes(response.status)){
+    const error=new Error('Каталог недоступен');
+    error.status=response.status;
+    rejectPhaseWrite(response,data);
+    throw error;
+  }
+  if(!response.ok||!data||data.ok!==true||data.workflow?.id!==scope.workflow_id||data.mode?.id!==scope.mode_id||
+    !Array.isArray(data.phases)||!data.phases.every(item=>item&&Number.isInteger(item.id)&&item.id>0&&
+      item.workflow_id===scope.workflow_id&&item.mode_id===scope.mode_id&&Number.isInteger(item.phase_order)&&
+      item.phase_order>0&&['sync','parallel'].includes(item.execution_type))||
+    new Set(data.phases.map(item=>item.id)).size!==data.phases.length)throw new Error('Некорректный каталог');
+  const rows=[...data.phases].sort((a,b)=>a.phase_order-b.phase_order);
+  if(rows.some((row,index)=>row.phase_order!==index+1))throw new Error('Некорректный порядок фаз');
+  return rows;
+}
+function phaseAttemptConfirmed(rows,attempt){
+  let expectedIds=attempt.ids;
+  if(attempt.kind==='create'){
+    if(!attempt.receivedId||attempt.ids.includes(attempt.receivedId))return false;
+    expectedIds=[...attempt.ids];
+    expectedIds.splice(attempt.payload.phase_order-1,0,attempt.receivedId);
+  }
+  if(JSON.stringify(rows.map(row=>row.id))!==JSON.stringify(expectedIds))return false;
+  if(attempt.kind==='type')return rows.some(row=>row.id===attempt.id&&row.execution_type===attempt.payload.execution_type);
+  if(attempt.kind==='create')return rows.some(row=>row.id===attempt.receivedId&&row.execution_type==='sync');
+  return true;
+}
+function finishPhaseWrite(){
+  phaseUnknownWrite=null;
+  phaseDeletionAttempt=null;
+  phaseMutationPending=false;
+  showPhaseError('');
+  updatePhaseControls();
+  window.location.reload();
+}
+async function verifyPhaseAttempt(attempt){
+  try{
+    const rows=await readPhaseCatalogue();
+    if(phaseAttemptConfirmed(rows,attempt)){finishPhaseWrite();return true;}
+    showPhaseError(attempt.kind==='create'&&!attempt.receivedId?
+      'ID созданной фазы не получен. Каталог доступен, но результат этой записи не подтверждён. Повтор заблокирован.':
+      'Каталог загружен, но запрошенное изменение не подтверждено. Повторная запись заблокирована.');
+  }catch(_error){
+    if(!phaseTerminalState)showPhaseError('Не удалось проверить результат записи. Повтор заблокирован до проверки.');
+  }
+  return false;
+}
+async function requestPhaseWrite(attempt){
+  if(phaseWritesBlocked())return;
+  phaseMutationPending=true;
+  showPhaseError('');
+  updatePhaseControls();
+  try{
+    const response=await fetch(phaseApiUrl(attempt.url),{
+      method:attempt.kind==='create'?'POST':'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(attempt.payload),
+    });
+    const data=await response.json().catch(()=>null);
+    if(!response.ok&&!([408].includes(response.status)||response.status>=500)){
+      rejectPhaseWrite(response,data);
+      return;
+    }
+    phaseUnknownWrite=attempt;
+    if(response.ok&&data?.ok===true){
+      if(attempt.kind==='create'&&Number.isInteger(data.phase_id)&&data.phase_id>0&&data.phase?.id===data.phase_id&&
+        data.phase.workflow_id===attempt.payload.workflow_id&&data.phase.mode_id===attempt.payload.mode_id&&
+        !attempt.ids.includes(data.phase_id))attempt.receivedId=data.phase_id;
+      if(attempt.kind!=='create'||attempt.receivedId){
+        if(await verifyPhaseAttempt(attempt))return;
+      }else showPhaseError('ID созданной фазы не подтверждён. Повтор заблокирован до проверки.');
+    }else showPhaseError('Результат записи неизвестен. Повтор заблокирован до проверки.');
+  }catch(_error){
+    phaseUnknownWrite=attempt;
+    showPhaseError('Результат записи неизвестен. Повтор заблокирован до проверки.');
+  }finally{
+    phaseMutationPending=false;
+    updatePhaseControls();
+    focusPhaseRecovery();
+  }
+}
+async function reconcilePhaseWrite(){
+  if(phaseMutationPending||!phaseUnknownWrite||phaseTerminalState)return;
+  phaseMutationPending=true;
+  updatePhaseControls();
+  try{await verifyPhaseAttempt(phaseUnknownWrite);}
+  finally{phaseMutationPending=false;updatePhaseControls();focusPhaseRecovery();}
+}
+function phaseIds(){return getPhaseTimelineItems().map(item=>Number(item.dataset.phaseId));}
+async function addPhaseAfter(button){
+  if(phaseWritesBlocked())return;
+  const workflowId=document.getElementById('phasesTimeline')?.dataset.workflowId;
+  const modeId=document.getElementById('phasesTimeline')?.dataset.modeId;
+  const currentOrder=Number(button.dataset.afterOrder||'0');
+  if(!workflowId||!modeId||!Number.isInteger(currentOrder)||currentOrder<0||currentOrder>phaseIds().length){
+    showPhaseError('Не удалось определить позицию фазы.');focusPhaseRecovery();return;
+  }
+  await requestPhaseWrite({kind:'create',url:'/api/phases',ids:phaseIds(),payload:{workflow_id:Number(workflowId),mode_id:Number(modeId),phase_order:currentOrder+1}});
+}
+async function togglePhaseType(button){
+  if(phaseWritesBlocked())return;
+  const item=button.closest('.timeline-item');
+  if(!item)return;
+  await requestPhaseWrite({kind:'type',url:'/api/phases/'+item.dataset.phaseId,id:Number(item.dataset.phaseId),ids:phaseIds(),
+    payload:{execution_type:item.dataset.executionType==='sync'?'parallel':'sync'}});
+}
+async function movePhase(button,direction){
+  if(phaseWritesBlocked()||![-1,1].includes(direction))return;
+  const item=button.closest('.timeline-item');
+  const ids=phaseIds();
+  const index=ids.indexOf(Number(item?.dataset.phaseId));
+  if(index<0||index+direction<0||index+direction>=ids.length)return;
+  const moved=ids.splice(index,1)[0];
+  ids.splice(index+direction,0,moved);
+  await requestPhaseWrite({kind:'reorder',url:'/api/phases/order',ids,payload:{orders:ids.map((id,i)=>({phase_id:id,phase_order:i+1}))}});
+}
+async function deletePhase(button){
+  if(phaseMutationPending||phaseUnknownWrite||phaseTerminalState||(phaseDeletionAttempt&&phaseDeletionAttempt.button!==button))return;
+  const item=button.closest('.timeline-item');
+  if(!item||phaseIds().length<=1)return;
+  const phaseName=item.querySelector('.timeline-name')?.textContent.trim()||'эту фазу';
+  const url=phaseApiUrl('/api/phases/'+item.dataset.phaseId);
+  phaseDeletionAttempt={button,url};
+  phaseMutationPending=true;
+  showPhaseError('');
+  updatePhaseControls();
+  let confirmed=false;
+  try{
+    confirmed=await requestWorkflowDeletion({url,title:'Удалить фазу «'+phaseName+'»?',
+      message:'Фаза «'+phaseName+'» и её настройки будут удалены.',returnFocus:button,
+      exists:async()=>{const rows=await readPhaseCatalogue();return rows.some(row=>row.id===Number(item.dataset.phaseId));},
+    });
+    if(confirmed){finishPhaseWrite();return;}
+    const state=workflowDeletionState(url);
+    if(state.kind==='ready')phaseDeletionAttempt=null;
+    else{
+      if(state.kind==='terminal')phaseTerminalState=state.status===404?'not-found':'permission-denied';
+      showPhaseError(state.error,phaseTerminalState||'error');
+    }
+  }finally{
+    phaseMutationPending=false;
+    updatePhaseControls();
+    if(phaseTerminalState)focusPhaseRecovery();
+    else if(!confirmed&&!button.disabled)button.focus();
+  }
+}
+registerWorkflowDraftGuard({
+  isDirty:()=>Boolean(phaseUnknownWrite||phaseDeletionAttempt),
+  isPending:()=>phaseMutationPending,
+});
+document.addEventListener('DOMContentLoaded',()=>{
+  document.getElementById('phaseReconcileButton').addEventListener('click',reconcilePhaseWrite);
+});
