diff --git a/CHANGELOG.md b/CHANGELOG.md
index 7095927..cb53fb9 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -13,6 +13,11 @@
 - Standalone-режим: репозиторий собирается и запускается без соседнего `services-base` (убраны extra `cli-platform`, uv source, Docker additional_context и CI checkout). Token-режим CLI без `sdlc-cli-core` выдаёт понятную ошибку; запуск без `AUTH_ISSUER` работает без авторизации.
 
 ### Fixed
+- Jinja deletion confirmations use the shared Base SSR native dialog instead
+  of a local modal shell. Pending callbacks keep the dialog locked until API
+  acknowledgement; uncertain deletes block repeat writes across cancel/reopen
+  and require an explicit read-only catalogue check. Namespace deletion defers
+  navigation until confirmed success, and the initial namespace icon renders.
 - Namespace forms use the Base SSR draft guard for links, context selectors,
   create cancellation and indexed Back/Forward. Pending writes block duplicates;
   rejected writes retain fields, while unknown outcomes require read-only
diff --git a/docs/UI_UX_MAP.md b/docs/UI_UX_MAP.md
index 39870d2..849a9b9 100644
--- a/docs/UI_UX_MAP.md
+++ b/docs/UI_UX_MAP.md
@@ -73,3 +73,13 @@ Preview задаёт canonical accent tokens, не переопределяя re
 Нет новых endpoint, auth store или изменений основного Jinja/runtime bridge.
 Актуальные source gates и browser evidence фиксируются отдельно; immutable image,
 SSO/roles/states/drafts и release provenance остаются обязательной отдельной проверкой.
+
+Ordinary Jinja confirmation использует Base `confirm_dialog`/`BaseConfirmDialog`;
+заменённые modal markup, CSS и ручное inert/focus управление удалены.
+DELETE ожидает подтверждённый ACK; unknown outcome запрещает повтор, включая
+cancel/reopen, и предоставляет только явную GET-сверку существующего каталога.
+Ошибки доступа/отсутствующего объекта не предлагают новую запись. Namespace
+сохраняет собственную domain reconciliation и выполняет departure после ACK.
+Начальный preview namespace получает SVG без дополнительного ввода в форму.
+Это не завершение backlog: workflows/agents create/update draft safety,
+pending/unknown/ACK lifecycle и оставшиеся controls требуют отдельной миграции.
diff --git a/docs/quality-gate.md b/docs/quality-gate.md
index bc0f67c..2828452 100644
--- a/docs/quality-gate.md
+++ b/docs/quality-gate.md
@@ -154,21 +154,26 @@ node scripts/capture_ui_screenshots.mjs
 Для backend-only тестовых или документационных изменений browser smoke не
 обязателен.
 
-## Namespace SSR State Tests
+## Namespace And Confirmation SSR State Tests
 
 Start the documented source preview with an isolated neutral SQLite smoke
 fixture (never a runtime database). In another terminal run:
 
 ```powershell
 $env:WORKFLOW_UI_QA_ORIGIN = "http://127.0.0.1:8812"
+$env:WORKFLOW_UI_QA_MUTATIONS = "isolated-fixture"
 pnpm --dir frontend test:ssr
 ```
 
 The runner requires an already-started loopback fixture with `workflow-dev`
-and `workflow-qa` namespaces. It does not launch containers or mutate fixture
-data: unexpected API writes are blocked; write/error scenarios use explicit
-route fixtures. It checks desktop/mobile draft, context/history, pending,
-reconciliation and focus behavior. Captures and JSON results are stored in
+and `workflow-qa` namespaces. The mutation opt-in is mandatory; never point it
+at a runtime database. It does not launch containers. Namespace draft tests
+block unexpected API writes and use explicit route fixtures for write/error
+scenarios. Confirmation tests create uniquely named disposable agents and
+namespaces through the real API, then remove only their own IDs in teardown;
+the existing seeded records are not deleted. Both suites check desktop/mobile
+draft, context/history, pending, reconciliation and focus behavior.
+Captures and JSON results are stored in
 `.smoke/namespace-drafts`; archive them with source/Base fingerprints before
 another run. These tests supplement, not replace, no-mock route smoke, full
 Python/PostgreSQL gates and actual-image/SSO acceptance.
diff --git a/frontend/e2e/deletion-confirmation.spec.ts b/frontend/e2e/deletion-confirmation.spec.ts
new file mode 100644
index 0000000..84593cf
--- /dev/null
+++ b/frontend/e2e/deletion-confirmation.spec.ts
@@ -0,0 +1,251 @@
+import { expect, test, type APIRequestContext, type Page } from '@playwright/test'
+
+if (process.env.WORKFLOW_UI_QA_MUTATIONS !== 'isolated-fixture') {
+  throw new Error('Confirmation QA requires WORKFLOW_UI_QA_MUTATIONS=isolated-fixture and an isolated database')
+}
+
+const dialog = (page: Page) => page.locator('#confirmDialog')
+const accept = (page: Page) => page.locator('[data-base-confirm-accept]')
+const cancel = (page: Page) => page.locator('[data-base-confirm-cancel]')
+
+let id: number
+let name: string
+
+test.beforeEach(async ({ request }) => {
+  id = 0
+  name = `confirmation-${crypto.randomUUID()}`
+  const response = await request.post('/api/agents', { data: { name, description: 'Disposable confirmation fixture' } })
+  expect(response.ok()).toBeTruthy()
+  id = (await response.json()).agent_id
+  expect(id).toBeGreaterThan(0)
+})
+
+test.afterEach(async ({ request }) => {
+  if (id <= 0) return
+  const response = await request.get('/api/agents')
+  expect(response.ok()).toBeTruthy()
+  if ((await response.json()).agents.some((item: { id: number }) => item.id === id)) {
+    expect((await request.delete(`/api/agents/${id}`)).ok()).toBeTruthy()
+  }
+})
+
+async function openDeletion(page: Page) {
+  await page.goto('/agents?namespace_id=1')
+  await page.locator(`.agent-entry[data-id="${id}"] summary`).click()
+  await page.locator(`.agent-entry[data-id="${id}"] .agent-delete`).click()
+  await expect(dialog(page)).toBeVisible()
+  await expect(cancel(page)).toBeFocused()
+}
+
+test('Escape dismisses phase confirmation without closing its owning action menu', async ({ page }) => {
+  await page.goto('/phases?namespace_id=1')
+  const menu = page.locator('.phase-card-actions').first()
+  await menu.locator('summary').click()
+  const trigger = menu.locator('button[onclick="deletePhase(this)"]')
+  await expect(trigger).toBeEnabled()
+  await trigger.click()
+  await expect(cancel(page)).toBeFocused()
+  await page.keyboard.press('Escape')
+  await expect(dialog(page)).not.toBeVisible()
+  await expect(trigger).toBeFocused()
+  await expect(menu).toHaveAttribute('open', '')
+})
+
+for (const theme of ['dark', 'gray', 'light']) {
+  test(`Base modal geometry, keyboard and focus (${theme})`, async ({ page }) => {
+    await page.addInitScript(value => localStorage.setItem('workflow-theme', value), theme)
+    for (const width of [375, 767, 768, 1023, 1024, 1279, 1280, 1440, 1920, 2560]) {
+      await page.setViewportSize({ width, height: 1080 })
+      await openDeletion(page)
+      const bounds = await dialog(page).boundingBox()
+      expect(bounds!.x).toBeGreaterThanOrEqual(15)
+      expect(bounds!.width).toBeLessThanOrEqual(Math.min(480, width - 32) + 1)
+      expect(bounds!.x + bounds!.width).toBeLessThanOrEqual(width - 15)
+      expect(await page.evaluate(() => document.documentElement.scrollWidth - innerWidth)).toBe(0)
+      expect(await page.locator('main').evaluate(node => (node as HTMLElement).inert)).toBe(false)
+      // Native modal inertness is browser-managed, not a product-owned inert attribute.
+      await page.locator('#newName').evaluate(node => (node as HTMLElement).focus())
+      await expect(cancel(page)).toBeFocused()
+      await page.keyboard.press('Shift+Tab')
+      await expect(accept(page)).toBeFocused()
+      await page.keyboard.press('Tab')
+      await expect(cancel(page)).toBeFocused()
+      if ([375, 1920, 2560].includes(width)) {
+        await page.screenshot({ path: test.info().outputPath(`confirm-${theme}-${width}.png`), fullPage: true })
+      }
+      await page.keyboard.press('Escape')
+      await expect(dialog(page)).not.toBeVisible()
+      await expect(page.locator(`.agent-entry[data-id="${id}"] .agent-delete`)).toBeFocused()
+      await expect(page.locator('main')).not.toHaveAttribute('inert', '')
+    }
+  })
+}
+
+for (const status of [409, 422, 401, 403, 404]) {
+  test(`rejected DELETE ${status} stays open; unavailable objects cannot retry`, async ({ page }) => {
+    let writes = 0
+    await page.route(`**/api/agents/${id}`, async route => {
+      expect(route.request().method()).toBe('DELETE')
+      writes++
+      await route.fulfill({ status, json: { ok: false, error: `Rejected ${status}` } })
+    })
+    await openDeletion(page)
+    await accept(page).click()
+    await expect(dialog(page)).toBeVisible()
+    await expect(page.locator('[data-base-confirm-error]')).toHaveText(`Rejected ${status}`)
+    await expect(page.locator(`.agent-entry[data-id="${id}"]`)).toBeVisible()
+    if ([401, 403, 404].includes(status)) await expect(accept(page)).toBeDisabled()
+    else await expect(accept(page)).toBeEnabled()
+    await expect(cancel(page)).toBeEnabled()
+    await expect(page.locator('#confirmReconcile')).not.toBeVisible()
+    expect(writes).toBe(1)
+    await cancel(page).click()
+  })
+}
+
+test('pending DELETE locks modal and duplicate handlers until acknowledged success', async ({ page }) => {
+  let writes = 0
+  let release!: () => void
+  const held = new Promise<void>(resolve => { release = resolve })
+  await page.route(`**/api/agents/${id}`, async route => {
+    writes++
+    await held
+    await route.fulfill({ json: { ok: true } })
+  })
+  try {
+    await openDeletion(page)
+    await accept(page).click()
+    await expect(dialog(page)).toHaveAttribute('aria-busy', 'true')
+    await expect(accept(page)).toBeDisabled()
+    await expect(cancel(page)).toBeDisabled()
+    await page.keyboard.press('Escape')
+    await expect(dialog(page)).toBeVisible()
+    await page.evaluate(agentId => {
+      const ui = window as unknown as { deleteAgent: (button: HTMLElement) => void }
+      const button = document.querySelector<HTMLElement>(`.agent-entry[data-id="${agentId}"] .agent-delete`)!
+      ui.deleteAgent(button)
+      ui.deleteAgent(button)
+    }, id)
+    expect(writes).toBe(1)
+    release()
+    await expect(dialog(page)).not.toBeVisible()
+    await expect(page.locator(`.agent-entry[data-id="${id}"]`)).toHaveCount(0)
+    expect(await page.evaluate(() => document.activeElement !== document.body)).toBe(true)
+    expect(writes).toBe(1)
+  } finally { release() }
+})
+
+for (const outcome of ['server-error', 'network-error', 'invalid-ack']) {
+  test(`unknown DELETE ${outcome}: cancel/reopen preserves lock; only GET can reconcile`, async ({ page }) => {
+    let writes = 0
+    await page.route(`**/api/agents/${id}`, async route => {
+      writes++
+      if (outcome === 'network-error') await route.abort('failed')
+      else await route.fulfill({ status: outcome === 'server-error' ? 503 : 200, json: {} })
+    })
+    await openDeletion(page)
+    await accept(page).click()
+    await expect(accept(page)).toBeDisabled()
+    await expect(page.locator('#confirmReconcile')).toBeVisible()
+    await cancel(page).click()
+    await page.locator(`.agent-entry[data-id="${id}"] .agent-delete`).click()
+    await expect(accept(page)).toBeDisabled()
+    await page.locator('#confirmReconcile').click()
+    await expect(page.locator('[data-base-confirm-error]')).toContainText('Удаление пока не подтверждено')
+    expect(writes).toBe(1)
+    await page.route('**/api/agents', route => route.fulfill({ status: 503, json: { ok: false } }))
+    await page.locator('#confirmReconcile').click()
+    await expect(page.locator('[data-base-confirm-error]')).toContainText('Не удалось проверить результат')
+    await page.route('**/api/agents', route => route.fulfill({ json: { ok: true, agents: [null] } }))
+    await page.locator('#confirmReconcile').click()
+    await expect(accept(page)).toBeDisabled()
+    await expect(dialog(page)).toBeVisible()
+    await page.route('**/api/agents', route => route.fulfill({ json: { ok: true, agents: [] } }))
+    await page.locator('#confirmReconcile').click()
+    await expect(dialog(page)).not.toBeVisible()
+    await expect(page.locator(`.agent-entry[data-id="${id}"]`)).toHaveCount(0)
+    expect(writes).toBe(1)
+  })
+}
+
+async function namespaceFixture(request: APIRequestContext) {
+  const workflows = await request.get('/api/workflows')
+  expect(workflows.ok()).toBeTruthy()
+  const workflowId = (await workflows.json()).workflows.find((item: { is_default: boolean }) => item.is_default).id
+  const response = await request.post('/api/namespaces', { data: {
+    name: 'Disposable confirmation namespace', cli_command: `confirm-${crypto.randomUUID().slice(0, 8)}`, workflow_id: workflowId,
+  } })
+  expect(response.ok()).toBeTruthy()
+  return (await response.json()).namespace_id as number
+}
+
+async function removeNamespaceFixture(request: APIRequestContext, namespaceId: number) {
+  const response = await request.get('/api/namespaces')
+  expect(response.ok()).toBeTruthy()
+  if ((await response.json()).namespaces.some((item: { id: number }) => item.id === namespaceId)) {
+    expect((await request.delete(`/api/namespaces/${namespaceId}`)).ok()).toBeTruthy()
+  }
+}
+
+for (const outcome of ['server-error', 'network-error', 'invalid-ack']) {
+  test(`namespace DELETE ${outcome} never fulfills confirmation without ACK`, async ({ page, request }) => {
+    const namespaceId = await namespaceFixture(request)
+    let writes = 0
+    try {
+      await page.route(`**/api/namespaces/${namespaceId}`, async route => {
+        expect(route.request().method()).toBe('DELETE')
+        writes++
+        if (outcome === 'network-error') await route.abort('failed')
+        else await route.fulfill({ status: outcome === 'server-error' ? 503 : 200, json: {} })
+      })
+      await page.goto(`/namespaces?namespace_id=${namespaceId}`)
+      await expect(page.locator('#namespaceThemePreviewIcon svg path')).toBeVisible()
+      await page.locator('#deleteNamespaceButton').click()
+      await expect(cancel(page)).toBeFocused()
+      await accept(page).click()
+      await expect(dialog(page)).toBeVisible()
+      await expect(accept(page)).toBeDisabled()
+      await expect(cancel(page)).toBeEnabled()
+      await expect(page.locator('#confirmReconcile')).toBeVisible()
+      await expect(page.locator('#namespaceName')).toBeDisabled()
+      await page.locator('#confirmReconcile').click()
+      await expect(page.locator('[data-base-confirm-error]')).toContainText('Сохранение пока не подтверждено')
+      expect(writes).toBe(1)
+      const catalogue = await request.get('/api/namespaces')
+      const rows = (await catalogue.json()).namespaces
+      await page.route('**/api/namespaces', route => route.fulfill({ json: { ok: true, namespaces: rows.filter((item: { id: number }) => item.id !== namespaceId) } }))
+      await page.locator('#confirmReconcile').click()
+      await expect(dialog(page)).not.toBeVisible()
+      await expect(page).not.toHaveURL(new RegExp(`namespace_id=${namespaceId}$`))
+      expect(writes).toBe(1)
+    } finally { await removeNamespaceFixture(request, namespaceId) }
+  })
+}
+
+test('namespace pending DELETE keeps confirmation locked and defers departure until ACK', async ({ page, request }) => {
+  const namespaceId = await namespaceFixture(request)
+  let release!: () => void
+  const held = new Promise<void>(resolve => { release = resolve })
+  let writes = 0
+  try {
+    await page.route(`**/api/namespaces/${namespaceId}`, async route => {
+      writes++
+      await held
+      await route.fulfill({ json: { ok: true } })
+    })
+    await page.goto(`/namespaces?namespace_id=${namespaceId}`)
+    await page.locator('#deleteNamespaceButton').click()
+    await accept(page).click()
+    await expect(dialog(page)).toHaveAttribute('aria-busy', 'true')
+    await expect(page.locator('#namespaceName')).toBeDisabled()
+    await expect(cancel(page)).toBeDisabled()
+    await page.keyboard.press('Escape')
+    await expect(dialog(page)).toBeVisible()
+    await expect(page).toHaveURL(new RegExp(`namespace_id=${namespaceId}$`))
+    expect(writes).toBe(1)
+    release()
+    await expect(page).not.toHaveURL(new RegExp(`namespace_id=${namespaceId}$`))
+    await expect(dialog(page)).not.toBeVisible()
+    expect(writes).toBe(1)
+  } finally { release(); await removeNamespaceFixture(request, namespaceId) }
+})
diff --git a/project_workflow/interfaces/ui/static/base-ui/base-ui.css b/project_workflow/interfaces/ui/static/base-ui/base-ui.css
index f265a3f..d6e3330 100644
--- a/project_workflow/interfaces/ui/static/base-ui/base-ui.css
+++ b/project_workflow/interfaces/ui/static/base-ui/base-ui.css
@@ -251,12 +251,15 @@ dialog.base-shell-drawer::backdrop { background: rgb(0 0 0 / 65%); }
 .base-button-primary { background: var(--color-accent); color: var(--color-accent-foreground); border-color: var(--color-accent); }
 .base-button-danger { background: var(--color-danger); color: var(--color-destructive-foreground); border-color: var(--color-danger); }
 .base-button:disabled { opacity: .5; cursor: not-allowed; }
-.base-draft-dialog { box-sizing: border-box; width: min(480px, calc(100% - 32px)); max-height: calc(100dvh - 32px); padding: 20px; border: 1px solid var(--color-border); border-radius: var(--base-radius); background: var(--color-surface); color: var(--color-text-primary); overflow-y: auto; font: inherit; }
-.base-draft-dialog::backdrop { background: rgb(0 0 0 / 65%); }
-.base-draft-dialog h2 { margin: 0; font-size: 18px; line-height: 1.4; overflow-wrap: anywhere; }
-.base-draft-dialog p { margin: 12px 0; overflow-wrap: anywhere; }
-.base-draft-dialog .base-page-actions { justify-content: flex-end; }
+.base-draft-dialog, .base-confirm-dialog { box-sizing: border-box; margin: auto; width: min(480px, calc(100% - 32px)); max-height: calc(100dvh - 32px); padding: 20px; border: 1px solid var(--color-border); border-radius: var(--base-radius); background: var(--color-surface); color: var(--color-text-primary); overflow-y: auto; font: inherit; }
+.base-draft-dialog::backdrop, .base-confirm-dialog::backdrop { background: rgb(0 0 0 / 65%); }
+.base-draft-dialog h2, .base-confirm-dialog h2 { margin: 0; font-size: 18px; line-height: 1.4; overflow-wrap: anywhere; }
+.base-draft-dialog p, .base-confirm-dialog p { margin: 12px 0; overflow-wrap: anywhere; }
+.base-draft-dialog .base-page-actions, .base-confirm-dialog .base-page-actions { justify-content: flex-end; }
 .base-draft-dialog [data-base-draft-pending] { color: var(--color-text-muted); }
+.base-confirm-dialog [data-base-confirm-content] { margin: 12px 0; padding: 0; min-width: 0; border: 0; }
+.base-confirm-dialog [data-base-confirm-error] { color: var(--color-danger); }
+.base-confirm-dialog [data-base-confirm-pending] { color: var(--color-text-muted); }
 .base-resource-state { padding: 20px 0; }
 .base-ssr-shell .main { min-width: 0; min-height: calc(100dvh - var(--shell-header-height)); width: calc(100% - var(--sidebar-width)); margin-left: var(--sidebar-width); }
 .base-ssr-header { position: sticky; top: 0; z-index: 30; display: flex; min-width: 0; width: 100%; height: var(--shell-header-height); align-items: center; justify-content: space-between; gap: 8px; padding: 0 var(--shell-page-gutter); border-bottom: 1px solid var(--color-border); background: var(--color-surface); }
diff --git a/project_workflow/interfaces/ui/static/base-ui/base-ui.js b/project_workflow/interfaces/ui/static/base-ui/base-ui.js
index 8abdd6d..24ad61b 100644
--- a/project_workflow/interfaces/ui/static/base-ui/base-ui.js
+++ b/project_workflow/interfaces/ui/static/base-ui/base-ui.js
@@ -80,7 +80,7 @@
       on(dialog, 'close', () => { if (!dialog.open) finish(false); });
       on(dialog, 'click', (event) => { if (event.target === dialog) finish(false); });
       on(dialog, 'keydown', (event) => {
-        if (event.key === 'Escape') { event.preventDefault(); finish(false); return; }
+        if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); finish(false); return; }
         if (event.key !== 'Tab') return;
         const controls = discard.disabled ? [cancel] : [cancel, discard];
         if (event.shiftKey && document.activeElement === controls[0]) { event.preventDefault(); controls.at(-1).focus(); }
@@ -132,6 +132,149 @@
   };
 })();
 
+(() => {
+  const owners = new WeakMap();
+  const configurations = new WeakMap();
+  window.BaseConfirmDialog = {
+    attach({ dialog, fallbackFocus = () => document.querySelector('main[tabindex="-1"]') }) {
+      if (!(dialog instanceof HTMLDialogElement)) throw new TypeError('Base confirmation requires a native dialog');
+      if (owners.has(dialog)) throw new Error('Base confirmation already attached');
+      const find = (name) => dialog.querySelector(`[data-base-confirm-${name}]`);
+      const title = find('title');
+      const description = find('description');
+      const cancel = find('cancel');
+      const confirm = find('accept');
+      const error = find('error');
+      const pending = find('pending');
+      const content = find('content');
+      if (![title, description, cancel, confirm, error, pending, content].every(Boolean)) throw new Error('Use the Base confirm_dialog macro');
+      const defaults = configurations.get(dialog) ?? { title: title.textContent, message: description.textContent, cancelLabel: cancel.textContent, confirmLabel: confirm.textContent, error: error.textContent };
+      configurations.set(dialog, defaults);
+      const listeners = new AbortController();
+      let attempt = null;
+      let destroyed = false;
+      const busy = () => Boolean(attempt && (attempt.submitting || attempt.options.isPending()));
+      const usable = (node) => node instanceof HTMLElement && node.isConnected && !node.disabled && !node.closest('[inert]') && node.getClientRects().length;
+      const controls = () => [...dialog.querySelectorAll('button,a[href],input,select,textarea,[tabindex]')]
+        .filter((node) => usable(node) && node.tabIndex >= 0 && !node.matches(':disabled'));
+      const focusTarget = (target) => typeof target === 'function' ? target() : target;
+      function restoreFocus(current) {
+        const preferred = focusTarget(current.options.returnFocus) || current.trigger;
+        if (usable(preferred)) preferred.focus();
+        if (document.activeElement !== preferred) {
+          const fallback = focusTarget(current.options.fallbackFocus ?? fallbackFocus);
+          if (usable(fallback)) fallback.focus();
+        }
+      }
+      function finish(confirmed) {
+        if (!attempt) return;
+        const current = attempt;
+        attempt = null;
+        if (dialog.open) dialog.close();
+        restoreFocus(current);
+        current.resolve(confirmed);
+      }
+      function refresh() {
+        if (!attempt || destroyed) return;
+        const locked = busy();
+        confirm.disabled = locked || attempt.options.confirmDisabled();
+        cancel.disabled = locked;
+        content.disabled = locked;
+        pending.hidden = !locked;
+        dialog.setAttribute('aria-busy', String(locked));
+        const message = attempt.options.error() || (attempt.failed ? defaults.error : '');
+        error.textContent = message;
+        error.hidden = !message;
+        if (locked && dialog.contains(document.activeElement) && document.activeElement.matches(':disabled')) dialog.focus();
+      }
+      function close(confirmed = false) {
+        if (!attempt || busy()) { refresh(); return false; }
+        finish(confirmed);
+        return true;
+      }
+      function request(options = {}) {
+        if (destroyed || attempt) return Promise.resolve(false);
+        const callbacks = { onConfirm: () => {}, isPending: () => false, confirmDisabled: () => false, error: () => '', ...options };
+        for (const name of ['onConfirm', 'isPending', 'confirmDisabled', 'error']) {
+          if (typeof callbacks[name] !== 'function') throw new TypeError(`Base confirmation ${name} must be a callback`);
+        }
+        title.textContent = options.title ?? defaults.title;
+        description.textContent = options.message ?? defaults.message;
+        cancel.textContent = options.cancelLabel ?? defaults.cancelLabel;
+        confirm.textContent = options.confirmLabel ?? defaults.confirmLabel;
+        return new Promise((resolve, reject) => {
+          attempt = { options: callbacks, resolve, trigger: document.activeElement, submitting: false, failed: false };
+          try {
+            refresh();
+            dialog.showModal();
+            if (!cancel.disabled) cancel.focus(); else dialog.focus();
+          } catch (failure) {
+            const current = attempt;
+            attempt = null;
+            if (dialog.open) dialog.close();
+            restoreFocus(current);
+            reject(failure);
+          }
+        });
+      }
+      async function accept() {
+        if (!attempt || busy() || attempt.options.confirmDisabled()) { refresh(); return; }
+        const current = attempt;
+        current.submitting = true;
+        refresh();
+        try {
+          await current.options.onConfirm();
+          if (attempt !== current || destroyed) return;
+          current.submitting = false;
+          current.failed = false;
+          if (current.options.closeOnConfirm !== false && !current.options.isPending()) finish(true);
+          else refresh();
+        } catch (_failure) {
+          // Products own classification/reconciliation; never replay an uncertain write.
+          if (attempt !== current || destroyed) return;
+          current.submitting = false;
+          current.failed = true;
+          refresh();
+        }
+      }
+      const on = (type, callback) => dialog.addEventListener(type, callback, { signal: listeners.signal });
+      confirm.addEventListener('click', () => { void accept(); }, { signal: listeners.signal });
+      cancel.addEventListener('click', () => close(), { signal: listeners.signal });
+      on('cancel', (event) => { event.preventDefault(); close(); });
+      on('close', () => {
+        if (!attempt || dialog.open) return;
+        if (busy()) { dialog.showModal(); dialog.focus(); }
+        else finish(false);
+      });
+      on('click', (event) => {
+        if (event.target !== dialog) return;
+        const rect = dialog.getBoundingClientRect();
+        if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) close();
+      });
+      on('keydown', (event) => {
+        if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); close(); return; }
+        if (event.key !== 'Tab') return;
+        const items = controls();
+        if (!items.length) { event.preventDefault(); dialog.focus(); return; }
+        if (event.shiftKey && (document.activeElement === items[0] || !items.includes(document.activeElement))) { event.preventDefault(); items.at(-1).focus(); }
+        else if (!event.shiftKey && (document.activeElement === items.at(-1) || !items.includes(document.activeElement))) { event.preventDefault(); items[0].focus(); }
+      });
+      const controller = {
+        request, refresh, close,
+        destroy() {
+          if (destroyed) return;
+          destroyed = true;
+          listeners.abort();
+          finish(false);
+          owners.delete(dialog);
+        },
+      };
+      owners.set(dialog, controller);
+      return controller;
+    },
+  };
+})();
