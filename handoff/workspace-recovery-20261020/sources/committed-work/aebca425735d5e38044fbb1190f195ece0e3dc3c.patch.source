+
+def test_confirmation_actions_are_not_page_header_actions() -> None:
+    html = env.get_template("error.html").render(
+        title="Fixture error", message="Safe explanation", status_code=404,
+        back_url="/tasks", back_label="Задачи",
+    )
+    structure = PageStructure()
+    structure.feed(html)
+    assert len(structure.dialog_actions) == 2
+    assert_page_header(html)
+
+
+@pytest.mark.parametrize("container", ["header", "aside", "dialog"])
+def test_unowned_page_actions_still_fail_structure_gate(container: str) -> None:
+    html = (
+        '<main><div class="base-page-header"><h1>Page</h1></div></main>'
+        f'<{container}><div class="base-page-actions"></div></{container}>'
+    )
+    with pytest.raises(AssertionError):
+        assert_page_header(html)
+
+
+def test_base_dialog_does_not_allow_page_actions_in_platform_header() -> None:
+    html = (
+        '<main><div class="base-page-header"><h1>Page</h1></div></main>'
+        '<header><dialog data-base-confirm-dialog><div class="base-page-actions"></div></dialog></header>'
+    )
+    with pytest.raises(AssertionError):
+        assert_page_header(html)
 
 
 @pytest.mark.ui
