diff --git a/project_workflow/interfaces/ui/templates/confirm_deletion.js b/project_workflow/interfaces/ui/templates/confirm_deletion.js
new file mode 100644
index 0000000..4bcb453
--- /dev/null
+++ b/project_workflow/interfaces/ui/templates/confirm_deletion.js
@@ -0,0 +1,61 @@
+(() => {
+  // Product-owned API lifecycle; Base owns the modal and its interactions.
+  const attempts = new Map();
+  window.workflowCollectionContains = async (url, collection, id) => {
+    const response = await fetch(url, { cache: 'no-store' });
+    const data = await response.json();
+    const rows = data[collection];
+    if (!response.ok || data.ok !== true || !Array.isArray(rows) ||
+        !rows.every(row => row && Number.isInteger(row.id) && row.id > 0)) {
+      throw new Error('Catalogue unavailable');
+    }
+    return rows.some(row => row.id === id);
+  };
+  window.requestWorkflowDeletion = async ({ url, title, message, exists, returnFocus, fallbackFocus }) => {
+    let state = attempts.get(url) || { kind: 'ready', error: '' };
+    let pending = false;
+    const unknown = () => {
+      state = { kind: 'unknown', error: 'Результат удаления неизвестен. Повтор заблокирован до проверки.' };
+      attempts.set(url, state);
+    };
+    const confirmed = await requestConfirmation({
+      title, message, confirmLabel: 'Удалить', returnFocus, fallbackFocus,
+      isPending: () => pending,
+      confirmDisabled: () => state.kind !== 'ready',
+      error: () => state.error,
+      reconcileVisible: () => state.kind === 'unknown',
+      async onConfirm() {
+        if (state.kind !== 'ready') throw new Error('Delete unavailable');
+        pending = true;
+        state.error = '';
+        try {
+          const response = await fetch(url, { method: 'DELETE' });
+          const data = await response.json().catch(() => null);
+          if (response.ok && data && data.ok === true) return;
+          if (response.ok || response.status >= 500 || response.status === 408) unknown();
+          else {
+            state.kind = [401, 403, 404].includes(response.status) ? 'terminal' : 'ready';
+            state.error = data && typeof data.error === 'string' ? data.error : 'Удаление отклонено. Проверьте доступ и состояние объекта.';
+            attempts.set(url, state);
+          }
+        } catch (_error) { unknown(); }
+        finally { pending = false; refreshWorkflowConfirmation(); }
+        throw new Error('Delete not acknowledged');
+      },
+      async reconcile() {
+        if (pending || state.kind !== 'unknown') return;
+        pending = true;
+        refreshWorkflowConfirmation();
+        let absent = false;
+        try {
+          absent = !(await exists());
+          state.error = absent ? '' : 'Удаление пока не подтверждено. Повторная запись заблокирована.';
+        } catch (_error) { state.error = 'Не удалось проверить результат. Повторная запись заблокирована.'; }
+        finally { pending = false; refreshWorkflowConfirmation(); }
+        if (absent) workflowConfirmation.close(true);
+      },
+    });
+    if (confirmed) attempts.delete(url);
+    return confirmed;
+  };
+})();
