diff --git a/project_workflow/interfaces/ui/templates/error.html b/project_workflow/interfaces/ui/templates/error.html
index be14584..ba6b4e3 100644
--- a/project_workflow/interfaces/ui/templates/error.html
+++ b/project_workflow/interfaces/ui/templates/error.html
@@ -11,8 +11,9 @@
 {% endblock %}
 
 {% block content %}
-<section class="card error-state">
-  <div class="error-code">HTTP {{ status_code }}</div>
+{% set state_kind = 'empty' if empty_state | default(false) else 'not-found' if status_code == 404 else 'permission-denied' if status_code == 403 else 'error' %}
+<section class="card error-state" data-page-state="{{ state_kind }}" role="{{ 'alert' if state_kind == 'error' else 'status' }}">
+  {% if not empty_state | default(false) %}<div class="error-code">HTTP {{ status_code }}</div>{% endif %}
   <h1>{{ title }}</h1>
   <p>{{ message }}</p>
   <a class="btn btn-secondary" href="{{ back_url }}">← {{ back_label }}</a>
diff --git a/tests/test_docs_quality.py b/tests/test_docs_quality.py
index 47ff208..4201b19 100644
--- a/tests/test_docs_quality.py
+++ b/tests/test_docs_quality.py
@@ -68,7 +68,20 @@ def test_readme_does_not_advertise_absent_systemd_unit() -> None:
     assert "project-workflow-ui.service" not in readme
     assert "sudo systemctl" not in readme
     assert "curl --fail http://127.0.0.1:8811/health" not in readme
-    assert "curl --fail http://127.0.0.1:8812/health" in readme
+    assert "./scripts/quality.ps1 -Target compose-ready -DockerContext desktop-linux" in readme
+
+
+def test_current_startup_instructions_use_scoped_qa_and_workspace_profiles() -> None:
+    readme = (ROOT / "README.md").read_text(encoding="utf-8")
+    agents = (ROOT / "AGENTS.md").read_text(encoding="utf-8")
+
+    assert "docker compose up" not in readme
+    assert "docker compose up" not in agents
+    assert "./start-local.ps1 -Workspace sdlc1" in readme
+    assert "profile/runtime" in readme
+    assert "EXISTING_PROTECTED_SECRET" in readme
+    assert "standalone defaults" in readme
+    assert "удаляются в finally" in readme
 
 
 def test_hosted_ci_covers_quality_and_compose_readiness() -> None:
diff --git a/tests/test_runtime_cleanup.py b/tests/test_runtime_cleanup.py
index 3866329..e94df67 100644
--- a/tests/test_runtime_cleanup.py
+++ b/tests/test_runtime_cleanup.py
@@ -113,10 +113,16 @@ def test_compose_waits_for_api_readiness():
     assert "data.get('ok') is True" in api_block
 
 
-def test_repository_runbook_waits_for_compose_readiness():
+def test_repository_runbook_uses_scoped_compose_readiness():
     agents = AGENTS_PATH.read_text(encoding="utf-8")
-    assert "docker compose up --build -d --wait" in agents
-    assert "scripts/quality.ps1" in agents
+    script = QUALITY_SCRIPT_PATH.read_text(encoding="utf-8")
+    assert "./scripts/quality.ps1 -Target compose-ready -DockerContext desktop-linux" in agents
+    assert "docker compose up" not in agents
+    assert '"compose-ready" { Invoke-ComposeReady }' in script
+    assert '"--docker-context", $DockerContext' in script
+    assert "compose-ready requires an explicit -DockerContext" in script
+    assert '"--output", $ComposeOutput' in script
+    assert "qa_product_compose.py" in script
 
 
 def test_windows_quality_helper_mirrors_local_gate():
