     def test_phase_detail_missing(self):
         response = client.get("/phase/999999")
         assert response.status_code == 404
         assert "Фаза не найдена" in response.text
         assert "К фазам" in response.text
+        assert 'data-page-state="not-found"' in response.text
+        assert 'data-page-layout="wide"' in response.text
+        assert 'class="phase-editor-layout"' not in response.text
+
+    def test_instructions_without_phase_is_empty_instead_of_http_error(self):
+        response = client.get("/instructions")
+        assert response.status_code == 200
+        assert 'data-page-state="empty"' in response.text
+        assert 'data-page-layout="wide"' in response.text
+        assert "Выберите фазу" in response.text
+        assert 'class="error-code"' not in response.text
+        assert 'id="instructionsLayout"' not in response.text
+
+    def test_invalid_namespace_is_error_instead_of_normal_page(self):
+        response = client.get("/tasks?namespace_id=invalid")
+        assert response.status_code == 422
+        assert 'data-page-state="error" role="alert"' in response.text
+        assert 'data-page-layout="wide"' in response.text
+        assert 'data-task-key=' not in response.text
 
 
