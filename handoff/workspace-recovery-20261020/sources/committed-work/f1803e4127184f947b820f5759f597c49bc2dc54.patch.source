+class ApiError extends Error {
+    status;
+    code;
+    body;
+    requestId;
+    constructor(status, message, body, requestId) {
+        super(message);
+        this.status = status;
+        this.name = 'ApiError';
+        this.body = body;
+        this.requestId = requestId;
+        const errorBody = body && typeof body === 'object' ? body : undefined;
