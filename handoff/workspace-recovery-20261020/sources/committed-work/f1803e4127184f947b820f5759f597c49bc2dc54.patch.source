+            envelope && typeof envelope === 'object' && typeof envelope.code === 'string'
+                ? envelope.code
+                : typeof errorBody?.error_code === 'string' ? errorBody.error_code : undefined;
+    }
+}
+exports.ApiError = ApiError;
+class InvalidResponseError extends ApiError {
+    constructor(status, requestId) {
+        super(status, 'invalid JSON response', undefined, requestId);
+        this.name = 'InvalidResponseError';
+    }
+}
+exports.InvalidResponseError = InvalidResponseError;
+function apiErrorFromResponse(res, data) {
+    const body = data && typeof data === 'object' ? data : undefined;
+    const envelope = body?.error;
+    const message = typeof envelope === 'string' ? envelope
+        : envelope && typeof envelope.message === 'string' ? envelope.message
+            : typeof body?.message === 'string' ? body.message : `request failed: ${res.status}`;
+    const bodyId = envelope && typeof envelope === 'object'
+        ? typeof envelope.request_id === 'string' ? envelope.request_id
+            : typeof envelope.requestId === 'string' ? envelope.requestId : undefined
+        : undefined;
+    return new ApiError(res.status, message, data, res.headers.get('x-request-id') ?? bodyId);
+}
+function createApiClient(options = {}) {
+    const baseUrl = (options.baseUrl ?? '').replace(/\/+$/, '');
+    async function transport(path, init = {}, retried = false) {
+        if (options.refresh && typeof ReadableStream !== 'undefined' && init.body instanceof ReadableStream) {
+            throw new TypeError('Streaming request bodies cannot be replayed after authentication refresh');
+        }
+        const headers = new Headers(init.headers);
+        const token = options.getAccessToken?.();
+        if (token && !headers.has('Authorization'))
+            headers.set('Authorization', `Bearer ${token}`);
+        const res = await fetch(`${baseUrl}${path}`, {
+            credentials: 'include',
+            ...init,
+            headers,
+        });
+        if (res.status === 401 && !retried && options.refresh) {
+            const refreshed = await options.refresh();
+            if (refreshed)
+                return transport(path, init, true);
+        }
+        if (res.status === 401)
+            options.onUnauthorized?.();
+        return res;
+    }
+    async function raw(path, init = {}) {
+        return transport(path, {
+            method: init.method ?? 'GET',
+            signal: init.signal,
+            headers: init.body !== undefined ? { 'Content-Type': 'application/json' } : undefined,
+            body: init.body !== undefined ? JSON.stringify(init.body) : undefined,
+        }, init._retried);
+    }
+    async function json(res) {
+        if (res.status === 204)
+            return undefined;
+        const text = await res.text();
+        const data = text ? safeJson(text) : undefined;
+        if (!res.ok) {
+            throw apiErrorFromResponse(res, data);
+        }
+        if (!text || data === undefined) {
+            throw new InvalidResponseError(res.status, res.headers.get('x-request-id') ?? undefined);
+        }
+        return data;
+    }
+    function safeJson(text) {
+        try {
+            return JSON.parse(text);
+        }
+        catch {
+            return undefined;
+        }
+    }
+    return {
+        request: async (path, init) => {
+            const response = await transport(path, init);
+            if (init?.method?.toUpperCase() === 'HEAD' && response.ok)
+                return undefined;
+            return json(response);
+        },
+        get: async (path, signal) => json(await raw(path, { signal })),
+        post: async (path, body, signal) => json(await raw(path, { method: 'POST', body, signal })),
+        put: async (path, body, signal) => json(await raw(path, { method: 'PUT', body, signal })),
+        patch: async (path, body, signal) => json(await raw(path, { method: 'PATCH', body, signal })),
+        delete: async (path, signal) => json(await raw(path, { method: 'DELETE', signal })),
+        raw,
+    };
+}
+
