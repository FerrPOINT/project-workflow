diff --git a/tests/test_build_provenance.py b/tests/test_build_provenance.py
index 510fd47..7b9f758 100644
--- a/tests/test_build_provenance.py
+++ b/tests/test_build_provenance.py
@@ -583,6 +583,69 @@ def test_compatible_image_delivers_descriptor_to_docker(compatible_sources):
     assert "COPY --from=builder /app/runtime-compatibility.json /app/runtime-compatibility.json" in dockerfile
 
 
+def test_compose_context_export_is_stdlib_only_and_has_exact_provenance(compatible_sources, tmp_path):
+    source, skills, manifest, catalog = compatible_sources
+    builder = _builder_module()
+    snapshot = builder.immutable_git_snapshot(source, "HEAD")
+    output = tmp_path / "compose-context.tar.gz"
+    result = subprocess.run(
+        [sys.executable, "-S", "-m", "scripts.build_runtime_image", "export-context",
+         "--root", str(source), "--revision", snapshot.revision,
+         "--skills-root", str(skills), "--output", str(output)],
+        cwd=source, capture_output=True, text=True,
+    )
+    assert result.returncode == 0, result.stderr
+    assert json.loads(result.stdout) == snapshot.provenance.to_dict()
+    context = output.read_bytes()
+    assert json.loads(_member_bytes(context, "runtime-build-manifest.json")) == snapshot.provenance.to_dict()
+    assert _member_bytes(context, builder.SKILLS_MANIFEST_PATH) == _run_git(
+        skills, "show", f"{catalog['skills_source']['revision']}:{catalog['skills_source']['manifest_path']}"
+    ).stdout
+    assert runtime_bundle_sha256_from_archive(context) == snapshot.provenance.runtime_bundle_sha256
+    manifest.write_text("dirty native worktree", encoding="utf-8")
+    second = tmp_path / "same-inputs.tar.gz"
+    builder.export_context(source, snapshot.revision, skills, second)
+    assert second.read_bytes() == context
+
+
+def test_context_export_preserves_existing_destination_before_git_lookup(tmp_path):
+    builder = _builder_module()
+    output = tmp_path / "preserved.tar.gz"
+    output.write_bytes(b"existing artifact")
+    with patch.object(builder, "immutable_git_snapshot") as snapshot:
+        with pytest.raises(BuildProvenanceError, match="already exists"):
+            builder.export_context(tmp_path, "HEAD", tmp_path, output)
+        snapshot.assert_not_called()
+    assert output.read_bytes() == b"existing artifact"
+
+
+def test_context_export_missing_native_pin_allocates_no_output(compatible_sources, tmp_path):
+    source, _, _, _ = compatible_sources
+    unrelated = tmp_path / "unrelated-git"
+    unrelated.mkdir()
+    _run_git(unrelated, "init")
+    output = tmp_path / "must-not-exist.tar.gz"
+    with pytest.raises(subprocess.CalledProcessError):
+        _builder_module().export_context(source, "HEAD", unrelated, output)
+    assert not output.exists()
+
+
+def test_prepare_compatibility_generates_only_the_unavailable_marker(tmp_path):
+    builder = _builder_module()
+    path = tmp_path / builder.COMPATIBILITY_PATH
+    expected = {"catalogRevision": "a" * 40}
+    path.write_text('{"status":"unavailable"}', encoding="utf-8")
+    with patch.object(builder, "derive_compatibility", return_value=expected):
+        builder.prepare_compatibility(tmp_path)
+    assert json.loads(path.read_bytes()) == expected
+    path.write_text('{"catalogRevision":"forged"}', encoding="utf-8")
+    before = path.read_bytes()
+    with patch.object(builder, "derive_compatibility", return_value=expected):
+        with pytest.raises(BuildProvenanceError, match="immutable source inputs"):
+            builder.prepare_compatibility(tmp_path)
+    assert path.read_bytes() == before
+
+
