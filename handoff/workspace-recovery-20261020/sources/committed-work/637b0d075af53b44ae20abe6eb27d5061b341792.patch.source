+    export.add_argument("--revision", required=True)
+    export.add_argument("--skills-root", type=Path, required=True)
+    export.add_argument("--output", type=Path, required=True)
+
+    for name in ("derive-compatibility", "verify-compatibility", "prepare-compatibility"):
         subparsers.add_parser(name).add_argument("--root", type=Path, required=True)
 
     verify = subparsers.add_parser("verify-manifest")
