+++ b/scripts/build_runtime_image.py
@@ -103,6 +103,15 @@ def verify_compatibility(root: Path) -> None:
         raise BuildProvenanceError("Runtime compatibility differs from immutable source inputs")
 
 
+def prepare_compatibility(root: Path) -> None:
+    """Generate only the committed unavailable marker; verify every supplied descriptor."""
+    path = root / COMPATIBILITY_PATH
+    if json.loads(path.read_bytes()) == {"status": "unavailable"}:
+        path.write_bytes(_json_bytes(derive_compatibility(root)))
+    else:
+        verify_compatibility(root)
+
+
