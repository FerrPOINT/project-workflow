     with tempfile.TemporaryDirectory(prefix="workflow-compatibility-") as directory:
@@ -167,6 +181,17 @@ def compatible_build_context(snapshot: GitSourceSnapshot, skills_root: Path) ->
     return _add_context_files(context, {COMPATIBILITY_PATH: descriptor})
 
 
+def export_context(root: Path, revision: str, skills_root: Path, output: Path) -> BuildProvenance:
+    """Write one immutable transport for Compose; existing artifacts are never replaced."""
+    if output.exists() or output.is_symlink():
+        raise BuildProvenanceError("Context destination already exists")
+    snapshot = immutable_git_snapshot(root, revision)
+    context = pinned_build_context(snapshot, skills_root)
+    with output.open("xb") as stream:
+        stream.write(gzip.compress(context, mtime=0))
+    return snapshot.provenance
+
+
 def build_image(root: Path, image: str, docker: str, revision: str = "HEAD",
                 *, skills_root: Path) -> None:
     snapshot = immutable_git_snapshot(root, revision)
