     await page.locator('#namespaceSelector').focus()
@@ -67,6 +72,40 @@ for (const theme of ['dark', 'gray', 'light']) {
   })
 }
 
+for (const theme of ['dark', 'gray', 'light']) {
+  for (const create of [false, true]) {
+    test(`namespace Base form composition and product identity (${theme}, ${create ? 'create' : 'edit'})`, async ({ page }) => {
+      await page.addInitScript(value => {
+        localStorage.setItem('theme', value)
+        localStorage.setItem('workflow-theme', value)
+      }, theme)
+      await openEditor(page, create)
+      await expect(page.locator('.brand-name')).toHaveText('Workflow')
+      await expect(page.locator('.brand-subname')).toHaveCount(0)
+      const form = page.locator('#namespaceForm')
+      await expect(form).toHaveClass('base-page-stack')
+      await expect(page.locator('#namespaceFormMode')).toBeHidden()
+      await expect(page.locator('h1')).toHaveCount(1)
+      for (const id of ['namespaceName', 'namespaceCliCommand', 'namespaceDescription', 'namespaceThemeIcon', 'namespaceThemeColor', 'namespaceWorkflowId']) {
+        const field = form.locator('.base-form-field').filter({ has: page.locator(`#${id}`) })
+        await expect(field.locator('label')).toHaveAttribute('for', id)
+        const style = await field.locator('label').evaluate(node => {
+          const css = getComputedStyle(node)
+          return { size: css.fontSize, transform: css.textTransform }
+        })
+        expect(style).toEqual({ size: '12px', transform: 'none' })
+      }
+      expect(await page.locator('#namespaceThemeColor').evaluate(node => node.getBoundingClientRect().height)).toBeGreaterThanOrEqual(test.info().project.name.includes('mobile') ? 44 : 40)
+      await expect(page.locator('#namespaceCliCommand')).toHaveAttribute('aria-describedby', 'namespaceCliCommand-hint')
+      await expect(form).toHaveAccessibleName(create ? 'Новый неймспейс' : 'Редактирование неймспейса')
+      await page.screenshot({ path: test.info().outputPath(`namespace-composition-${theme}-${create ? 'create' : 'edit'}.png`), fullPage: true })
+      await page.reload()
+      await expect(page.locator('.brand-name')).toHaveText('Workflow')
+      await expect(form).toHaveAccessibleName(create ? 'Новый неймспейс' : 'Редактирование неймспейса')
+    })
+  }
+}
+
 test('accepted global context transition has no second native prompt', async ({ page }) => {
   await openEditor(page)
   await page.locator('#namespaceName').fill('Unsaved context')
@@ -77,6 +116,7 @@ test('accepted global context transition has no second native prompt', async ({
   await discard(page).click()
   await expect(page).toHaveURL(new RegExp(`namespace_id=${qa.id}`))
   await expect(page.locator('#namespaceName')).toHaveValue(qa.name)
+  await expect(page.locator('.brand-name')).toHaveText('Workflow')
   expect(nativeDialogs).toEqual([])
 })
 
