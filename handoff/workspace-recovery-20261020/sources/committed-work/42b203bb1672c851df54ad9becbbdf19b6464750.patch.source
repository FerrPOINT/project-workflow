 .theme-grid{display:grid;grid-template-columns:minmax(0,1fr) 120px;gap:12px}
-.theme-color-input{height:34px;padding:2px;cursor:pointer}
 .theme-preview{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--border);border-radius:8px;background:var(--panel)}
 .theme-preview .namespace-mark{width:30px;height:30px}
 .theme-preview-name{font-weight:600;color:var(--text)}
-.panel-actions{display:flex;gap:10px;flex-wrap:wrap}
 .namespace-delete{margin-left:auto;color:var(--text);border-color:var(--red)}
 .namespace-delete:hover{color:var(--text);background:var(--red-soft)}
 .empty-note{color:var(--text-dim);font-size:13px;line-height:1.6}
