         assert 'class="instruction-text" rows="1"' in response.text
diff --git a/tests/test_ui_page_header.py b/tests/test_ui_page_header.py
new file mode 100644
index 0000000..2b7b28a
--- /dev/null
+++ b/tests/test_ui_page_header.py
@@ -0,0 +1,95 @@
+from __future__ import annotations
+
+from html.parser import HTMLParser
+
+import pytest
+from fastapi.testclient import TestClient
+
+from project_workflow.interfaces.ui.app import create_app
+from project_workflow.interfaces.ui.templates import env
+
+
+class PageStructure(HTMLParser):
+    def __init__(self) -> None:
+        super().__init__()
+        self.stack: list[tuple[str, dict[str, str | None]]] = []
+        self.headings: list[list[tuple[str, dict[str, str | None]]]] = []
+        self.page_actions: list[list[tuple[str, dict[str, str | None]]]] = []
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        attributes = dict(attrs)
+        if tag == "h1":
+            self.headings.append([*self.stack, (tag, attributes)])
+        if "base-page-actions" in (attributes.get("class") or "").split():
+            self.page_actions.append([*self.stack, (tag, attributes)])
+        if tag not in {
+            "area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source",
+            "track", "wbr",
+        }:
+            self.stack.append((tag, attributes))
+
+    def handle_endtag(self, tag: str) -> None:
+        for index in range(len(self.stack) - 1, -1, -1):
+            if self.stack[index][0] == tag:
+                del self.stack[index:]
+                break
+
+
+def assert_page_header(html: str) -> None:
+    structure = PageStructure()
+    structure.feed(html)
+    assert len(structure.headings) == 1
+    ancestry = structure.headings[0]
+    assert any(tag == "main" for tag, _ in ancestry)
+    assert any("base-page-header" in (attrs.get("class") or "").split() for _, attrs in ancestry)
+    assert not any(tag == "header" for tag, _ in ancestry)
+    for action in structure.page_actions:
+        assert any(tag == "main" for tag, _ in action)
+        assert not any(tag == "header" for tag, _ in action)
+
+
+@pytest.mark.ui
+@pytest.mark.parametrize("route", [
+    "/", "/tasks", "/phases", "/workflows", "/namespaces", "/namespaces/new", "/agents", "/settings",
+    "/phase/{id}", "/instructions?phase_id={id}", "/unknown-page",
+])
+def test_operational_pages_own_one_base_page_header(route: str) -> None:
+    with TestClient(create_app()) as client:
+        if "{id}" in route:
+            namespace = client.get("/api/namespaces").json()["namespaces"][0]
+            phases = client.get(f"/api/phases?namespace_id={namespace['id']}").json()["phases"]
+            route = route.format(id=phases[0]["id"])
+            route += ("&" if "?" in route else "?") + f"namespace_id={namespace['id']}"
+        response = client.get(route)
+    assert response.status_code == (404 if route == "/unknown-page" else 200)
+    assert_page_header(response.text)
+    assert "mobileNewWorkflowButton" not in response.text
+    assert 'class="task-detail-mobile-actions"' not in response.text
+
+
+def test_task_detail_uses_shared_page_title_and_context() -> None:
+    html = env.get_template("task_detail.html").render(
+        page="tasks",
+        task={"task_key": "QA-42", "title": "Task context", "namespace_id": 7, "status": "active"},
+        phase_history_blocks=[],
+        step_history=[],
+        progress_done=0,
+        progress_total=0,
+        cycles_done=0,
+        cycles_total=0,
+    )
+    assert_page_header(html)
+    assert '<h1 class="base-page-title">QA-42</h1>' in html
+    assert "Task context" in html
+    assert html.count('href="/tasks?namespace_id=7" class="btn') == 1
+
+
+@pytest.mark.parametrize(("status", "kind"), [(403, "permission-denied"), (404, "not-found"), (503, "error")])
+def test_error_template_uses_shared_state_without_retry_for_navigation(status: int, kind: str) -> None:
+    html = env.get_template("error.html").render(
+        title="Fixture error", message="Safe explanation", status_code=status,
+        back_url="/tasks", back_label="Задачи",
+    )
+    assert_page_header(html)
+    assert f'data-page-state="{kind}"' in html
+    assert html.count('href="/tasks" class="btn') == 1
