diff --git a/frontend/e2e/phase-instruction-lifecycle.spec.ts b/frontend/e2e/phase-instruction-lifecycle.spec.ts
new file mode 100644
index 0000000..14b788d
--- /dev/null
+++ b/frontend/e2e/phase-instruction-lifecycle.spec.ts
@@ -0,0 +1,336 @@
+import { expect, test } from '@playwright/test'
+
+if (process.env.WORKFLOW_UI_QA_MUTATIONS !== 'isolated-fixture') throw new Error('Phase instruction QA requires an isolated fixture')
+
+let workflowId: number
+let namespaceId: number
+let phaseId: number
+let instructionIds: number[]
+const pageUrl = () => `/phase/${phaseId}?namespace_id=${namespaceId}&foreign=keep`
+
+test.beforeEach(async ({ request }) => {
+  workflowId = 0
+  namespaceId = 0
+  instructionIds = []
+  const created = await request.post('/api/workflows', { data: { name: `Instruction lifecycle ${crypto.randomUUID()}` } })
+  expect(created.ok()).toBeTruthy()
+  workflowId = (await created.json()).workflow_id as number
+  const namespace = await request.post('/api/namespaces', { data: { name: `Instruction QA ${crypto.randomUUID()}`, cli_command: `instruction-${crypto.randomUUID()}`, workflow_id: workflowId } })
+  expect(namespace.ok()).toBeTruthy()
+  namespaceId = (await namespace.json()).namespace_id as number
+  const phases = await request.get(`/api/phases?workflow_id=${workflowId}`)
+  expect(phases.ok()).toBeTruthy()
+  phaseId = (await phases.json()).phases[0].id as number
+  for (const step of [1, 2]) {
+    const response = await request.post(`/api/instructions?namespace_id=${namespaceId}`, { data: { phase_id: phaseId, description: `Instruction ${step}`, step_num: step } })
+    expect(response.ok()).toBeTruthy()
+    instructionIds.push((await response.json()).instruction.id as number)
+  }
+})
+
+test.afterEach(async ({ request }) => {
+  if (namespaceId) expect((await request.delete(`/api/namespaces/${namespaceId}`)).ok()).toBeTruthy()
+  if (workflowId) expect((await request.delete(`/api/workflows/${workflowId}`)).ok()).toBeTruthy()
+})
+
+test('phase instruction lifecycle lost reorder never invents rollback or releases writes', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  let writes = 0
+  let unavailable = true
+  await page.route(`**/api/phases/${phaseId}/instructions**`, async route => {
+    if (route.request().method() === 'PUT') {
+      writes++
+      const response = await route.fetch()
+      expect(response.ok()).toBeTruthy()
+      return route.fulfill({ status: 500, json: { ok: false, error: 'Lost acknowledgement after actual commit' } })
+    }
+    if (unavailable) return route.fulfill({ status: 503, json: { ok: false, error: 'Readback unavailable' } })
+    await route.continue()
+  })
+  await page.locator('.move-down-btn').first().click()
+  await expect.poll(() => writes).toBe(1)
+  await expect.poll(async () => (await (await request.get(`/api/phases/${phaseId}/instructions`)).json()).instructions.map((row: { id: number }) => row.id)).toEqual([...instructionIds].reverse())
+  await expect(page.locator('.timeline-name-input').first()).toHaveValue('Instruction 2')
+  await expect(page.locator('.wiki-header [data-field="name"]')).toBeDisabled()
+  await expect(page.locator('#phaseSaveReconcile')).toBeVisible()
+  await expect(page.locator('#phaseSaveReconcile')).toBeFocused()
+  unavailable = false
+  await page.locator('#phaseSaveReconcile').click()
+  await expect(page.locator('.wiki-header [data-field="name"]')).toBeEnabled()
+  await expect(page.locator('.timeline-name-input').first()).toHaveValue('Instruction 2')
+  await expect(page.locator('.move-up-btn').first()).toBeDisabled()
+  expect(writes).toBe(1)
+})
+
+test('phase instruction lifecycle missing create ID remains unknown after readback without replay', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  let writes = 0
+  await page.route('**/api/instructions*', async route => {
+    if (route.request().method() !== 'POST') return route.continue()
+    writes++
+    const response = await route.fetch()
+    expect(response.ok()).toBeTruthy()
+    await route.fulfill({ response, json: { ok: true } })
+  })
+  await page.getByRole('button', { name: '+ Добавить шаг', exact: true }).click()
+  await expect.poll(async () => (await (await request.get(`/api/phases/${phaseId}/instructions`)).json()).instructions.length).toBe(3)
+  await expect(page.locator('.wiki-header [data-field="name"]')).toBeDisabled()
+  await expect(page.locator('#phaseSaveReconcile')).toBeVisible()
+  await page.locator('#phaseSaveReconcile').click()
+  await expect(page.locator('.wiki-header [data-field="name"]')).toBeDisabled()
+  await expect(page.locator('#phaseSaveReconcile')).toBeVisible()
+  await page.evaluate(() => (window as unknown as { addInstructionLast: () => Promise<void> }).addInstructionLast())
+  expect(writes).toBe(1)
+  expect(new URL(page.url()).searchParams.get('foreign')).toBe('keep')
+})
+
+for (const status of [409, 422]) {
+  test(`phase instruction lifecycle known reorder rejection restores order (${status})`, async ({ page, request }) => {
+    await page.goto(pageUrl())
+    let writes = 0
+    await page.route(`**/api/phases/${phaseId}/instructions/reorder*`, async route => {
+      writes++
+      await route.fulfill({ status, json: { ok: false } })
+    })
+    await page.locator('.move-down-btn').first().click()
+    await expect(page.locator('.timeline-name-input').first()).toHaveValue('Instruction 1')
+    await expect(page.locator('.wiki-header [data-field="name"]')).toBeEnabled()
+    await expect(page.locator('#phaseSaveStatus')).toHaveAttribute('data-page-state', 'error')
+    expect(writes).toBe(1)
+    expect((await (await request.get(`/api/phases/${phaseId}/instructions`)).json()).instructions.map((row: {id: number}) => row.id)).toEqual(instructionIds)
+  })
+}
+
+for (const status of [401, 403, 404]) {
+  test(`phase instruction lifecycle terminal instruction write disables actions (${status})`, async ({ page }) => {
+    await page.goto(pageUrl())
+    let writes = 0
+    await page.route(`**/api/instructions/${instructionIds[0]}*`, async route => {
+      writes++
+      await route.fulfill({ status, json: { ok: false } })
+    })
+    const input = page.locator('.timeline-name-input').first()
+    await input.fill('Retained terminal draft')
+    await page.evaluate(() => (window as unknown as { saveInstructionDescription: (input: Element) => Promise<void> }).saveInstructionDescription(document.querySelector('.timeline-name-input')!))
+    await expect(input).toHaveValue('Retained terminal draft')
+    await expect(input).toBeDisabled()
+    await expect(page.locator('#phaseSaveStatus')).toHaveAttribute('data-page-state', status === 404 ? 'not-found' : 'permission-denied')
+    await expect(page.locator('#phaseSaveReconcile')).toBeHidden()
+    expect(writes).toBe(1)
+  })
+}
+
+for (const invalid of ['id', 'workflow', 'mode', 'instruction', 'duplicate', 'steps']) {
+  test(`phase instruction lifecycle rejects foreign or malformed readback (${invalid})`, async ({ page }) => {
+    await page.goto(pageUrl())
+    let writes = 0
+    await page.route(`**/api/instructions/${instructionIds[0]}*`, async route => {
+      if (route.request().method() === 'PUT') writes++
+      await route.continue()
+    })
+    await page.route(`**/api/phases/${phaseId}/instructions?*`, async route => {
+      const response = await route.fetch()
+      const data = await response.json()
+      if (invalid === 'id') data.phase.id = -1
+      if (invalid === 'workflow') data.phase.workflow_id = -1
+      if (invalid === 'mode') data.phase.mode_id = -1
+      if (invalid === 'instruction') data.instructions[0].phase_id = -1
+      if (invalid === 'duplicate') data.instructions[1].id = data.instructions[0].id
+      if (invalid === 'steps') data.instructions[0].step_num = 2
+      await route.fulfill({ response, json: data })
+    })
+    await page.locator('.timeline-name-input').first().fill('Validated attempt')
+    await page.evaluate(() => (window as unknown as { saveInstructionDescription: (input: Element) => Promise<void> }).saveInstructionDescription(document.querySelector('.timeline-name-input')!))
+    await expect(page.locator('#phaseSaveStatus')).toHaveAttribute('data-page-state', 'partial-error')
+    await expect(page.locator('.timeline-name-input').first()).toBeDisabled()
+    await page.unroute(`**/api/phases/${phaseId}/instructions?*`)
+    await page.locator('#phaseSaveReconcile').click()
+    await expect(page.locator('.timeline-name-input').first()).toBeEnabled()
+    await expect(page.locator('.timeline-name-input').first()).toHaveAttribute('data-original-description', 'Validated attempt')
+    expect(writes).toBe(1)
+  })
+}
+
+test('phase instruction lifecycle unknown skill response keeps input and never replays PUT', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  let writes = 0
+  await page.route(`**/api/instructions/${instructionIds[0]}*`, async route => {
+    writes++
+    await route.fulfill({ status: 200, json: { ok: true } })
+  })
+  const input = page.locator('.skill-candidate').first()
+  await input.fill('retained-skill')
+  await page.evaluate(() => (window as unknown as { addSkillToInstruction: (input: Element) => Promise<void> }).addSkillToInstruction(document.querySelector('.skill-candidate')!))
+  await expect(input).toHaveValue('retained-skill')
+  await expect(input).toBeDisabled()
+  await page.locator('#phaseSaveReconcile').click()
+  await expect(input).toHaveValue('retained-skill')
+  expect(writes).toBe(1)
+  expect((await (await request.get(`/api/phases/${phaseId}/instructions`)).json()).instructions[0].skills).toEqual([])
+})
+
+test('phase instruction lifecycle unknown type result is recovered by GET only', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  let writes = 0
+  let unavailable = true
+  await page.route(`**/api/instructions/${instructionIds[0]}*`, async route => {
+    writes++
+    await route.fetch()
+    await route.fulfill({ status: 408, json: { ok: false } })
+  })
+  await page.route(`**/api/phases/${phaseId}/instructions?*`, async route => {
+    if (unavailable) return route.fulfill({ status: 503, json: { ok: false } })
+    await route.continue()
+  })
+  await page.locator('.timeline-card .execution-row button').first().click()
+  await expect(page.locator('#phaseSaveStatus')).toHaveAttribute('data-page-state', 'partial-error')
+  await expect(page.locator('.timeline-item').first()).toHaveAttribute('data-type', 'sync')
+  expect((await (await request.get(`/api/phases/${phaseId}/instructions`)).json()).instructions[0].execution_type).toBe('parallel')
+  unavailable = false
+  await page.locator('#phaseSaveReconcile').click()
+  await expect(page.locator('.timeline-item').first()).toHaveAttribute('data-type', 'parallel')
+  await expect(page.locator('.wiki-header [data-field="name"]')).toBeEnabled()
+  expect(writes).toBe(1)
+})
+
+test('phase instruction lifecycle known create ID waits for GET without page reload', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  await page.evaluate(() => { (window as unknown as { phaseSentinel: string }).phaseSentinel = 'same-document' })
+  let writes = 0
+  let unavailable = true
+  await page.route('**/api/instructions*', async route => {
+    if (route.request().method() === 'POST') writes++
+    await route.continue()
+  })
+  await page.route(`**/api/phases/${phaseId}/instructions?*`, async route => {
+    if (unavailable) return route.fulfill({ status: 503, json: { ok: false } })
+    await route.continue()
+  })
+  await page.getByRole('button', { name: 'Добавить инструкцию после 1', exact: true }).click()
+  await expect(page.locator('#phaseSaveStatus')).toHaveAttribute('data-page-state', 'partial-error')
+  await expect(page.locator('.timeline-item')).toHaveCount(2)
+  unavailable = false
+  await page.locator('#phaseSaveReconcile').click()
+  await expect(page.locator('.timeline-item')).toHaveCount(3)
+  const rows = (await (await request.get(`/api/phases/${phaseId}/instructions`)).json()).instructions
+  await expect(page.locator('.timeline-item').nth(1)).toHaveAttribute('data-instruction-id', String(rows[1].id))
+  await expect(page.locator('.timeline-name-input').nth(1)).toBeFocused()
+  expect(await page.evaluate(() => (window as unknown as { phaseSentinel: string }).phaseSentinel)).toBe('same-document')
+  expect(writes).toBe(1)
+})
+
+test('phase instruction lifecycle lost DELETE stays locked after cancel and read-only reopen', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  let writes = 0
+  await page.route(`**/api/instructions/${instructionIds[0]}*`, async route => {
+    if (route.request().method() !== 'DELETE') return route.continue()
+    writes++
+    await route.fetch()
+    await route.fulfill({ status: 500, json: { ok: false } })
+  })
+  const dialog = page.locator('[data-base-confirm-dialog]')
+  await page.locator('.phase-delete-btn').first().click()
+  await dialog.getByRole('button', { name: 'Удалить', exact: true }).click()
+  await expect(dialog.locator('#confirmReconcile')).toBeVisible()
+  await page.keyboard.press('Escape')
+  await expect(dialog).toBeHidden()
+  await expect(page.locator('.wiki-header [data-field="name"]')).toBeDisabled()
+  await expect(page.locator('.phase-delete-btn').first()).toBeEnabled()
+  await expect(page.locator('.phase-delete-btn').nth(1)).toBeDisabled()
+  await page.locator('.phase-delete-btn').first().click()
+  await expect(dialog.getByRole('button', { name: 'Удалить', exact: true })).toBeDisabled()
+  await dialog.locator('#confirmReconcile').click()
+  await expect(dialog).toBeHidden()
+  await expect(page.locator('.timeline-item')).toHaveCount(1)
+  await expect(page.locator('.wiki-header [data-field="name"]')).toBeEnabled()
+  await expect(page.locator('#phase-instructions')).toBeFocused()
+  expect(writes).toBe(1)
+  expect((await (await request.get(`/api/phases/${phaseId}/instructions`)).json()).instructions.map((row: {id: number}) => row.id)).toEqual([instructionIds[1]])
+})
+
+test('phase instruction lifecycle deferred metadata waits until unknown order is confirmed', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  let phaseWrites = 0
+  let unavailable = true
+  let instructionWrites = 0
+  await page.route(`**/api/phases/${phaseId}/instructions**`, async route => {
+    if (route.request().method() === 'PUT') {
+      instructionWrites++
+      await route.fetch()
+      return route.fulfill({ status: 500, json: { ok: false } })
+    }
+    if (unavailable) return route.fulfill({ status: 503, json: { ok: false } })
+    await route.continue()
+  })
+  await page.route(`**/api/phases/${phaseId}?*`, async route => {
+    if (route.request().method() === 'PUT') phaseWrites++
+    await route.continue()
+  })
+  await page.evaluate(() => {
+    document.querySelector<HTMLInputElement>('.wiki-header [data-field="name"]')!.value = 'Deferred through unknown'
+    const controller = window as unknown as { scheduleSave: () => void, moveInstruction: (button: Element, direction: number) => Promise<void> }
+    controller.scheduleSave()
+    return controller.moveInstruction(document.querySelector('.move-down-btn')!, 1)
+  })
+  await page.waitForTimeout(750)
+  expect(phaseWrites).toBe(0)
+  await expect(page.locator('.wiki-header [data-field="name"]')).toHaveValue('Deferred through unknown')
+  unavailable = false
+  await page.locator('#phaseSaveReconcile').click()
+  await expect.poll(() => phaseWrites).toBe(1)
+  await expect(page.locator('.wiki-header [data-field="name"]')).toBeEnabled()
+  expect((await (await request.get(`/api/phases/${phaseId}`)).json()).phase.name).toBe('Deferred through unknown')
+  expect(instructionWrites).toBe(1)
+})
+
+for (const theme of ['dark', 'gray', 'light']) {
+  test(`phase instruction lifecycle native controls, keyboard and geometry (${theme})`, async ({ page, request }, testInfo) => {
+    await page.setViewportSize({ width: testInfo.project.name === 'mobile' ? 375 : 1920, height: 1080 })
+    await page.addInitScript(value => localStorage.setItem('workflow-theme', value), theme)
+    const errors: string[] = []
+    page.on('pageerror', error => errors.push(error.message))
+    page.on('response', response => { if (response.status() >= 400) errors.push(`${response.status()} ${new URL(response.url()).pathname}`) })
+    await page.goto(pageUrl())
+    await page.evaluate(() => { (window as unknown as { phaseSentinel: string }).phaseSentinel = 'same-document' })
+    const target = testInfo.project.name === 'mobile' ? 44 : 40
+    for (const control of [page.locator('.move-down-btn').first(), page.locator('.phase-add-btn').first(), page.locator('.phase-delete-btn').first(), page.locator('.skill-candidate').first()]) {
+      const bounds = (await control.boundingBox())!
+      expect(bounds.width).toBeGreaterThanOrEqual(target)
+      expect(bounds.height).toBeGreaterThanOrEqual(target)
+    }
+    const description = page.locator('.timeline-name-input').first()
+    const longDescription = 'Readable instruction with a long value '.repeat(12)
+    await description.fill(longDescription)
+    await description.press('Tab')
+    await expect(description).toHaveAttribute('data-original-description', longDescription.trim())
+    const input = page.locator('.skill-candidate').first()
+    await input.fill('long-safe-skill-' + 'value'.repeat(12))
+    await input.press('Tab')
+    await expect(input).toHaveValue('')
+    await expect(page.locator('.skill-remove-btn')).toHaveCount(1)
+    await page.locator('.timeline-card .execution-row button').first().click()
+    await expect(page.locator('.timeline-item').first()).toHaveAttribute('data-type', 'parallel')
+    await page.locator('.move-down-btn').first().click()
+    await expect(page.locator('.timeline-name-input').nth(1)).toHaveAttribute('data-original-description', longDescription.trim())
+    await page.locator('.skill-remove-btn').click()
+    await expect(page.locator('.skill-remove-btn')).toHaveCount(0)
+    await page.getByRole('button', { name: 'Добавить инструкцию после 1', exact: true }).click()
+    await expect(page.locator('.timeline-item')).toHaveCount(3)
+    await expect(page.locator('.timeline-name-input').nth(1)).toBeFocused()
+    await page.locator('.phase-delete-btn').nth(1).click()
+    const dialog = page.locator('[data-base-confirm-dialog]')
+    await expect(dialog.locator('[data-base-confirm-cancel]')).toBeFocused()
+    await page.keyboard.press('Escape')
+    await expect(page.locator('.phase-delete-btn').nth(1)).toBeFocused()
+    await page.locator('.phase-delete-btn').nth(1).click()
+    await dialog.getByRole('button', { name: 'Удалить', exact: true }).click()
+    await expect(page.locator('.timeline-item')).toHaveCount(2)
+    await expect(page.locator('#phase-instructions')).toBeFocused()
+    expect(await page.evaluate(() => (window as unknown as { phaseSentinel: string }).phaseSentinel)).toBe('same-document')
+    expect((await (await request.get(`/api/phases/${phaseId}/instructions`)).json()).instructions.map((row: {id: number}) => row.id)).toEqual([...instructionIds].reverse())
+    await expect(page.locator('#phaseSaveStatus')).toBeHidden()
+    expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBeTruthy()
+    expect(errors).toEqual([])
+    await page.screenshot({ path: testInfo.outputPath(`phase-instructions-${theme}.png`), fullPage: true })
+  })
+}
diff --git a/project_workflow/interfaces/ui/templates/phase_detail.html b/project_workflow/interfaces/ui/templates/phase_detail.html
index 3255bbb..447bd94 100644
--- a/project_workflow/interfaces/ui/templates/phase_detail.html
+++ b/project_workflow/interfaces/ui/templates/phase_detail.html
@@ -116,7 +116,7 @@
     </div>
 
