+{% include 'phase_instructions.js' %}
 
 /* ---------- Checks & Evidence ---------- */
 function syncTextItemList(list) {
diff --git a/project_workflow/interfaces/ui/templates/phase_instructions.js b/project_workflow/interfaces/ui/templates/phase_instructions.js
new file mode 100644
index 0000000..bfb3523
--- /dev/null
+++ b/project_workflow/interfaces/ui/templates/phase_instructions.js
@@ -0,0 +1,294 @@
+function validPhaseInstruction(row) {
+  return row && Number.isInteger(row.id) && row.id > 0 && row.phase_id === phaseId
+    && Number.isInteger(row.step_num) && row.step_num > 0 && typeof row.description === 'string'
+    && ['sync', 'parallel'].includes(row.execution_type) && Array.isArray(row.skills)
+    && row.skills.every((skill) => typeof skill === 'string');
+}
+
+async function readPhaseInstructions() {
+  const response = await fetch(phaseApiUrl('/api/phases/' + phaseId + '/instructions'), {cache: 'no-store'});
+  if (phaseSaveTerminalResponse(response.status)) throw Object.assign(new Error('Нет доступа к инструкциям'), {status: response.status});
+  const data = await response.json();
+  if (!response.ok || data.ok !== true || data.phase?.id !== phaseId
+    || data.phase.workflow_id !== phaseWorkflowId || data.phase.mode_id !== phaseModeId
+    || !Array.isArray(data.instructions) || !data.instructions.every(validPhaseInstruction)
+    || new Set(data.instructions.map((row) => row.id)).size !== data.instructions.length) throw new Error('Неверный ответ списка инструкций');
+  const rows = [...data.instructions].sort((a, b) => a.step_num - b.step_num);
+  if (rows.some((row, index) => row.step_num !== index + 1)) throw new Error('Неверный порядок инструкций');
+  return rows;
+}
+
+function instructionAttempt(kind, payload, returnFocus, id = null) {
+  const items = getInstructionItems();
+  return {kind, payload: structuredClone(payload), returnFocus, id, receivedId: null,
+    items, ids: items.map((item) => Number(item.dataset.instructionId)), raw: returnFocus?.value};
+}
+
+function instructionPayloadMatches(row, payload) {
+  return validPhaseInstruction(row) && Object.entries(payload).every(([key, value]) => JSON.stringify(row[key]) === JSON.stringify(value));
+}
+
+function phaseInstructionMatches(attempt, rows) {
+  const priorIds = attempt.ids;
+  let expectedIds = priorIds;
+  if (attempt.kind === 'create') {
+    // Only an identified ACK may bind a newly created entity to this attempt.
+    if (!Number.isInteger(attempt.receivedId) || priorIds.includes(attempt.receivedId)) return false;
+    expectedIds = [...priorIds, attempt.receivedId];
+  } else if (attempt.kind === 'delete') expectedIds = priorIds.filter((id) => id !== attempt.id);
+  if (rows.length !== expectedIds.length || expectedIds.some((id) => !rows.some((row) => row.id === id))) return false;
+  if (attempt.kind === 'reorder') return rows.every((row, index) => row.id === attempt.payload.instruction_ids[index]);
+  if (attempt.kind === 'delete') return !rows.some((row) => row.id === attempt.id);
+  return instructionPayloadMatches(rows.find((row) => row.id === (attempt.receivedId || attempt.id)), attempt.payload);
+}
+
+function syncPhaseInstructionRow(item, row, attempt) {
+  const card = item.querySelector('.timeline-card');
+  for (const node of [item, card]) {
+    node.dataset.instructionId = String(row.id);
+    node.dataset.stepNum = String(row.step_num);
+    node.dataset.type = row.execution_type;
+  }
+  const description = card.querySelector('.timeline-name-input');
+  if (attempt.kind === 'create' && row.id === attempt.receivedId) {
+    description.value = row.description;
+    description.dataset.originalDescription = row.description;
+  } else if (attempt.id === row.id && Object.hasOwn(attempt.payload, 'description')) {
+    if (description.value === attempt.raw) description.value = row.description;
+    description.dataset.originalDescription = row.description;
+  }
+  const type = card.querySelector('.execution-row .badge');
+  const parallel = row.execution_type === 'parallel';
+  type.className = 'badge ' + (parallel ? 'badge-parallel' : 'badge-sync');
+  type.textContent = parallel ? '⚡ параллельно' : '⏱ последовательно';
+  type.setAttribute('aria-label', 'Режим выполнения: ' + (parallel ? 'параллельно' : 'последовательно'));
+  if ((attempt.id === row.id && Object.hasOwn(attempt.payload, 'skills')) || (attempt.kind === 'create' && row.id === attempt.receivedId)) {
+    const badges = card.querySelector('.timeline-badges');
+    const input = badges.querySelector('.skill-candidate');
+    badges.querySelectorAll('.badge').forEach((badge) => badge.remove());
+    for (const skill of row.skills) {
+      const badge = document.createElement('span');
+      badge.className = 'badge';
+      badge.style.background = 'var(--accent-soft)';
+      badge.style.color = 'var(--accent-readable)';
+      badge.append(document.createTextNode(skill));
+      const button = document.createElement('button');
+      button.type = 'button';
+      button.className = 'skill-remove-btn';
+      button.dataset.skill = skill;
+      button.textContent = '×';
+      button.addEventListener('click', () => removeSkillFromInstruction(button));
+      badge.append(button);
+      badges.insertBefore(badge, input);
+    }
+    if (attempt.returnFocus === input && input.value === attempt.raw) input.value = '';
+  }
+  const step = row.step_num;
+  description.setAttribute('aria-label', 'Описание инструкции ' + step);
+  item.querySelector('.move-up-btn').setAttribute('aria-label', 'Поднять инструкцию ' + step + ' выше');
+  item.querySelector('.move-down-btn').setAttribute('aria-label', 'Опустить инструкцию ' + step + ' ниже');
+  item.querySelector('.phase-add-btn').setAttribute('aria-label', 'Добавить инструкцию после ' + step);
+  item.querySelector('.phase-delete-btn').setAttribute('aria-label', 'Удалить инструкцию ' + step);
+  card.querySelector('.skill-candidate').setAttribute('aria-label', 'Добавить навык к инструкции ' + step);
+  card.querySelectorAll('.skill-remove-btn').forEach((button) => button.setAttribute('aria-label', 'Убрать навык ' + button.dataset.skill + ' из инструкции ' + step));
+}
+
+function finishPhaseInstruction(attempt, rows) {
+  const current = getInstructionItems();
+  if (attempt.items.length !== current.length || attempt.items.some((item, index) => !current.includes(item)
+    || Number(item.dataset.instructionId) !== attempt.ids[index])) return false;
+  const items = new Map(attempt.items.map((item) => [Number(item.dataset.instructionId), item]));
+  const next = rows.map((row) => {
+    const item = items.get(row.id) || document.getElementById('phaseInstructionTemplate').content.firstElementChild.cloneNode(true);
+    syncPhaseInstructionRow(item, row, attempt);
+    return item;
+  });
+  renderInstructionTimeline(next);
+  const count = String(rows.length);
+  document.querySelector('#phase-instructions .count').textContent = count;
+  document.querySelector('[data-phase-section-link="phase-instructions"] .phase-outline-count').textContent = count;
+  document.querySelector('#phaseSectionSelect option[value="phase-instructions"]').textContent = 'Инструкции (' + count + ')';
+  phaseInstructionUnknown = null;
+  phaseInstructionDeleteState = null;
+  showPhaseSaveState('empty', '');
+  if (attempt.kind === 'reorder') showToast('Порядок инструкций сохранён', 'success');
+  else showToast('Сохранено', 'success');
+  if (attempt.kind === 'create') attempt.returnFocus = next.find((item) => Number(item.dataset.instructionId) === attempt.receivedId).querySelector('.timeline-name-input');
+  if (attempt.kind === 'delete') attempt.returnFocus = document.getElementById('phase-instructions');
+  resizeAllInlineTextareas();
+  return true;
+}
+
+async function readPhaseInstructionAttempt(attempt) {
+  try {
+    const rows = await readPhaseInstructions();
+    if (phaseInstructionMatches(attempt, rows) && finishPhaseInstruction(attempt, rows)) return true;
+  } catch (_error) {}
+  if (!phaseSaveTerminal) showPhaseSaveState('partial-error', 'Результат записи инструкции не подтверждён. Повтор заблокирован; черновик сохранён. Проверьте состояние.');
+  return false;
+}
+
+function restorePhaseInstructionFocus(attempt) {
+  if (phaseSaveTerminal) document.getElementById('phase-instructions').focus();
+  else if (phaseInstructionUnknown) document.getElementById('phaseSaveReconcile').focus();
+  else if (phaseInstructionDeleteState) phaseInstructionDeleteState.button.focus();
+  else if (attempt.returnFocus?.isConnected && !attempt.returnFocus.disabled) attempt.returnFocus.focus();
+  else document.getElementById('phase-instructions').focus();
+}
+
+async function requestPhaseInstruction(attempt) {
+  const reorder = attempt.kind === 'reorder';
+  const url = reorder ? '/api/phases/' + phaseId + '/instructions/reorder'
+    : attempt.kind === 'create' ? '/api/instructions' : '/api/instructions/' + attempt.id;
+  try {
+    const response = await fetch(phaseApiUrl(url), {
+      method: attempt.kind === 'create' ? 'POST' : 'PUT',
+      headers: {'Content-Type': 'application/json'}, body: JSON.stringify(attempt.payload),
+    });
+    if (phaseSaveTerminalResponse(response.status)) return false;
+    if (response.status >= 400 && response.status < 500 && response.status !== 408) {
+      if (reorder) renderInstructionTimeline(attempt.items);
+      showPhaseSaveState('error', 'Не удалось сохранить инструкцию. Исправьте данные; черновик сохранён.');
+      return false;
+    }
+    const data = await response.json().catch(() => null);
+    if (attempt.kind === 'create' && response.ok && data?.ok === true
+      && instructionPayloadMatches(data.instruction, attempt.payload)) attempt.receivedId = data.instruction.id;
+  } catch (_error) {}
+  finally {
+    if (phaseSaveTerminal || document.getElementById('phaseSaveStatus').dataset.pageState === 'error') {
+      endPhaseInstructionChange();
+      restorePhaseInstructionFocus(attempt);
+    }
+  }
+  phaseInstructionUnknown = attempt;
+  try { return await readPhaseInstructionAttempt(attempt); }
+  finally {
+    endPhaseInstructionChange();
+    restorePhaseInstructionFocus(attempt);
+  }
+}
+
+async function reconcilePhaseInstruction() {
+  if (phaseSavePending || phaseInstructionPending || phaseSaveTerminal || !phaseInstructionUnknown) return;
+  const attempt = phaseInstructionUnknown;
+  phaseInstructionPending = true;
+  showPhaseSaveState('loading', 'Проверка сохранения инструкции…');
+  updatePhaseSaveControls();
+  try { await readPhaseInstructionAttempt(attempt); }
+  finally {
+    endPhaseInstructionChange();
+    restorePhaseInstructionFocus(attempt);
+  }
+}
+
+async function moveInstruction(button, direction) {
+  if (phaseAggregateLocked()) return;
+  const items = getInstructionItems();
+  const index = items.indexOf(button.closest('.timeline-item'));
+  const target = index + direction;
+  if (index < 0 || target < 0 || target >= items.length || ![-1, 1].includes(direction)) return;
+  if (!beginPhaseInstructionChange(null, false)) return;
+  const attempt = instructionAttempt('reorder', {}, button);
+  const reordered = [...items];
+  const [moved] = reordered.splice(index, 1);
+  reordered.splice(target, 0, moved);
+  attempt.payload = {instruction_ids: reordered.map((item) => Number(item.dataset.instructionId))};
+  renderInstructionTimeline(reordered);
+  updateInstructionControls();
+  return requestPhaseInstruction(attempt);
+}
+
+async function createPhaseInstruction(step, button) {
+  if (!beginPhaseInstructionChange()) return;
+  return requestPhaseInstruction(instructionAttempt('create', {
+    phase_id: phaseId, description: 'Новая инструкция', step_num: step, execution_type: 'sync', skills: [],
+  }, button));
+}
+
+async function addInstructionAfter(button) {
+  if (phaseAggregateLocked()) return;
+  const item = button.closest('.timeline-item');
+  if (item) return createPhaseInstruction(Number(item.dataset.stepNum) + 1, button);
+}
+
+async function addInstructionLast() {
+  if (phaseAggregateLocked()) return;
+  return createPhaseInstruction(getInstructionItems().length + 1, document.querySelector('#phase-instructions .wiki-add-btn'));
+}
+
+async function saveInstructionDescription(input) {
+  if (phaseAggregateLocked()) return;
+  const previousDescription = input.dataset.originalDescription || '';
+  if (input.value === previousDescription) return;
+  const rawDescription = input.value;
+  const description = rawDescription.trim();
+  if (!description) {
+    showPhaseSaveState('error', 'Описание инструкции обязательно');
+    refreshWorkflowDraftGuard();
+    return;
+  }
+  if (!beginPhaseInstructionChange(input, false)) return;
+  return requestPhaseInstruction(instructionAttempt('update', {description}, input, Number(input.closest('.timeline-card').dataset.instructionId)));
+}
+
+async function toggleInstructionType(badge) {
+  if (phaseAggregateLocked() || !beginPhaseInstructionChange()) return;
+  const card = badge.closest('.timeline-card');
+  return requestPhaseInstruction(instructionAttempt('update', {execution_type: card.dataset.type === 'parallel' ? 'sync' : 'parallel'}, badge, Number(card.dataset.instructionId)));
+}
+
+function phaseInstructionSkills(card) {
+  return Array.from(card.querySelectorAll('.skill-remove-btn')).map((button) => button.dataset.skill);
+}
+
+async function addSkillToInstruction(input) {
+  if (phaseAggregateLocked()) return;
+  const skill = input.value.trim();
+  if (!skill || !beginPhaseInstructionChange(input)) return;
+  const card = input.closest('.timeline-card');
+  return requestPhaseInstruction(instructionAttempt('update', {skills: normalizeSkillNames([...phaseInstructionSkills(card), skill])}, input, Number(card.dataset.instructionId)));
+}
+
+async function removeSkillFromInstruction(button) {
+  if (phaseAggregateLocked() || !beginPhaseInstructionChange()) return;
+  const card = button.closest('.timeline-card');
+  return requestPhaseInstruction(instructionAttempt('update', {skills: phaseInstructionSkills(card).filter((skill) => skill !== button.dataset.skill)}, button, Number(card.dataset.instructionId)));
+}
+
+async function deleteInstruction(button) {
+  const recovery = phaseInstructionDeleteState?.button === button && phaseInstructionDeleteState.state.kind === 'unknown';
+  if (phaseSavePending || phaseInstructionPending || phaseInstructionUnknown || phaseUnknownSave || phaseSaveTerminal
+    || (phaseInstructionDeleteState && !recovery)) return;
+  const item = button.closest('.timeline-item');
+  if (!item) return;
+  if (!recovery && !beginPhaseInstructionChange()) return;
+  phaseInstructionPending = true;
+  updatePhaseSaveControls();
+  const attempt = instructionAttempt('delete', {}, button, Number(item.dataset.instructionId));
+  const url = phaseApiUrl('/api/instructions/' + attempt.id);
+  try {
+    const deleted = await requestWorkflowDeletion({
+      url, title: 'Удалить инструкцию?', message: 'Инструкция будет удалена без возможности восстановления.',
+      returnFocus: button, fallbackFocus: document.getElementById('phase-instructions'),
+      exists: async () => (await readPhaseInstructions()).some((row) => row.id === attempt.id),
+    });
+    if (deleted) {
+      phaseInstructionDeleteState = null;
+      phaseInstructionUnknown = attempt;
+      await readPhaseInstructionAttempt(attempt);
+    } else {
+      const state = workflowDeletionState(url);
+      phaseInstructionDeleteState = state.kind === 'ready' ? null : {state, button};
+      if (state.kind !== 'ready') {
+        if (!phaseSaveTerminalResponse(state.status)) showPhaseSaveState('partial-error', 'Результат удаления неизвестен. Повторная запись заблокирована; проверьте удаление.');
+        button.setAttribute('aria-label', 'Проверить удаление инструкции ' + item.dataset.stepNum);
+        button.title = 'Проверить удаление инструкции';
+        button.textContent = '↻';
+      }
+    }
+  } finally {
+    endPhaseInstructionChange();
+    restorePhaseInstructionFocus(attempt);
+  }
+}
