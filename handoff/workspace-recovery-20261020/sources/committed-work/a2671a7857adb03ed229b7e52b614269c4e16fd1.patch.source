-.add-row input,.add-row button{min-height:40px}
+.add-row input,.add-row button{min-height:var(--shell-control-min)}
 .order-controls{display:flex;flex-direction:column;align-items:center;gap:4px}
 .order-btn{width:40px;height:40px;border-radius:6px;border:1px solid var(--border);background:var(--surface);color:var(--text);cursor:pointer;font-size:16px;line-height:1}
 .order-btn:hover:not(:disabled){border-color:var(--accent);color:var(--accent)}
 .order-btn:disabled{opacity:.35;cursor:not-allowed}
 .row-actions .icon-btn{width:40px;height:40px}
 .empty-instructions{color:var(--text-dim);font-size:13px;padding:20px 0}
