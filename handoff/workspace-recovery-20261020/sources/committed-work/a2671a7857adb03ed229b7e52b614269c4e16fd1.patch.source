         assert 'data-page-layout="wide"' in response.text
 
     def test_mobile_shell_keeps_theme_and_services_in_drawer(self):
@@ -530,7 +533,9 @@ class TestPhasesPage:
         assert 'id="themeSelector"' in response.text
