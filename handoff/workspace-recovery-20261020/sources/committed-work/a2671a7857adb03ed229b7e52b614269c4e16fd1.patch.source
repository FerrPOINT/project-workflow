-.skills-input{width:100%;min-height:40px;font-size:13px;padding:6px 8px;background:var(--panel);border:1px solid var(--border);border-radius:4px;color:var(--text-secondary)}
+.skills-input{width:100%;min-height:var(--shell-control-min);font-size:13px;padding:6px 8px;background:var(--panel);border:1px solid var(--border);border-radius:4px;color:var(--text-secondary)}
 .parallel-group{border:1px solid var(--orange);border-radius:8px;padding:12px;background:rgba(245,158,11,.08);box-shadow:inset 0 0 0 1px rgba(245,158,11,.18)}
 .parallel-label{display:inline-flex;align-items:center;align-self:flex-start;gap:6px;padding:3px 10px;border-radius:999px;border:1px solid var(--orange);background:var(--orange-soft);color:var(--orange);font-size:11px;font-weight:700;letter-spacing:.04em;margin-bottom:8px}
