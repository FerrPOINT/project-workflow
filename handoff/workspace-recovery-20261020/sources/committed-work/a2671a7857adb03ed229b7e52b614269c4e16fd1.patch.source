@@ -0,0 +1,7 @@
+@import 'tailwindcss';
+@import '@sdlc/ui/tokens.css';
+@source '../node_modules/@sdlc/ui/src';
+html, body, #root { min-height: 100%; margin: 0; }
+body { font-family: Inter, system-ui, sans-serif; background: var(--color-background); color: var(--color-text-primary); letter-spacing: 0; }
+.workflow-row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--color-border); overflow-wrap: anywhere; }
+@media (max-width: 767px) { .workflow-row { grid-template-columns: minmax(0, 1fr); gap: 6px; } }
