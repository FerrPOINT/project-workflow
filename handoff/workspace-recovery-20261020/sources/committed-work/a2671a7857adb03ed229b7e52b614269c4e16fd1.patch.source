--- /dev/null
+++ b/frontend/src/api.test.ts
@@ -0,0 +1,10 @@
+import { describe, expect, it } from 'vitest'
+import { scopedPath, taskHref } from './api'
+
+describe('read-only navigation', () => {
+  it('preserves namespace context and escapes task keys for Jinja', () => {
+    expect(taskHref({ task_key: 'RUN/42', namespace_id: 8 })).toBe('/task/RUN%2F42?namespace_id=8')
+    expect(scopedPath('/api/tasks', '8')).toBe('/api/tasks?namespace_id=8')
+    expect(scopedPath('/api/tasks', '')).toBe('/api/tasks')
+  })
+})
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..fa8944a
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,15 @@
+import { createApiClient } from '@sdlc/ui/lib'
+
+export interface Namespace { id: number; name: string; code: string; theme_color?: string }
+export interface Task { task_key: string; namespace_id: number; title: string; current_phase_name: string; status_label: string }
+export interface Phase { id: number; name: string; description?: string; agent_name?: string; instructions?: { id: number; description: string; execution_type: string }[] }
+export const client = createApiClient({ onUnauthorized: () => {
+  window.location.assign(`/login?next=${encodeURIComponent(window.location.pathname + window.location.search)}`)
+} })
+
+export function scopedPath(path: string, namespace: string) {
+  return `${path}${namespace ? `?${new URLSearchParams({ namespace_id: namespace })}` : ''}`
+}
+export function taskHref(task: Pick<Task, 'task_key' | 'namespace_id'>) {
+  return `/task/${encodeURIComponent(task.task_key)}?${new URLSearchParams({ namespace_id: String(task.namespace_id) })}`
+}
diff --git a/frontend/src/main.tsx b/frontend/src/main.tsx
new file mode 100644
index 0000000..1f0e1f7
--- /dev/null
+++ b/frontend/src/main.tsx
@@ -0,0 +1,15 @@
+import { StrictMode } from 'react'
+import { createRoot } from 'react-dom/client'
+import { BrowserRouter } from 'react-router'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { PlatformProvider, ThemeProvider } from '@sdlc/ui/lib'
+import { I18nextProvider } from 'react-i18next'
+import i18next from 'i18next'
+import { App } from './App'
+import './style.css'
+
+void i18next.init({ lng: 'ru', fallbackLng: 'ru', resources: { ru: { translation: { common: { loading: 'Загрузка...', retry: 'Повторить', cancel: 'Отмена', confirm: 'Подтвердить', empty: 'Нет данных' } } } } })
+const queryClient = new QueryClient({ defaultOptions: { queries: { retry: (count, error) => count < 1 && (!('status' in error) || Number(error.status) >= 500) } } })
+const node = document.getElementById('workflow-bootstrap')
+const bootstrap: { identity?: { name?: string; subject?: string }; namespaceId?: number } = node ? JSON.parse(node.textContent ?? '{}') : {}
+createRoot(document.getElementById('root')!).render(<StrictMode><QueryClientProvider client={queryClient}><I18nextProvider i18n={i18next}><ThemeProvider><PlatformProvider configUrl={null}><BrowserRouter basename="/react"><App identity={bootstrap.identity} initialNamespace={bootstrap.namespaceId} /></BrowserRouter></PlatformProvider></ThemeProvider></I18nextProvider></QueryClientProvider></StrictMode>)
