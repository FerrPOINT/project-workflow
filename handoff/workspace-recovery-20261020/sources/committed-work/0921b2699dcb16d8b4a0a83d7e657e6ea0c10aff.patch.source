     await expect(page.locator('#newName')).toHaveValue('Unsaved agent draft')
     await expect(form.locator('[data-page-state]')).toHaveText('Fixture validation rejected')
-    await expect(page.locator('#toast')).not.toHaveText('Fixture validation rejected')
+    await expect(page.locator('#toast')).toHaveCount(0)
+    await expect(form.getByRole('alert')).toHaveCount(1)
     expect(writes).toBe(1)
   } finally { release() }
 })
diff --git a/frontend/e2e/base-list-feedback.spec.ts b/frontend/e2e/base-list-feedback.spec.ts
new file mode 100644
index 0000000..37b841b
--- /dev/null
+++ b/frontend/e2e/base-list-feedback.spec.ts
@@ -0,0 +1,156 @@
+import { expect, test } from '@playwright/test'
+
+if (process.env.WORKFLOW_UI_QA_MUTATIONS !== 'isolated-fixture') throw new Error('UI QA requires an isolated fixture')
+
+for (const theme of ['dark', 'gray', 'light']) {
+  for (const route of ['tasks', 'phases']) {
+    test(`Base pilot ${route} table has stable columns, density and local keyboard scroll (${theme})`, async ({ page }, testInfo) => {
+      await page.addInitScript(value => {
+        localStorage.setItem('theme', value)
+        localStorage.setItem('workflow-theme', value)
+      }, theme)
+      await page.route('**/api/namespaces', request => request.fulfill({ json: { namespaces: [{ id: 1, name: 'Fixture', workflow_id: 1 }] } }))
+      await page.route(`**/api/${route}*`, request => request.fulfill({ json: route === 'tasks' ? {
+        tasks: [
+          { namespace_id: 1, task_key: 'QA/1', title: 'Первая задача', current_phase_name: 'Ревью', status_label: 'В работе' },
+          { namespace_id: 1, task_key: 'QA/2', title: 'ДлинноеНазваниеБезПробелов'.repeat(15), current_phase_name: 'Проверка', status_label: 'Ожидает подтверждения' },
+        ],
+      } : {
+        phases: [
+          { id: 1, name: 'Первая фаза', agent_name: 'Агент', description: 'Краткое описание' },
+          { id: 2, name: 'ДлинноеНазваниеБезПробелов'.repeat(15), agent_name: null, description: 'Подробное описание '.repeat(25) },
+        ],
+      } }))
+      const widths = testInfo.project.name === 'desktop' ? [1023, 1024, 1279, 1280, 1440, 1920, 2560] : [375, 767, 768]
+      for (const width of widths) {
+        await page.setViewportSize({ width, height: 1080 })
+        await page.goto(`/react/${route}?namespace_id=1`)
+        await page.reload()
+        const table = page.getByRole('table', { name: route === 'tasks' ? 'Задачи' : 'Фазы', exact: true })
+        await expect(table.locator('tbody tr')).toHaveCount(2)
+        await expect(table.getByRole('columnheader')).toHaveCount(3)
+        await expect(page.locator('[data-page-layout]')).toHaveAttribute('data-page-layout', 'wide')
+        const geometry = await table.evaluate(element => {
+          const rows = [...element.querySelectorAll('tbody tr')]
+          const boxes = rows.map(row => [...row.children].map(cell => cell.getBoundingClientRect()))
+          const scroll = element.parentElement!
+          return {
+            columns: boxes.map(cells => cells.map(cell => ({ x: cell.x, width: cell.width }))),
+            rowGap: boxes[1][0].top - boxes[0][0].bottom,
+            overflow: document.documentElement.scrollWidth - window.innerWidth,
+            scrollable: scroll.scrollWidth > scroll.clientWidth,
+            scrollLeft: scroll.scrollLeft,
+          }
+        })
+        expect(geometry.overflow).toBeLessThanOrEqual(1)
+        expect(Math.abs(geometry.rowGap)).toBeLessThanOrEqual(1)
+        expect(geometry.columns[0]).toEqual(geometry.columns[1])
+        const link = table.getByRole('link').first()
+        expect((await link.boundingBox())!.height).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
+        await table.focus()
+        await expect(table).toBeFocused()
+        if (geometry.scrollable) {
+          await page.keyboard.press('ArrowRight')
+          await expect.poll(() => table.evaluate(element => element.parentElement!.scrollLeft)).toBeGreaterThan(0)
+        }
+        await link.focus()
+        await expect(link).toBeFocused()
+        const href = await link.getAttribute('href')
+        expect(href).toBe(route === 'tasks' ? '/task/QA%2F1?namespace_id=1' : '/react/phases/1?namespace_id=1')
+        if ([375, 1920].includes(width)) await page.screenshot({ path: testInfo.outputPath(`base-table-${route}-${theme}-${width}.png`), fullPage: true })
+      }
+    })
+  }
+
+  for (const outcome of ['success', 'failure']) {
+    test(`SSR CLI ${outcome} uses a local Base state without a toast or focus theft (${theme})`, async ({ page }, testInfo) => {
+      await page.addInitScript(({ theme, outcome }) => {
+        localStorage.setItem('workflow-theme', theme)
+        Object.defineProperty(navigator, 'clipboard', { configurable: true, value: { writeText: async (value: string) => {
+          if (!value) throw new Error('Empty command')
+          if (outcome === 'failure') throw new Error('Fixture clipboard rejection')
+        } } })
+      }, { theme, outcome })
+      await page.goto('/settings?namespace_id=1')
+      const command = page.locator('.cli-command').first()
+      const button = command.getByRole('button', { name: /^Копировать команду/ })
+      await button.click()
+      const state = command.locator('[data-page-state]')
+      await expect(state).toHaveText(outcome === 'success' ? 'Команда скопирована' : 'Не удалось скопировать команду')
+      await expect(state).toHaveAttribute('role', outcome === 'success' ? 'status' : 'alert')
+      await expect(state).toHaveAttribute('data-page-state', outcome === 'success' ? 'ready' : 'error')
+      await expect(button).toBeEnabled()
+      await expect(button).toBeFocused()
+      await expect(page.locator('#toast')).toHaveCount(0)
+      expect(await page.evaluate(() => 'showToast' in window)).toBe(false)
+      expect(await state.evaluate(element => getComputedStyle(element).position)).toBe('static')
+      expect(await page.evaluate(() => document.documentElement.scrollWidth - innerWidth)).toBeLessThanOrEqual(1)
+      await expect(page.locator('.cli-copy-state:visible')).toHaveCount(1)
+      await page.screenshot({ path: testInfo.outputPath(`base-cli-${outcome}-${theme}-${page.viewportSize()!.width}.png`), fullPage: true })
+    })
+  }
+  test(`SSR long validation stays inline and retains the agent draft (${theme})`, async ({ page }) => {
+    await page.addInitScript(value => localStorage.setItem('workflow-theme', value), theme)
+    const message = 'Длинное сообщение об ошибке проверки полей. '.repeat(40)
+    let writes = 0
+    await page.route('**/api/agents', route => {
+      expect(route.request().method()).toBe('POST')
+      writes++
+      return route.fulfill({ status: 422, json: { ok: false, error: message } })
+    })
+    await page.goto('/agents?namespace_id=1')
+    await page.locator('#agentCreatePanel > summary').click()
+    await page.locator('#newName').fill('Retained draft')
+    const form = page.locator('#agentCreatePanel form')
+    await form.locator('[type="submit"]').click()
+    await expect(form.getByRole('alert')).toHaveText(message.trim())
+    await expect(page.locator('#newName')).toHaveValue('Retained draft')
+    await expect(page.locator('#newName')).toBeEnabled()
+    await expect(page.locator('#toast')).toHaveCount(0)
+    expect(await page.evaluate(() => document.documentElement.scrollWidth - innerWidth)).toBeLessThanOrEqual(1)
+    expect(writes).toBe(1)
+    await page.locator('#newName').fill('Edited retained draft')
+    await expect(form.locator('.agent-write-state')).not.toBeVisible()
+  })
+}
+
+test('SSR CLI fallback copy keeps the same local feedback and focus contract', async ({ page }) => {
+  await page.addInitScript(() => {
+    Object.defineProperty(navigator, 'clipboard', { configurable: true, value: undefined })
+    document.execCommand = (command: string) => command === 'copy'
+  })
+  await page.goto('/settings?namespace_id=1')
+  const command = page.locator('.cli-command').first()
+  const button = command.getByRole('button', { name: /^Копировать команду/ })
+  await button.click()
+  await expect(command.getByRole('status')).toHaveText('Команда скопирована')
+  await expect(button).toBeFocused()
+  await expect(page.locator('body > textarea')).toHaveCount(0)
+  await expect(page.locator('#toast')).toHaveCount(0)
+})
+
+test('SSR agent acknowledgement stays visible after disclosure closes and returns focus to its summary', async ({ page, request }) => {
+  const name = `Inline feedback ${crypto.randomUUID()}`
+  const created = await request.post('/api/agents', { data: { name, description: '', launch_profile: null } })
+  expect(created.ok()).toBeTruthy()
+  const id = (await created.json()).agent_id as number
+  try {
+    await page.goto('/agents?namespace_id=1')
+    const entry = page.locator(`.agent-entry[data-id="${id}"]`)
+    const summary = entry.locator('summary')
+    await summary.click()
+    await entry.locator('textarea').fill('Confirmed update')
+    await entry.getByRole('button', { name: 'Сохранить', exact: true }).click()
+    await expect(entry).not.toHaveAttribute('open', '')
+    await expect(summary).toBeFocused()
+    const state = page.locator('#agentFeedback [data-page-state]')
+    await expect(state).toHaveText('Агент сохранён')
+    await expect(state).toHaveAttribute('role', 'status')
+    await expect(state).toBeVisible()
+    expect(await state.evaluate(element => getComputedStyle(element).position)).toBe('static')
+    await summary.click()
+    await entry.locator('textarea').fill('Next unsaved draft')
+    await expect(page.locator('#agentFeedback')).not.toBeVisible()
+    await expect(entry.locator('textarea')).toHaveValue('Next unsaved draft')
+  } finally { expect((await request.delete(`/api/agents/${id}`)).ok()).toBeTruthy() }
+})
