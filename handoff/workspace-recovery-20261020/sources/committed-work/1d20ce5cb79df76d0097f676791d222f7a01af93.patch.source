+function workflowLocationContext(href){
+  var url = new URL(href);
+  return url.pathname + ':' + (url.searchParams.get('workflow_id') || '') + ':' + (url.searchParams.get('workflow_mode') || '') + ':' + (url.searchParams.get('namespace_id') || '');
+}
+window.addEventListener('popstate', function(event){
+  var target = {href:window.location.href,index:event.state && event.state.workflowEditorIndex,state:event.state};
+  if(workflowHistoryAttempt){
+    var attempt = workflowHistoryAttempt;
+    if(attempt.stage === 'replay' && target.href === attempt.target.href){
+      workflowHistoryAttempt = null;
+      workflowAcceptedLocation = target;
+      restoreWorkflowLocation();
+      return;
+    }
+    if(target.href !== workflowAcceptedLocation.href){
+      if(Number.isInteger(target.index))window.history.go(workflowAcceptedLocation.index - target.index);
+      else window.history.replaceState(workflowAcceptedLocation.state, '', workflowAcceptedLocation.href);
+      return;
+    }
+    if(attempt.stage !== 'restore')return;
+    attempt.stage = 'confirm';
+    requestWorkflowTransition(function(){
+      attempt.stage = 'replay';
+      window.history.go(attempt.target.index - workflowAcceptedLocation.index);
+    }).then(function(allowed){ if(!allowed && workflowHistoryAttempt === attempt)workflowHistoryAttempt = null; });
+    return;
+  }
+  if(workflowLocationContext(target.href) === workflowLocationContext(workflowAcceptedLocation.href)){
+    var index = Number.isInteger(target.index) ? target.index : workflowAcceptedLocation.index;
+    window.history.replaceState(Object.assign({}, target.state, {workflowEditorIndex:index}), '', target.href);
+    workflowAcceptedLocation = {href:target.href,index:index,state:window.history.state};
+    return;
+  }
+  if(!workflowDraftDirty() && !workflowMutationPending && !workflowCataloguePending){ workflowAcceptedLocation = target; restoreWorkflowLocation(); return; }
+  if(!Number.isInteger(target.index)){
+    window.history.replaceState(workflowAcceptedLocation.state, '', workflowAcceptedLocation.href);
+    showWorkflowError('Переход не выполнен: сохраните изменения или выберите воркфлоу.');
+    return;
+  }
+  workflowHistoryAttempt = {stage:'restore',target:target};
+  window.history.go(workflowAcceptedLocation.index - target.index);
 });
