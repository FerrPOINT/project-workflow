+function validWorkflowCatalogue(data){
+  return data && data.ok === true && Array.isArray(data.workflows)
+    && data.workflows.every(function(item){ return item && Number.isInteger(item.id) && item.id > 0 && typeof item.name === 'string' && typeof item.description === 'string'; })
+    && new Set(data.workflows.map(function(item){ return item.id; })).size === data.workflows.length;
+}
+function workflowMatchesAttempt(item, attempt){
+  return item && Number.isInteger(item.id) && item.id > 0 && item.name === attempt.payload.name && item.description === attempt.payload.description
+    && (attempt.id == null ? !attempt.knownIds.has(item.id) : item.id === attempt.id);
+}
+function rejectWorkflowWrite(response, data){
