 {% block extra_script %}
 const PHASE_ID = {{ phase.id }};
-const selectedNamespaceId = {{ selected_namespace.id if selected_namespace else 'null' }};
+const selectedNamespaceId = {{ selected_namespace.id if selected_namespace and selected_namespace.workflow_id == phase.workflow_id else 'null' }};
+let instructionMutationPending = false;
+let instructionUnknownWrite = null;
+let instructionTerminalState = null;
+let instructionDeleteState = null;
+
+function instructionWritesBlocked() {
+  return instructionMutationPending || Boolean(instructionUnknownWrite || instructionTerminalState || instructionDeleteState);
+}
+function instructionDraftDirty() {
+  return Boolean(instructionUnknownWrite || instructionDeleteState) || Boolean(document.getElementById('newInstructionText').value) || getRows().some(row =>
+    row.querySelector('.instruction-text').value !== row.querySelector('.instruction-text').dataset.originalDescription ||
+    row.querySelector('.skills-input').value !== row.querySelector('.skills-input').dataset.originalSkills);
+}
+function showInstructionError(message, kind = 'error') {
+  const container = document.getElementById('instructionWriteError');
+  container.hidden = !message;
+  const state = container.querySelector('[data-page-state]');
+  state.dataset.pageState = kind;
+  state.setAttribute('role', kind === 'error' || kind === 'partial-error' ? 'alert' : 'status');
+  state.querySelector('p').textContent = message;
+  state.tabIndex = -1;
+}
+function updateInstructionControls() {
+  document.querySelectorAll('#instructionsLayout button,#instructionsLayout input,#instructionsLayout textarea,.add-panel input,.add-panel button').forEach(control => { control.disabled = instructionWritesBlocked(); });
+  if (instructionDeleteState && instructionDeleteState.state.kind === 'unknown' && !instructionMutationPending) {
+    instructionDeleteState.button.disabled = false;
+  }
+  const reconcile = document.getElementById('instructionReconcileButton');
+  reconcile.hidden = !instructionUnknownWrite || Boolean(instructionTerminalState);
+  reconcile.disabled = instructionMutationPending;
+  document.getElementById('instructionsLayout').setAttribute('aria-busy', String(instructionMutationPending));
+  updateMoveButtons();
+  refreshWorkflowDraftGuard();
+}
+function focusInstructionRecovery() {
+  if (instructionTerminalState) document.querySelector('#instructionWriteError [data-page-state]').focus();
+  else if (instructionUnknownWrite) document.getElementById('instructionReconcileButton').focus();
+  else if (!document.getElementById('instructionWriteError').hidden) document.querySelector('#instructionWriteError [data-page-state]').focus();
+}
+function focusInstructionAcknowledgement(attempt) {
+  const trigger = attempt.returnFocus;
+  if (trigger?.isConnected && !trigger.disabled) { trigger.focus(); return; }
+  const fallback = trigger?.closest('.instruction-row')?.querySelector('.instruction-text') || document.getElementById('newInstructionText');
+  fallback.focus();
+}
+function validInstruction(item) {
+  return item && Number.isInteger(item.id) && item.id > 0 && item.phase_id === PHASE_ID &&
+    Number.isInteger(item.step_num) && item.step_num > 0 && typeof item.description === 'string' &&
+    ['sync', 'parallel'].includes(item.execution_type) && Array.isArray(item.skills) && item.skills.every(skill => typeof skill === 'string');
+}
+function instructionMatchesAttempt(item, attempt) {
+  return validInstruction(item) && (attempt.kind === 'create' ? !attempt.knownIds.has(item.id) : item.id === attempt.id) &&
+    Object.entries(attempt.payload).every(([key, value]) => key === 'phase_id' || JSON.stringify(item[key]) === JSON.stringify(value));
+}
+function rejectInstructionWrite(response, data) {
+  instructionTerminalState = [401, 403].includes(response.status) ? 'permission-denied' : response.status === 404 ? 'not-found' : null;
+  showInstructionError(data && typeof data.error === 'string' ? data.error : 'Изменения не сохранены. Проверьте поля и доступ.', instructionTerminalState || 'error');
+}
+function applyInstructionRecord(row, item, fields) {
+  if (fields.includes('description')) {
+    const input = row.querySelector('.instruction-text');
+    input.value = item.description;
+    input.dataset.originalDescription = item.description;
+    resizeInstructionTextarea(input);
+  }
+  if (fields.includes('skills')) {
+    const input = row.querySelector('.skills-input');
+    input.value = item.skills.join(', ');
+    input.dataset.originalSkills = input.value;
+    const chips = row.querySelector('.instruction-skills-list');
+    chips.replaceChildren();
+    item.skills.forEach(skill => {
+      const chip = document.createElement('span');
+      chip.className = 'skill-chip';
+      chip.textContent = skill;
+      chips.appendChild(chip);
+    });
+  }
+  if (fields.includes('execution_type')) {
+    const badge = row.querySelector('.type-badge');
+    badge.dataset.executionType = item.execution_type;
+    badge.classList.toggle('sync', item.execution_type === 'sync');
+    badge.classList.toggle('parallel', item.execution_type === 'parallel');
+    badge.textContent = item.execution_type === 'parallel' ? 'параллельно' : 'последовательно';
+    badge.setAttribute('aria-pressed', String(item.execution_type === 'parallel'));
+  }
+}
+function acknowledgeInstruction(item, attempt) {
+  if (attempt.kind === 'create') {
+    const row = document.getElementById('instructionRowTemplate').content.firstElementChild.cloneNode(true);
+    row.dataset.instructionId = String(item.id);
+    row.dataset.stepNum = String(item.step_num);
+    applyInstructionRecord(row, item, ['description', 'skills', 'execution_type']);
+    document.querySelector('#instructionsLayout [data-page-state="empty"]')?.remove();
+    document.getElementById('instructionsLayout').appendChild(row);
+    document.getElementById('newInstructionText').value = '';
+  } else if (attempt.kind === 'update') {
+    applyInstructionRecord(getRows().find(row => Number(row.dataset.instructionId) === attempt.id), item, Object.keys(attempt.payload));
+  }
+  instructionUnknownWrite = null;
+  showInstructionError('');
+  document.getElementById('instructionReadbackCandidates').hidden = true;
+  updateTimeline();
+  showToast('Изменения сохранены', 'success');
+}
+async function requestInstruction(attempt) {
+  if (instructionWritesBlocked()) return false;
+  instructionMutationPending = true;
+  showInstructionError('');
+  updateInstructionControls();
+  let acknowledged = false;
+  try {
+    const response = await fetch(instructionApiUrl(attempt.url), {
+      method: attempt.kind === 'create' ? 'POST' : 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(attempt.payload),
+    });
+    const data = await response.json().catch(() => null);
+    if (response.ok && data && data.ok === true && attempt.kind === 'create' && data.instruction &&
+        Number.isInteger(data.instruction.id) && data.instruction.id > 0 && !attempt.knownIds.has(data.instruction.id)) attempt.receivedId = data.instruction.id;
+    if (!response.ok || !data || data.ok !== true) {
+      if (response.ok || response.status >= 500 || response.status === 408) instructionUnknownWrite = attempt;
+      else {
+        if (attempt.previousRows) { document.getElementById('instructionsLayout').replaceChildren(...attempt.previousRows); updateTimeline(); }
+        rejectInstructionWrite(response, data);
+      }
+    } else if (attempt.kind !== 'reorder' && !instructionMatchesAttempt(data.instruction, attempt)) instructionUnknownWrite = attempt;
+    else { acknowledgeInstruction(data.instruction, attempt); acknowledged = true; }
+  } catch (_error) { instructionUnknownWrite = attempt; }
+  finally {
+    if (instructionUnknownWrite) showInstructionError('Результат записи неизвестен. Введённые значения сохранены; повтор заблокирован до проверки.');
+    instructionMutationPending = false;
+    updateInstructionControls();
+    focusInstructionRecovery();
+  }
+  if (acknowledged) focusInstructionAcknowledgement(attempt);
+  return acknowledged;
+}
+async function reconcileInstructionWrite() {
+  if (instructionMutationPending || !instructionUnknownWrite || instructionTerminalState) return;
+  const attempt = instructionUnknownWrite;
+  instructionMutationPending = true;
+  updateInstructionControls();
+  let acknowledged = false;
+  try {
+    const response = await fetch(instructionApiUrl('/api/phases/' + PHASE_ID + '/instructions'), {cache: 'no-store'});
+    const data = await response.json().catch(() => null);
+    if ([401, 403, 404].includes(response.status)) { rejectInstructionWrite(response, data); return; }
+    if (!response.ok || !data || data.ok !== true || !data.phase || data.phase.id !== PHASE_ID ||
+        !Array.isArray(data.instructions) || !data.instructions.every(validInstruction) ||
+        new Set(data.instructions.map(item => item.id)).size !== data.instructions.length ||
+        new Set(data.instructions.map(item => item.step_num)).size !== data.instructions.length) throw new Error('Catalogue unavailable');
+    const rows = [...data.instructions].sort((left, right) => left.step_num - right.step_num);
+    if (rows.some((row, index) => row.step_num !== index + 1)) throw new Error('Order unavailable');
+    const id = attempt.kind === 'create' ? attempt.receivedId : attempt.id;
+    const saved = attempt.kind === 'reorder' ? JSON.stringify(rows.map(item => item.id)) === JSON.stringify(attempt.payload.instruction_ids) :
+      id != null && rows.find(item => item.id === id && instructionMatchesAttempt(item, attempt));
+    if (saved) { acknowledgeInstruction(attempt.kind === 'reorder' ? null : saved, attempt); acknowledged = true; }
+    else if (attempt.kind === 'update' && !rows.some(item => item.id === attempt.id)) {
+      instructionTerminalState = 'not-found';
+      showInstructionError('Инструкция больше недоступна. Введённые значения сохранены.', 'not-found');
+    } else {
+      showInstructionError('Сохранение пока не подтверждено. Повторная запись заблокирована.');
+      const candidates = document.getElementById('instructionReadbackCandidates');
+      candidates.replaceChildren();
+      if (attempt.kind === 'create' && attempt.receivedId == null) rows.filter(item => instructionMatchesAttempt(item, attempt)).forEach(item => {
+        const link = document.createElement('a');
+        link.className = 'base-control base-button base-button-secondary';
+        link.href = '/instructions?phase_id=' + PHASE_ID + (selectedNamespaceId === null ? '' : '&namespace_id=' + selectedNamespaceId);
+        link.target = '_blank'; link.rel = 'noopener';
+        link.textContent = 'Проверить найденную инструкцию (ID ' + item.id + ') в новой вкладке';
+        candidates.appendChild(link);
+      });
+      candidates.hidden = !candidates.childElementCount;
+    }
+  } catch (_error) { showInstructionError('Не удалось проверить сохранение. Введённые значения сохранены, повторная запись заблокирована.'); }
+  finally { instructionMutationPending = false; updateInstructionControls(); focusInstructionRecovery(); }
+  if (acknowledged) focusInstructionAcknowledgement(attempt);
+}
 
