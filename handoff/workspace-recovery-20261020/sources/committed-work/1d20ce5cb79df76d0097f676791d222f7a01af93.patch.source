+  try {
+    var response = await fetch('/api/workflows' + (id == null ? '' : '/' + id), {method:method,headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
+    var data = await response.json().catch(function(){ return null; });
+    if(response.ok && data && data.ok === true && id == null && Number.isInteger(data.workflow_id) && data.workflow_id > 0 && !attempt.knownIds.has(data.workflow_id))attempt.receivedId = data.workflow_id;
+    if(!response.ok || !data || data.ok !== true){
