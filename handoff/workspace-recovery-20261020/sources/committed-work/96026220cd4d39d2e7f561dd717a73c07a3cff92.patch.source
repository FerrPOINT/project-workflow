diff --git a/tests/test_postgres_test_guards.py b/tests/test_postgres_test_guards.py
new file mode 100644
index 0000000..a13fe9d
--- /dev/null
+++ b/tests/test_postgres_test_guards.py
@@ -0,0 +1,45 @@
+"""The integration suite must refuse implicit or foreign PostgreSQL targets."""
+import pytest
+from sqlalchemy import make_url
+
+from tests import test_postgres_integration as integration
+
+
+@pytest.fixture
+def explicit_postgres(monkeypatch):
+    values = {"PGHOST": "127.0.0.1", "PGPORT": "24567", "PGUSER": "qa_user",
+              "PGPASSWORD": "synthetic:@/ password", "PGDATABASE": "qa_admin",
+              "SDLC_PG_TEST_PROJECT": "sdlc-qa-project-workflow-pg-012345abcdef"}
+    for key, value in values.items():
+        monkeypatch.setenv(key, value)
+    monkeypatch.setattr(integration.psycopg, "connect", lambda **_: pytest.fail("No network call allowed"))
+    return values
+
+
+@pytest.mark.parametrize("missing", ["PGHOST", "PGPORT", "PGUSER", "PGPASSWORD", "PGDATABASE",
+                                     "SDLC_PG_TEST_PROJECT"])
+def test_missing_explicit_parameter_refuses_before_connection(explicit_postgres, monkeypatch, missing):
+    monkeypatch.delenv(missing)
+    with pytest.raises(pytest.fail.Exception, match="Explicit disposable PostgreSQL parameters required"):
+        integration._postgres_config()
+
+
+@pytest.mark.parametrize("field,value,message", [
+    ("PGHOST", "database.internal", "loopback"),
+    ("PGPORT", "abc", "loopback"),
+    ("PGPORT", "0", "loopback"),
+    ("PGPORT", "65536", "loopback"),
+    ("SDLC_PG_TEST_PROJECT", "sdlc1", "owned QA project"),
+    ("SDLC_PG_TEST_PROJECT", "sdlc-qa-foreign-012345abcdef", "owned QA project"),
+])
+def test_foreign_or_invalid_target_is_refused(explicit_postgres, monkeypatch, field, value, message):
+    monkeypatch.setenv(field, value)
+    with pytest.raises(pytest.fail.Exception, match=message):
+        integration._postgres_config()
+
+
+def test_test_url_preserves_reserved_password_characters(explicit_postgres):
+    settings = integration._postgres_config()
+    url = make_url(integration._test_database_url(settings, "qa_test_database"))
+    assert (url.host, url.port, url.username, url.password, url.database) == (
+        "127.0.0.1", 24567, "qa_user", explicit_postgres["PGPASSWORD"], "qa_test_database")
