diff --git a/scripts/qa_postgres.py b/scripts/qa_postgres.py
new file mode 100644
index 0000000..1128714
--- /dev/null
+++ b/scripts/qa_postgres.py
@@ -0,0 +1,92 @@
+"""Run Workflow integration tests against an owned disposable PostgreSQL."""
+from __future__ import annotations
+
+import argparse
+import importlib
+import os
+import secrets
+import subprocess
+import sys
+import uuid
+from pathlib import Path
+
+
+def main() -> int:
+    root = Path(__file__).resolve().parents[1]
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--docker-context", required=True)
+    parser.add_argument("--daemon-id")
+    parser.add_argument("--base-directory", type=Path, default=root.parent / "services-base")
+    parser.add_argument("--output", type=Path, default=root / ".local/postgres-integration")
+    args = parser.parse_args()
+    if not args.docker_context.strip():
+        parser.error("A nonempty Docker context is required; no default endpoint fallback")
+    base = args.base_directory.resolve()
+    verifier = base / "scripts/verify_base_revision.py"
+    if not verifier.is_file():
+        parser.error("Pinned Base sources are required; set --base-directory")
+    subprocess.run(
+        [sys.executable, str(verifier), "--revision", str(root / ".base-revision"), "--base", str(base)],
+        stdin=subprocess.DEVNULL, check=True,
+    )
+    sys.path.insert(0, str(base))
+    helpers = importlib.import_module("scripts.compose_helpers")
+    postgres = importlib.import_module("scripts.platform_postgres")
+    docker = ["docker", "--context", args.docker_context]
+    identity = helpers.checked(docker + ["info", "--format", "{{.ID}}"], text=True).strip()
+    if args.daemon_id is not None and identity != args.daemon_id:
+        raise RuntimeError("Daemon identity mismatch; no fallback")
+    image = "postgres:17.6-alpine"
+    if subprocess.run(docker + ["image", "inspect", image], capture_output=True, timeout=30).returncode:
+        helpers.checked(docker + ["pull", image], timeout=300)
+    project = "sdlc-qa-project-workflow-pg-" + uuid.uuid4().hex[:12]
+    directory = args.output.resolve() / project
+    task, purpose = "workflow-postgres", "integration-tests"
+    with helpers.ComposeHelper(
+        project=project, task=task, purpose=purpose, docker=docker, directory=directory,
+        daemon_id=identity,
+    ) as helper:
+        networks = helpers.disposable_subnets(docker, {"default": {
+            "name": project + "_default", "labels": {"sdlc.task": task, "sdlc.purpose": purpose},
+        }})
+        password = secrets.token_urlsafe(32)
+        helper.write({"postgres": {
+            "image": image, "tmpfs": ["/var/lib/postgresql/data"],
+            "ports": [{"target": 5432, "published": "0", "host_ip": "127.0.0.1"}],
+            "environment": {"POSTGRES_USER": "project_workflow", "POSTGRES_PASSWORD": password,
+                            "POSTGRES_DB": "project_workflow"},
+            "healthcheck": {"test": ["CMD", "pg_isready", "-U", "project_workflow", "-d", "project_workflow"],
+                            "interval": "1s", "timeout": "3s", "retries": 30},
+        }}, networks=networks)
+        helper.validate_execution()
+        helpers.checked(helper.command + ["up", "-d", "--wait", "--wait-timeout", "60", "postgres"])
+        version = helpers.checked(helper.command + ["exec", "-T", "postgres", "psql", "-U", "project_workflow",
+                                                   "-Atc", "SHOW server_version_num"], text=True).strip()
+        if version != "170006":
+            raise RuntimeError("Integration PostgreSQL must be version 17.6")
+        address = helpers.checked(helper.command + ["port", "postgres", "5432"], text=True).strip()
+        host, port = address.rsplit(":", 1)
+        if host != "127.0.0.1":
+            raise RuntimeError("Disposable PostgreSQL must publish on loopback")
+        env = {key: value for key, value in os.environ.items()
+               if not key.startswith(("PG", "DATABASE_URL", "AUTH_", "OPENAI_", "AI_", "PROJECT_WORKFLOW_",
+                                      "SDLC_PG_TEST_"))}
+        env.update(PGHOST=host, PGPORT=port, PGUSER="project_workflow", PGPASSWORD=password,
+                   PGDATABASE="project_workflow", SDLC_PG_TEST_PROJECT=project)
+        command = ["uv", "run", "--isolated", "--with-requirements", "constraints.txt", "--all-extras",
+                   "pytest", "-q", "-m", "integration", "tests/test_postgres_integration.py", "--timeout=120"]
+        helper.record("tests-running")
+        with (directory / "tests.log").open("w", encoding="utf-8") as output:
+            result = subprocess.run(command, cwd=root, env=env, stdin=subprocess.DEVNULL,
+                                    stdout=output, stderr=subprocess.STDOUT, timeout=1800)
+        postgres.write_json(directory / "acceptance.json", {
+            "project": project, "daemon_id": helper.identity, "exit_code": result.returncode,
+            "test_database": "disposable", "runtime_changed": False,
+        })
+        print("Workflow PostgreSQL integration:", "passed" if result.returncode == 0 else "failed",
+              "(protected diagnostics:", directory, ")")
+        return result.returncode
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/quality.ps1 b/scripts/quality.ps1
index 98531e5..a2d7de8 100644
--- a/scripts/quality.ps1
+++ b/scripts/quality.ps1
@@ -23,7 +23,12 @@ function Invoke-Test {
 }
 
 function Invoke-TestIntegration {
-    Invoke-Checked ($Uv + @("pytest", "-q", "-m", "integration", "tests/test_postgres_integration.py", "--timeout=120"))
+    if ([string]::IsNullOrWhiteSpace($DockerContext)) {
+        throw "test-integration requires an explicit -DockerContext; no workspace database fallback"
+    }
+    Invoke-Checked @("python", (Join-Path $PSScriptRoot "qa_postgres.py"),
+        "--docker-context", $DockerContext, "--base-directory", $BaseDirectory,
+        "--output", (Join-Path $PSScriptRoot "../.local/postgres-integration"))
 }
 
 function Invoke-Coverage {
@@ -58,17 +63,23 @@ function Invoke-ComposeReady {
         "--output", $ComposeOutput)
 }
 
-switch ($Target) {
-    "test" { Invoke-Test }
-    "test-integration" { Invoke-TestIntegration }
-    "coverage" { Invoke-Coverage }
-    "lint" { Invoke-Lint }
-    "quality" {
-        Invoke-Test
-        Invoke-TestIntegration
-        Invoke-Coverage
-        Invoke-Lint
+Push-Location (Split-Path $PSScriptRoot)
+try {
+    switch ($Target) {
+        "test" { Invoke-Test }
+        "test-integration" { Invoke-TestIntegration }
+        "coverage" { Invoke-Coverage }
+        "lint" { Invoke-Lint }
+        "quality" {
+            Invoke-Test
+            Invoke-TestIntegration
+            Invoke-Coverage
+            Invoke-Lint
+        }
+        "warnings" { Invoke-Warnings }
+        "compose-ready" { Invoke-ComposeReady }
     }
-    "warnings" { Invoke-Warnings }
-    "compose-ready" { Invoke-ComposeReady }
+}
+finally {
+    Pop-Location
 }
