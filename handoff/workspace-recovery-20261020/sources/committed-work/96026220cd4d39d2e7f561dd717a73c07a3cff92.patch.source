+class _PageRegions(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.headings: list[dict] = []
+        self.frames: list[dict] = []
+
+    def handle_starttag(self, tag, attrs):
+        attributes = dict(attrs)
+        if tag == "h1":
+            self.headings.append(attributes)
+        if "data-page-layout" in attributes:
+            self.frames.append(attributes)
+
+
+@pytest.mark.parametrize("route", ["/", "/agents", "/instructions", "/namespaces", "/namespaces/new",
+                                  "/phases", "/tasks", "/workflows", "/settings"])
+def test_ssr_content_region_is_named_by_its_page_heading(route):
+    response = client.get(route)
+    assert response.status_code == 200
+    parsed = _PageRegions()
+    parsed.feed(response.text)
+    assert len(parsed.frames) == 1
+    frame = parsed.frames[0]
+    assert frame["role"] == "region"
+    heading_id = frame["aria-labelledby"]
+    assert [heading for heading in parsed.headings if heading.get("id") == heading_id] == [
+        {"class": "header-title", "id": "workflow-page-title"}
+    ]
+    assert response.text.count('id="workflow-page-title"') == 1
+
+
+def test_selected_phase_instructions_keeps_the_named_reading_region():
+    phase = _phase_row("4.START")
+    response = client.get(f"/instructions?phase_id={phase['id']}")
+    assert response.status_code == 200
+    parsed = _PageRegions()
+    parsed.feed(response.text)
+    assert parsed.frames == [{"class": "page-readable", "data-page-layout": "reading",
+                              "role": "region", "aria-labelledby": "workflow-page-title"}]
+
+
