diff --git a/.env.example b/.env.example
index e7fa63d..6c44108 100644
--- a/.env.example
+++ b/.env.example
@@ -18,7 +18,9 @@ OPENAI_API_KEY=
 OPENAI_REASONING_EFFORT=none
 
 # Optional service catalog for cross-service links in the header.
-PLATFORM_SERVICES_URL=http://localhost:7771/api/v1/runtime/services
+# Leave unset for Compose to use host.docker.internal by default.
+# For a process running directly on the host, optionally override:
+# PLATFORM_SERVICES_URL=http://localhost:7771/api/v1/runtime/services
 
 # Optional Central Auth browser SSO. Keep AUTH_ISSUER public/browser-reachable
 # and AUTH_INTERNAL_BASE_URL reachable from this process/container.
diff --git a/project_workflow/interfaces/ui/platform_services.py b/project_workflow/interfaces/ui/platform_services.py
index 2a21131..def54d2 100644
--- a/project_workflow/interfaces/ui/platform_services.py
+++ b/project_workflow/interfaces/ui/platform_services.py
@@ -58,11 +58,11 @@ def _normalize(entry: dict[str, Any]) -> dict[str, Any] | None:
 
 
 def _with_request_host(services: list[dict[str, Any]], request_url: str | None) -> list[dict[str, Any]]:
-    """Make localhost fallback targets usable from a remote UI session."""
+    """Rewrite loopback targets for remote browsers, preserving local SSO origins."""
     if not request_url:
         return services
     request_host = urlsplit(request_url).hostname
-    if not request_host:
+    if not request_host or request_host in {"localhost", "127.0.0.1", "::1"}:
         return services
 
     adjusted: list[dict[str, Any]] = []
diff --git a/project_workflow/interfaces/ui/templates/base.html b/project_workflow/interfaces/ui/templates/base.html
index 9220657..cec2a21 100644
--- a/project_workflow/interfaces/ui/templates/base.html
+++ b/project_workflow/interfaces/ui/templates/base.html
@@ -113,7 +113,7 @@ button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,
 .service-menu summary:hover,.service-menu[open] summary{background:var(--surface-hover);color:var(--text);border-color:var(--accent)}
 .service-menu-chevron{font-size:11px;color:var(--text-muted);transition:transform .15s}
 .service-menu[open] .service-menu-chevron{transform:rotate(180deg)}
-.service-menu-popover{position:absolute;right:0;top:calc(100% + 8px);z-index:250;width:260px;max-width:calc(100vw - 24px);padding:6px;background:var(--surface);border:1px solid var(--border-strong);border-radius:8px;box-shadow:0 16px 40px rgba(0,0,0,.45)}
+.service-menu-popover{position:absolute;left:0;right:auto;top:calc(100% + 8px);z-index:250;width:260px;max-width:calc(100vw - 24px);max-height:calc(100dvh - var(--header-height) - 16px);overflow-y:auto;overscroll-behavior:contain;padding:6px;background:var(--surface);border:1px solid var(--border-strong);border-radius:8px;box-shadow:0 16px 40px rgba(0,0,0,.45)}
 .service-menu-item{min-height:40px;padding:8px 10px;border-radius:6px;display:flex;align-items:center;gap:10px;color:var(--text-secondary);text-decoration:none}
 .service-menu-item:hover,.service-menu-item:focus-visible{background:var(--surface-hover);color:var(--text);text-decoration:none}
 .service-menu-item[aria-current="page"]{background:var(--accent-soft);color:var(--text);font-weight:600}
@@ -302,7 +302,6 @@ textarea{resize:vertical;min-height:60px}
   .card-value{font-size:22px}
   .header-title{font-size:14px}
   .namespace-switcher .namespace-select{min-width:0;flex:1 1 72px}
-  .service-menu-popover{left:0;right:auto}
 }
 
