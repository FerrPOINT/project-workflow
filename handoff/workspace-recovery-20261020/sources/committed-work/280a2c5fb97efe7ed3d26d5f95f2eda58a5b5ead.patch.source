++def test_concurrent_catalog_reads_share_fetch_without_sharing_request_host(monkeypatch):
++    from project_workflow.interfaces.ui import platform_services as ps
++
++    started = Event()
++    release = Event()
++    ready = Barrier(8)
++    calls = []
++
++    def response(url, **_kwargs):
++        calls.append(url)
++        started.set()
++        assert release.wait(timeout=5)
++        return _response(_runtime_services())
++
++    def read(index):
++        ready.wait(timeout=5)
++        return load_service_catalog("http://admin/api", request_url=f"http://browser-{index}:7752/tasks")
++
++    monkeypatch.setattr(ps, "urlopen", response)
++    with ThreadPoolExecutor(max_workers=8) as executor:
++        futures = [executor.submit(read, index) for index in range(8)]
++        try:
++            assert started.wait(timeout=5)
++        finally:
++            release.set()
++        results = [future.result(timeout=5) for future in futures]
++    assert calls == ["http://admin/api"]
++    for index, catalog in enumerate(results):
++        assert catalog.source == "runtime"
++        assert [service["url"] for service in catalog.services] == [
