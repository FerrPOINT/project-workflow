--- /dev/null
+++ b/tests/test_ui_catalog_latency.py
@@@ -1,0 -1,0 +1,55 @@@
++"""Slow optional catalog reads must not block unrelated ASGI requests."""
++
++from concurrent.futures import ThreadPoolExecutor, TimeoutError
++from threading import Event
++
++import pytest
++from fastapi.testclient import TestClient
++
++from project_workflow.interfaces.ui import app
++from project_workflow.interfaces.ui.platform_services import ServiceCatalog
++from project_workflow.interfaces.ui.routes import pages
++
++pytestmark = [pytest.mark.ui]
++
++
++@pytest.mark.parametrize(("method", "path", "status"), [
++    ("GET", "/agents", 200),
++    ("GET", "/phase/0", 422),
++    ("GET", "/missing-page", 404),
++    ("POST", "/settings", 405),
++])
++def test_health_remains_available_while_html_waits_for_catalog(monkeypatch, method, path, status):
++    entered = Event()
++    release = Event()
++
++    def slow_catalog(*_args, **_kwargs):
++        entered.set()
++        assert release.wait(timeout=10), "Catalog test was not released"
++        return ServiceCatalog([], "fallback-unreachable")
++
++    monkeypatch.setattr(pages, "load_service_catalog", slow_catalog)
++    with TestClient(app) as client, ThreadPoolExecutor(max_workers=2) as executor:
++        expected_health = client.get("/health")
++        assert expected_health.status_code in (200, 503)
++        html = executor.submit(client.request, method, path)
++        health = None
++        responsive = False
++        try:
++            assert entered.wait(timeout=5), "HTML did not reach the optional catalog"
++            health = executor.submit(client.get, "/health")
++            try:
++                response = health.result(timeout=2)
++                responsive = response.status_code == expected_health.status_code and not release.is_set()
++            except TimeoutError:
++                pass
++        finally:
++            release.set()
++            assert html.result(timeout=10).status_code == status
++            if health is not None:
++                actual_body = health.result(timeout=10).json()
++                expected_body = expected_health.json()
++                actual_body.pop("db_latency_ms")
++                expected_body.pop("db_latency_ms")
++                assert actual_body == expected_body
++        assert responsive, "Optional catalog I/O blocked /health on the ASGI event loop"
diff --cc tests/test_ui_shell_section_fields.py
index 0000000,0000000..0e743ef
new file mode 100644
--- /dev/null
+++ b/tests/test_ui_shell_section_fields.py
@@@ -1,0 -1,0 +1,65 @@@
++from html.parser import HTMLParser
++
++from project_workflow.interfaces.ui.templates import env
++
++
++class SelectFields(HTMLParser):
++    def __init__(self) -> None:
++        super().__init__()
++        self.divs: list[str] = []
++        self.labels: set[str | None] = set()
++        self.controls: dict[str, dict[str, str | None]] = {}
++        self.options: dict[str, list[str | None]] = {}
++        self.current: str | None = None
++
++    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
++        attributes = dict(attrs)
++        if tag == "div":
++            self.divs.append(attributes.get("class") or "")
++        if tag == "label" and "base-form-field" in self.divs:
++            self.labels.add(attributes.get("for"))
++        if tag == "select":
++            identifier = attributes.get("id")
++            self.current = identifier if identifier in {"sidebarThemeSelector", "phaseSectionSelect"} else None
++            if self.current:
++                assert "base-form-field" in self.divs
++                assert self.current not in self.controls
++                self.controls[self.current] = attributes
++                self.options[self.current] = []
++        if tag == "option" and self.current:
++            self.options[self.current].append(attributes.get("value"))
++
++    def handle_endtag(self, tag: str) -> None:
++        if tag == "div":
++            self.divs.pop()
++        if tag == "select":
++            self.current = None
++
++
++def fields(html: str) -> SelectFields:
++    parser = SelectFields()
++    parser.feed(html)
++    parser.close()
++    assert set(parser.controls) <= parser.labels
++    for control in parser.controls.values():
++        assert "base-control" in (control["class"] or "").split()
++    return parser
++
++
++def test_drawer_theme_uses_base_field_and_preserves_theme_callback() -> None:
++    parser = fields(env.get_template("base.html").render())
++    assert parser.controls["sidebarThemeSelector"]["onchange"] == "setPlatformTheme(this.value)"
++    assert "theme-select" in (parser.controls["sidebarThemeSelector"]["class"] or "").split()
++    assert parser.options["sidebarThemeSelector"] == ["dark", "gray", "light"]
++
++
++def test_phase_section_uses_base_field_and_preserves_section_values() -> None:
++    phase = {
++        "id": 7, "workflow_id": 1, "mode_id": None, "name": "Safe phase",
++        "instructions": [], "checks": [], "evidence": [],
++    }
++    parser = fields(env.get_template("phase_detail.html").render(page="phases", phase=phase))
++    assert parser.options["phaseSectionSelect"] == [
++        "phase-overview", "phase-instructions", "phase-checks", "phase-evidence",
++    ]
++    assert "onchange" not in parser.controls["phaseSectionSelect"]
