+def test_workspace_launch_guidance_uses_base_and_keeps_runtime_separate_from_qa() -> None:
+    agents = (ROOT / "AGENTS.md").read_text(encoding="utf-8")
+    quality_gate = (ROOT / "docs" / "quality-gate.md").read_text(encoding="utf-8")
+    readme = (ROOT / "README.md").read_text(encoding="utf-8")
+
+    for content in (agents, quality_gate, readme):
+        assert "start-local.ps1 -Workspace sdlc1" in content
+        assert "LOCAL_GROUPS.md" in content
+    assert "docker compose up --build -d --wait" not in agents
+    assert "docker compose up --build -d --wait" not in quality_gate
+    assert "sdlc-qa-<task>-<unique>" in quality_gate
+    assert "runtime DB" in quality_gate
+    assert "compose-ready" in quality_gate
+    assert "до миграции" in quality_gate
+    assert "7752/health" in quality_gate
+    assert "Standalone-примеры ниже" in readme
+    assert "вне общего workspace" in readme
+
+
