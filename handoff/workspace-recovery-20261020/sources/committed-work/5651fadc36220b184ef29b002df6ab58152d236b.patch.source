new file mode 100644
index 0000000..7cf2c83
--- /dev/null
+++ b/docs/ui-evidence/2026-10-01/workflow-isolated-interactions.json
@@ -0,0 +1,40 @@
+{
+  "jinjaTrap": {
+    "focusInsideDrawer": true,
+    "name": "Закрыть навигацию"
+  },
+  "jinjaReturn": {
+    "dialogOpen": false,
+    "focus": "Открыть навигацию"
+  },
+  "reactTrap": {
+    "focusInsideDrawer": true,
+    "name": "Фазы"
+  },
+  "reactReturn": {
+    "dialogVisible": false,
+    "focus": "Открыть навигацию"
+  },
+  "history": [
+    {
+      "step": "select",
+      "url": "http://127.0.0.1:18862/react/tasks?namespace_id=2",
+      "value": "2"
+    },
+    {
+      "step": "back",
+      "url": "http://127.0.0.1:18862/react/tasks?namespace_id=1",
+      "value": "1"
+    },
+    {
+      "step": "forward",
+      "url": "http://127.0.0.1:18862/react/tasks?namespace_id=2",
+      "value": "2"
+    },
+    {
+      "step": "reload",
+      "url": "http://127.0.0.1:18862/react/tasks?namespace_id=2",
+      "value": "2"
+    }
+  ]
+}
