diff --git a/scripts/verify_readme.py b/scripts/verify_readme.py
index 9ab8929..72581c4 100644
--- a/scripts/verify_readme.py
+++ b/scripts/verify_readme.py
@@ -3,6 +3,7 @@
 
 from __future__ import annotations
 
+import json
 import re
 import sys
 from pathlib import Path
@@ -17,11 +18,6 @@ REQUIRED_ANCHORS = {
     "quality",
     "license",
 }
-REQUIRED_PROOF = {
-    "docs/screenshots/dashboard.png",
-    "docs/screenshots/settings.png",
-    "docs/screenshots/task-detail-dev.png",
-}
 MD_IMAGE_RE = re.compile(r"!\[[^]]*\]\(([^)]+)\)")
 HTML_IMAGE_RE = re.compile(r"<img\b[^>]*\bsrc=[\"']([^\"']+)[\"']", re.IGNORECASE)
 ANCHOR_RE = re.compile(r"<a\b[^>]*\bname=[\"']([^\"']+)[\"']", re.IGNORECASE)
@@ -44,7 +40,18 @@ def validate(root: Path) -> list[str]:
         findings.append("RMD003: README.md: placeholder or local filesystem path")
 
     images = MD_IMAGE_RE.findall(text) + HTML_IMAGE_RE.findall(text)
-    for proof in sorted(REQUIRED_PROOF):
+    try:
+        manifest = json.loads((root / "docs/screenshots/manifest.json").read_text(encoding="utf-8"))
+        captures = manifest["captures"]
+        if manifest["schemaVersion"] != 1 or not isinstance(captures, list):
+            raise ValueError("invalid capture manifest")
+        proofs = {capture["file"] for capture in captures if capture.get("readme") is True}
+        if not proofs or not all(isinstance(proof, str) for proof in proofs):
+            raise ValueError("missing README capture paths")
+    except (OSError, ValueError, KeyError, TypeError, AttributeError):
+        findings.append("RMD004: README.md: missing or invalid screenshot manifest")
+        proofs = set()
+    for proof in sorted(proofs):
         if proof not in images:
             findings.append(f"RMD004: README.md: missing proof asset: {proof}")
 
diff --git a/tests/test_docs_quality.py b/tests/test_docs_quality.py
index 47ff208..f0d2365 100644
--- a/tests/test_docs_quality.py
+++ b/tests/test_docs_quality.py
@@ -1,6 +1,8 @@
 """Regression checks for user-facing documentation."""
 
+import hashlib
 import importlib.util
+import json
 import struct
 from pathlib import Path
 
@@ -135,18 +137,18 @@ def test_quality_gate_ui_smoke_matches_settings_screenshot() -> None:
 def test_readme_screenshots_are_real_full_size_pngs() -> None:
     screenshots_dir = ROOT / "docs" / "screenshots"
 
-    for name in ["namespaces.png"]:
+    for name in ["base-wide.png", "base-reading.png", "base-detail-with-aside.png"]:
         width, height = _png_size(screenshots_dir / name)
-        assert width >= 390, f"{name} width {width} is below 390"
-        assert height >= 844, f"{name} height {height} is below 844"
+        assert width == 1920, f"{name} width {width} is not the desktop capture width"
+        assert height >= 1080, f"{name} height {height} is below the capture viewport"
 
 
 def test_readme_presents_one_desktop_example_per_layout_mode() -> None:
     section = _readme_screenshots_section()
 
-    assert '](docs/screenshots/dashboard.png)' in section
-    assert '](docs/screenshots/settings.png)' in section
-    assert '](docs/screenshots/task-detail-dev.png)' in section
+    assert '](docs/screenshots/base-wide.png)' in section
+    assert '](docs/screenshots/base-reading.png)' in section
+    assert '](docs/screenshots/base-detail-with-aside.png)' in section
     assert "docs/screenshots/375x812/" not in section
     assert "(`wide`)" in section
     assert "(`reading/form`)" in section
@@ -155,12 +157,46 @@ def test_readme_presents_one_desktop_example_per_layout_mode() -> None:
     assert "RUN-42" not in section
 
 
+def test_desktop_gallery_manifest_matches_original_images_and_source_scope() -> None:
+    manifest = json.loads((ROOT / "docs/screenshots/manifest.json").read_text(encoding="utf-8"))
+    assert manifest["schemaVersion"] == 1
+    assert manifest["runtime"]["kind"] == "isolated-python-process"
+    assert manifest["runtime"]["ssoVerified"] is False
+    assert manifest["acceptanceStatus"] == "pending"
+    assert {capture["layout"] for capture in manifest["captures"]} == {
+        "wide", "reading", "detail-with-aside"
+    }
+    readme = (ROOT / "README.md").read_text(encoding="utf-8")
+    for capture in manifest["captures"]:
+        image = (ROOT / capture["file"]).read_bytes()
+        assert hashlib.sha256(image).hexdigest() == capture["imageSha256"]
+        assert capture["viewport"] == {"width": 1920, "height": 1080}
+        assert capture["theme"] == "dark"
+        assert capture["fullPage"] is True
+        assert capture["safeData"] is True
+        assert len(capture["productSha"]) == len(capture["baseSha"]) == 40
+        assert len(capture["productFingerprint"]) == len(capture["baseFingerprint"]) == 64
+        assert f'![{capture["caption"]}]({capture["file"]})' in readme
+
+
 def test_readme_validator_accepts_committed_root_readme() -> None:
     validator = _load_readme_validator()
 
     assert validator.validate(ROOT) == []
 
 
+def test_readme_validator_rejects_malformed_capture_manifest(tmp_path: Path) -> None:
+    (tmp_path / "README.md").write_text(
+        (ROOT / "README.md").read_text(encoding="utf-8"), encoding="utf-8"
+    )
+    captures = tmp_path / "docs/screenshots"
+    captures.mkdir(parents=True)
+    (captures / "manifest.json").write_text('{"schemaVersion": 1}', encoding="utf-8")
+    assert "RMD004: README.md: missing or invalid screenshot manifest" in (
+        _load_readme_validator().validate(tmp_path)
+    )
+
+
 def test_screenshot_capture_script_checks_full_smoke_data() -> None:
     source = (ROOT / "scripts" / "capture_ui_screenshots.mjs").read_text(encoding="utf-8")
 
