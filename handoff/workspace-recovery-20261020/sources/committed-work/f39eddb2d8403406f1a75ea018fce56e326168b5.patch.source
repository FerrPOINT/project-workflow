diff --git a/project_workflow/interfaces/ui/templates/phase_save.js b/project_workflow/interfaces/ui/templates/phase_save.js
new file mode 100644
index 0000000..1de71f7
--- /dev/null
+++ b/project_workflow/interfaces/ui/templates/phase_save.js
@@ -0,0 +1,259 @@
+let phaseSavePending = false;
+let phaseInstructionPending = false;
+let phaseSaveDeferred = false;
+let phaseUnknownSave = null;
+let phaseSaveTerminal = null;
+let phaseSaveBaseline;
+let phaseRowSequence = 0;
+let _saveTimer = null;
+const phaseDisabledControls = new Map();
+
+function phaseAggregateLocked() {
+  return phaseSavePending || phaseInstructionPending || Boolean(phaseUnknownSave || phaseSaveTerminal);
+}
+
+function phaseTextRows(kind) {
+  return Array.from(document.querySelectorAll(`#${kind}-list li:not(.empty-state)`)).map((node) => {
+    if (!node.dataset.phaseRowKey) node.dataset.phaseRowKey = String(++phaseRowSequence);
+    return {node, key: node.dataset.phaseRowKey, id: node.dataset.id ? Number(node.dataset.id) : null,
+      value: node.querySelector('[data-field="description"]').value};
+  });
+}
+
+function phaseDraftSnapshot() {
+  const header = document.querySelector('.wiki-header');
+  const raw = {
+    name: header.querySelector('[data-field="name"]').value,
+    description: header.querySelector('[data-field="description"]').value,
+    execution_type: header.querySelector('.execution-toggle').dataset.mode || 'sync',
+    parallel_with_phase_id: document.getElementById('parallelPartnerSelect')?.value || '',
+    agent_id: document.getElementById('agentSelect').value,
+  };
+  for (const kind of ['checks', 'evidence']) raw[kind] = phaseTextRows(kind).map(({key, id, value}) => ({key, id, value}));
+  return raw;
+}
+
+function phaseMetadataDirty() {
+  return Boolean(phaseUnknownSave) || JSON.stringify(phaseDraftSnapshot()) !== phaseSaveBaseline;
+}
+
+function phaseInstructionsDirty(except = null) {
+  return Array.from(document.querySelectorAll('.timeline-name-input,.skill-candidate')).some((input) => input !== except
+    && (input.classList.contains('skill-candidate') ? Boolean(input.value.trim()) : input.value !== input.dataset.originalDescription));
+}
+
+function phaseDraftDirty() {
+  return phaseMetadataDirty() || phaseInstructionsDirty();
+}
+
+function beginPhaseInstructionChange(draft = null, reloads = true) {
+  if (phaseAggregateLocked()) return false;
+  // Reload-based instruction actions must not discard another editor's draft.
+  if (reloads && (phaseMetadataDirty() || phaseInstructionsDirty(draft))) {
+    showPhaseSaveState('error', 'Сначала сохраните остальные изменения. Черновик сохранён на странице.');
+    refreshWorkflowDraftGuard();
+    return false;
+  }
+  phaseInstructionPending = true;
+  showPhaseSaveState('loading', 'Сохранение инструкции…');
+  updatePhaseSaveControls();
+  return true;
+}
+
+function endPhaseInstructionChange() {
+  phaseInstructionPending = false;
+  if (document.getElementById('phaseSaveStatus').dataset.pageState === 'loading') showPhaseSaveState('empty', '');
+  updatePhaseSaveControls();
+  updateInstructionControls();
+  if (phaseSaveDeferred) {
+    phaseSaveDeferred = false;
+    if (phaseMetadataDirty()) scheduleSave();
+  }
+}
+
+function reloadPhaseAfterInstruction() {
+  endPhaseInstructionChange();
+  return navigateWorkflow(window.location.href);
+}
+
+function showPhaseSaveState(kind, message) {
+  const state = document.getElementById('phaseSaveStatus');
+  state.hidden = !message;
+  state.dataset.pageState = kind;
+  state.setAttribute('role', ['error', 'partial-error'].includes(kind) ? 'alert' : 'status');
+  state.setAttribute('aria-busy', String(kind === 'loading'));
+  state.querySelector('p').textContent = message || '';
+}
+
+function updatePhaseSaveControls() {
+  const locked = phaseAggregateLocked();
+  const controls = document.querySelectorAll('.wiki-page input,.wiki-page textarea,.wiki-page select,.wiki-page button');
+  for (const control of controls) {
+    if (locked) {
+      if (!phaseDisabledControls.has(control)) phaseDisabledControls.set(control, control.disabled);
+      control.disabled = true;
+    } else if (phaseDisabledControls.has(control)) {
+      control.disabled = phaseDisabledControls.get(control);
+    }
+  }
+  if (!locked) phaseDisabledControls.clear();
+  document.querySelector('.wiki-page').setAttribute('aria-busy', String(phaseSavePending || phaseInstructionPending));
+  const reconcile = document.getElementById('phaseSaveReconcile');
+  reconcile.hidden = !phaseUnknownSave || Boolean(phaseSaveTerminal);
+  reconcile.disabled = phaseSavePending;
+  refreshWorkflowDraftGuard();
+}
+
+function capturePhaseSave() {
+  const raw = phaseDraftSnapshot();
+  const rows = {};
+  const data = {name: raw.name.trim(), description: raw.description, execution_type: raw.execution_type,
+    parallel_with_phase_id: raw.execution_type === 'parallel' && raw.parallel_with_phase_id ? Number(raw.parallel_with_phase_id) : null,
+    agent_id: raw.agent_id ? Number(raw.agent_id) : null};
+  if (!data.name) throw new Error('Название фазы обязательно');
+  for (const kind of ['checks', 'evidence']) {
+    rows[kind] = phaseTextRows(kind).filter((row) => row.value.trim());
+    if (phaseTextRows(kind).some((row) => row.id !== null && !row.value.trim())) throw new Error('Описание обязательно');
+    data[kind] = rows[kind].map(({id, value}) => ({id, description: value.trim()}));
+  }
+  return {raw, rows, data, ids: null, returnFocus: document.activeElement};
+}
+
+function validPhaseSaveIds(attempt, ids) {
+  if (!ids || typeof ids !== 'object') return false;
+  return ['checks', 'evidence'].every((kind) => Array.isArray(ids[kind]) && ids[kind].length === attempt.rows[kind].length
+    && new Set(ids[kind]).size === ids[kind].length && ids[kind].every((id, index) => Number.isInteger(id) && id > 0
+      && (attempt.rows[kind][index].id === null || attempt.rows[kind][index].id === id)));
+}
+
+function phaseSaveMatches(attempt, phase) {
+  if (!phase || phase.id !== phaseId || phase.workflow_id !== phaseWorkflowId || phase.mode_id !== phaseModeId) return false;
+  for (const key of ['name', 'description', 'execution_type', 'parallel_with_phase_id', 'agent_id']) {
+    if (phase[key] !== attempt.data[key]) return false;
+  }
+  for (const kind of ['checks', 'evidence']) {
+    const saved = phase[kind];
+    if (!Array.isArray(saved) || saved.length !== attempt.rows[kind].length || new Set(saved.map((row) => row.id)).size !== saved.length) return false;
+    for (let index = 0; index < attempt.rows[kind].length; index++) {
+      const id = attempt.ids ? attempt.ids[kind][index] : attempt.rows[kind][index].id;
+      // A missing create ACK cannot identify a new entity by name or list position.
+      if (!Number.isInteger(id) || id <= 0) return false;
+      const row = saved.find((item) => item.id === id);
+      if (!row || row.phase_id !== phaseId || row.description !== attempt.data[kind][index].description) return false;
+    }
+  }
+  return true;
+}
+
+function finishPhaseSave(attempt) {
+  for (const kind of ['checks', 'evidence']) {
+    if (attempt.rows[kind].some((row) => !row.node.isConnected || row.node.dataset.phaseRowKey !== row.key
+      || (row.node.dataset.id ? Number(row.node.dataset.id) : null) !== row.id)) return false;
+  }
+  const baseline = structuredClone(attempt.raw);
+  for (const kind of ['checks', 'evidence']) {
+    attempt.rows[kind].forEach((row, index) => {
+      const id = attempt.ids ? attempt.ids[kind][index] : row.id;
+      row.node.dataset.id = String(id);
+      baseline[kind].find((item) => item.key === row.key).id = id;
+    });
+  }
+  phaseSaveBaseline = JSON.stringify(baseline);
+  phaseUnknownSave = null;
+  showPhaseSaveState('empty', '');
+  showToast('Сохранено', 'success');
+  return true;
+}
+
+function phaseSaveTerminalResponse(status) {
+  if (![401, 403, 404].includes(status)) return false;
+  phaseSaveTerminal = status === 404 ? 'not-found' : 'permission-denied';
+  showPhaseSaveState(phaseSaveTerminal, status === 404 ? 'Фаза не найдена. Черновик сохранён на странице.' : 'Нет доступа к сохранению. Черновик сохранён на странице.');
+  return true;
+}
+
+async function readPhaseSave(attempt) {
+  try {
+    const response = await fetch(phaseApiUrl(`/api/phases/${phaseId}`));
+    if (phaseSaveTerminalResponse(response.status)) return false;
+    const result = await response.json();
+    if (response.ok && result.ok === true && phaseSaveMatches(attempt, result.phase) && finishPhaseSave(attempt)) return true;
+  } catch (_error) {}
+  showPhaseSaveState('partial-error', 'Результат сохранения не подтверждён. Проверьте состояние; повторная запись заблокирована, черновик сохранён.');
+  return false;
+}
+
+function scheduleSave() {
+  if (_saveTimer) clearTimeout(_saveTimer);
+  if (phaseInstructionPending) { phaseSaveDeferred = true; return; }
+  if (phaseAggregateLocked()) return;
+  _saveTimer = setTimeout(savePhase, 400);
+  refreshWorkflowDraftGuard();
+}
+
+async function savePhase() {
+  if (_saveTimer) clearTimeout(_saveTimer);
+  _saveTimer = null;
+  if (phaseInstructionPending) { phaseSaveDeferred = true; return false; }
+  if (phaseAggregateLocked()) return false;
+  let attempt;
+  try { attempt = capturePhaseSave(); }
+  catch (error) { showPhaseSaveState('error', error.message); refreshWorkflowDraftGuard(); return false; }
+  phaseSavePending = true;
+  showPhaseSaveState('loading', 'Сохранение фазы…');
+  updatePhaseSaveControls();
+  try {
+    const response = await fetch(phaseApiUrl(`/api/phases/${phaseId}`), {
+      method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(attempt.data),
+    });
+    if (phaseSaveTerminalResponse(response.status)) return false;
+    if (response.status >= 400 && response.status < 500 && response.status !== 408) {
+      showPhaseSaveState('error', 'Не удалось сохранить фазу. Исправьте данные; черновик сохранён.');
+      return false;
+    }
+    const result = await response.json().catch(() => null);
+    if (response.ok && result?.ok === true && validPhaseSaveIds(attempt, result.ids)) attempt.ids = structuredClone(result.ids);
+  } catch (_error) {}
+  finally {
+    // The lock remains held while the authoritative GET runs below.
+    if (phaseSaveTerminal || document.getElementById('phaseSaveStatus').dataset.pageState === 'error') {
+      phaseSavePending = false;
+      updatePhaseSaveControls();
+      if (!phaseAggregateLocked()) restorePhaseSaveFocus(attempt);
+    }
+  }
+  phaseUnknownSave = attempt;
+  try { return await readPhaseSave(attempt); }
+  finally {
+    phaseSavePending = false;
+    updatePhaseSaveControls();
+    if (!phaseAggregateLocked()) restorePhaseSaveFocus(attempt);
+  }
+}
+
+function restorePhaseSaveFocus(attempt) {
+  const target = attempt.returnFocus;
+  if (target?.isConnected && !target.disabled && target !== document.body) target.focus();
+  else document.querySelector('.wiki-header [data-field="name"]').focus();
+}
+
+async function reconcilePhaseSave() {
+  if (phaseSavePending || phaseSaveTerminal || !phaseUnknownSave) return;
+  const attempt = phaseUnknownSave;
+  phaseSavePending = true;
+  showPhaseSaveState('loading', 'Проверка сохранения…');
+  updatePhaseSaveControls();
+  try { await readPhaseSave(attempt); }
+  finally {
+    phaseSavePending = false;
+    updatePhaseSaveControls();
+    if (!phaseAggregateLocked()) restorePhaseSaveFocus(attempt);
+  }
+}
+
+document.addEventListener('DOMContentLoaded', () => {
+  phaseSaveBaseline = JSON.stringify(phaseDraftSnapshot());
+  document.getElementById('phaseSaveReconcile').addEventListener('click', reconcilePhaseSave);
+  updatePhaseSaveControls();
+});
+registerWorkflowDraftGuard({isDirty: phaseDraftDirty, isPending: () => phaseSavePending || phaseInstructionPending});
