diff --git a/CHANGELOG.md b/CHANGELOG.md
index 2a3eb22..fe1aa70 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -7,6 +7,18 @@
 ## [Unreleased]
 
 ### Changed
+- Автосохранение деталей фазы использует снимок одной попытки и стабильные
+  локальные ключи checks/evidence вместо позднего чтения DOM и очереди функций.
+  Общий pending/unknown lock защищает controls и переходы через Base draft guard.
+  Подтверждение требует scoped GET; ID новых строк берутся только из проверенного
+  ACK, потерянный ACK не заменяется поиском по имени. Ошибка сохраняет черновик,
+  403/404 отключают запись; API, схема БД и runtime pins не меняются.
+  Запись инструкций и порядка разделяет тот же pending lock; черновики текста
+  и навыков защищены Base navigation guard. Ошибка текста не сбрасывает ввод,
+  reload-based действия не затирают другой draft. Unknown reconciliation
+  инструкций/reorder остаётся отдельным открытым пунктом.
+  Отложенный metadata autosave возобновляется после settlement инструкции,
+  без параллельного PUT и повторной записи неизменённой фазы.
 - Каталог фаз использует Base SSR controls/states и общий navigation guard.
   Создание, порядок, режим и удаление имеют единую блокировку записи. Создание,
   порядок и режим подтверждаются scoped GET-каталогом; неизвестный результат не повторяется,
diff --git a/frontend/e2e/phase-detail-save.spec.ts b/frontend/e2e/phase-detail-save.spec.ts
new file mode 100644
index 0000000..67e72f8
--- /dev/null
+++ b/frontend/e2e/phase-detail-save.spec.ts
@@ -0,0 +1,502 @@
+import { expect, test, type Page } from '@playwright/test'
+
+if (process.env.WORKFLOW_UI_QA_MUTATIONS !== 'isolated-fixture') throw new Error('Phase detail QA requires an isolated fixture')
+
+let workflowId: number
+let phaseId: number
+let namespaceId: number
+const pageUrl = () => `/phase/${phaseId}?namespace_id=${namespaceId}&foreign=keep`
+const saveState = (page: Page) => page.locator('#phaseSaveStatus')
+const name = (page: Page) => page.locator('.wiki-header [data-field="name"]')
+const save = (page: Page) => page.evaluate(() => (window as unknown as { savePhase: () => Promise<boolean> }).savePhase())
+
+test.beforeEach(async ({ request }) => {
+  workflowId = 0
+  namespaceId = 0
+  const created = await request.post('/api/workflows', { data: { name: `Phase save ${crypto.randomUUID()}` } })
+  expect(created.ok()).toBeTruthy()
+  workflowId = (await created.json()).workflow_id as number
+  const namespace = await request.post('/api/namespaces', { data: { name: `Phase save QA ${crypto.randomUUID()}`, cli_command: `save-${crypto.randomUUID()}`, workflow_id: workflowId } })
+  expect(namespace.ok()).toBeTruthy()
+  namespaceId = (await namespace.json()).namespace_id as number
+  const phases = await request.get(`/api/phases?workflow_id=${workflowId}`)
+  phaseId = (await phases.json()).phases[0].id as number
+  const updated = await request.put(`/api/phases/${phaseId}`, { data: { name: 'Phase baseline', checks: [{ id: null, description: 'First check' }], evidence: [] } })
+  expect(updated.ok(), await updated.text()).toBeTruthy()
+})
+
+for (const theme of ['dark', 'gray', 'light']) {
+  test(`phase detail aggregate native rows, geometry and focus (${theme})`, async ({ page, request }, testInfo) => {
+    expect((await request.put(`/api/phases/${phaseId}`, { data: { name: 'Длинное название фазы '.repeat(10), description: 'Длинное описание '.repeat(60) } })).ok()).toBeTruthy()
+    for (const step of [1, 2]) expect((await request.post(`/api/instructions?namespace_id=${namespaceId}`, { data: { phase_id: phaseId, description: 'Длинное описание инструкции '.repeat(12), step_num: step } })).ok()).toBeTruthy()
+    await page.addInitScript(value => localStorage.setItem('workflow-theme', value), theme)
+    const errors: string[] = []
+    page.on('pageerror', error => errors.push(error.message))
+    const widths = testInfo.project.name === 'desktop' ? [1023, 1024, 1279, 1280, 1440, 1920, 2560] : [375, 767, 768]
+    for (const width of widths) {
+      await page.setViewportSize({ width, height: 1080 })
+      await page.goto(pageUrl())
+      await page.reload()
+      await expect(page.locator('[data-page-layout]')).toHaveAttribute('data-page-layout', 'detail-with-aside')
+      expect(await page.evaluate(() => document.documentElement.scrollWidth - innerWidth)).toBe(0)
+      const geometry = await page.evaluate(() => ({ left: document.querySelector('.page-frame')!.getBoundingClientRect().left, header: document.querySelector('.base-ssr-header')!.getBoundingClientRect().height }))
+      expect(geometry.left).toBe(width >= 1280 ? 264 : width >= 768 ? 72 : 0)
+      expect(geometry.header).toBe(60)
+      for (const control of [name(page), page.locator('#checks-list .item-delete').first()]) {
+        const bounds = (await control.boundingBox())!
+        expect(bounds.height).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
+      }
+      if ([375, 1920].includes(width)) await page.screenshot({ path: testInfo.outputPath(`phase-detail-${theme}-${width}.png`), fullPage: true })
+    }
+    await page.getByRole('button', { name: '+ Добавить проверку', exact: true }).click()
+    await page.locator('#checks-list textarea').last().fill('New stable check')
+    await page.getByRole('button', { name: '+ Добавить подтверждение', exact: true }).click()
+    await page.locator('#evidence-list textarea').last().fill('New stable evidence')
+    await expect(name(page)).toBeEnabled()
+    expect(await save(page)).toBe(true)
+    const after = (await (await request.get(`/api/phases/${phaseId}`)).json()).phase
+    expect(after.checks.map((row: { description: string }) => row.description)).toEqual(['First check', 'New stable check'])
+    expect(after.evidence.map((row: { description: string }) => row.description)).toEqual(['New stable evidence'])
+    await expect(page.locator('#checks-list li').last()).toHaveAttribute('data-id', String(after.checks[1].id))
+    await expect(page.locator('#evidence-list li').first()).toHaveAttribute('data-id', String(after.evidence[0].id))
+    await page.locator('.wiki-header a').click()
+    await expect(page).toHaveURL(/\/phases\?/)
+    expect(errors).toEqual([])
+  })
+}
+
+for (const status of [401, 403, 404, 409, 422, 408, 500]) {
+  test(`phase detail aggregate preserves draft and classifies HTTP ${status}`, async ({ page, request }) => {
+    await page.goto(pageUrl())
+    let writes = 0
+    await page.route(`**/api/phases/${phaseId}*`, async route => {
+      if (route.request().method() !== 'PUT') return route.continue()
+      writes++
+      await route.fulfill({ status, json: { ok: false, error: 'Fixture response' } })
+    })
+    await name(page).fill('Retained draft')
+    expect(await save(page)).toBe(false)
+    await expect(name(page)).toHaveValue('Retained draft')
+    const terminal = [401, 403, 404].includes(status)
+    const unknown = [408, 500].includes(status)
+    await expect(saveState(page)).toHaveAttribute('data-page-state', status === 404 ? 'not-found' : terminal ? 'permission-denied' : unknown ? 'partial-error' : 'error')
+    if (terminal || unknown) {
+      await expect(name(page)).toBeDisabled()
+      await expect(page.locator('#checks-list .item-delete')).toBeDisabled()
+    } else await expect(name(page)).toBeEnabled()
+    if (unknown) {
+      expect(await save(page)).toBe(false)
+      await page.locator('#phaseSaveReconcile').click()
+      await expect(saveState(page)).toHaveAttribute('data-page-state', 'partial-error')
+    }
+    expect(writes).toBe(1)
+    expect((await (await request.get(`/api/phases/${phaseId}`)).json()).phase.name).toBe('Phase baseline')
+  })
+}
+
+test('phase detail aggregate lost ACK recovers existing IDs without replay', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  let writes = 0
+  await page.route(`**/api/phases/${phaseId}*`, async route => {
+    if (route.request().method() !== 'PUT') return route.continue()
+    writes++
+    await route.fetch()
+    await route.abort('failed')
+  })
+  await name(page).fill('Confirmed by GET')
+  expect(await save(page)).toBe(true)
+  await expect(name(page)).toBeEnabled()
+  await expect(saveState(page)).toBeHidden()
+  expect(writes).toBe(1)
+  expect((await (await request.get(`/api/phases/${phaseId}`)).json()).phase.name).toBe('Confirmed by GET')
+})
+
+test('phase detail aggregate lost create ACK never infers a new row ID', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  await page.getByRole('button', { name: '+ Добавить проверку', exact: true }).click()
+  await page.locator('#checks-list textarea').last().fill('Unique new check')
+  let writes = 0
+  await page.route(`**/api/phases/${phaseId}*`, async route => {
+    if (route.request().method() !== 'PUT') return route.continue()
+    writes++
+    await route.fetch()
+    await route.fulfill({ status: 200, json: { ok: true } })
+  })
+  expect(await save(page)).toBe(false)
+  await expect(saveState(page)).toHaveAttribute('data-page-state', 'partial-error')
+  await expect(page.locator('#checks-list li').last()).not.toHaveAttribute('data-id')
+  await page.locator('#phaseSaveReconcile').click()
+  await expect(saveState(page)).toHaveAttribute('data-page-state', 'partial-error')
+  expect(await save(page)).toBe(false)
+  expect(writes).toBe(1)
+  expect((await (await request.get(`/api/phases/${phaseId}`)).json()).phase.checks).toHaveLength(2)
+})
+
+test('phase detail aggregate valid ACK waits for GET and preserves original row identity', async ({ page }) => {
+  await page.goto(pageUrl())
+  let getRelease!: () => void
+  let readStarted = false
+  const pending = new Promise<void>(resolve => { getRelease = resolve })
+  await page.route(`**/api/phases/${phaseId}*`, async route => {
+    if (route.request().method() !== 'GET') return route.continue()
+    readStarted = true
+    await pending
+    await route.continue()
+  })
+  await name(page).fill('Pending GET')
+  const result = save(page)
+  try {
+    await expect.poll(() => readStarted).toBe(true)
+    await expect(name(page)).toBeDisabled()
+    await expect(saveState(page)).toHaveAttribute('data-page-state', 'loading')
+    await page.evaluate(() => {
+      const original = document.querySelector('#checks-list li')!
+      const replacement = original.cloneNode(true) as HTMLElement
+      delete replacement.dataset.id
+      delete replacement.dataset.phaseRowKey
+      original.replaceWith(replacement)
+    })
+  } finally { getRelease() }
+  expect(await result).toBe(false)
+  await expect(saveState(page)).toHaveAttribute('data-page-state', 'partial-error')
+  await expect(page.locator('#checks-list li').first()).not.toHaveAttribute('data-id')
+})
+
+test('phase detail aggregate malformed success never marks an unchanged server as saved', async ({ page }) => {
+  await page.goto(pageUrl())
+  let writes = 0
+  await page.route(`**/api/phases/${phaseId}*`, async route => {
+    if (route.request().method() !== 'PUT') return route.continue()
+    writes++
+    await route.fulfill({ status: 200, json: { message: 'Not an ACK' } })
+  })
+  await name(page).fill('Unsaved input')
+  expect(await save(page)).toBe(false)
+  await expect(saveState(page)).toHaveAttribute('data-page-state', 'partial-error')
+  await expect(name(page)).toHaveValue('Unsaved input')
+  expect(await save(page)).toBe(false)
+  expect(writes).toBe(1)
+})
+
+for (const invalid of ['id', 'workflow_id', 'mode_id', 'checks']) {
+  test(`phase detail aggregate rejects an authoritative response with invalid ${invalid}`, async ({ page }) => {
+    await page.goto(pageUrl())
+    await page.route(`**/api/phases/${phaseId}*`, async route => {
+      if (route.request().method() !== 'GET') return route.continue()
+      const result = await route.fetch()
+      const data = await result.json()
+      if (invalid === 'checks') data.phase.checks[0].id = -1
+      else data.phase[invalid] = -1
+      await route.fulfill({ response: result, json: data })
+    })
+    await name(page).fill('Validated scope')
+    expect(await save(page)).toBe(false)
+    await expect(saveState(page)).toHaveAttribute('data-page-state', 'partial-error')
+    await expect(name(page)).toBeDisabled()
+    await page.unroute(`**/api/phases/${phaseId}*`)
+    await page.locator('#phaseSaveReconcile').click()
+    await expect(name(page)).toBeEnabled()
+    await expect(saveState(page)).toBeHidden()
+  })
+}
+
+test('phase detail aggregate known create ACK recovers from failed GET with one PUT', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  await page.getByRole('button', { name: '+ Добавить проверку', exact: true }).click()
+  await page.locator('#checks-list textarea').last().fill('Known created check')
+  let writes = 0
+  await page.route(`**/api/phases/${phaseId}*`, async route => {
+    if (route.request().method() === 'PUT') { writes++; return route.continue() }
+    await route.fulfill({ status: 500, json: { ok: false } })
+  })
+  expect(await save(page)).toBe(false)
+  await expect(page.locator('#checks-list li').last()).not.toHaveAttribute('data-id')
+  await expect(saveState(page)).toHaveAttribute('data-page-state', 'partial-error')
+  await page.unroute(`**/api/phases/${phaseId}*`)
+  await page.locator('#phaseSaveReconcile').click()
+  await expect(name(page)).toBeEnabled()
+  const after = (await (await request.get(`/api/phases/${phaseId}`)).json()).phase
+  await expect(page.locator('#checks-list li').last()).toHaveAttribute('data-id', String(after.checks[1].id))
+  expect(after.checks).toHaveLength(2)
+  expect(writes).toBe(1)
+})
+
+test('phase detail aggregate snapshot never consumes a later DOM draft', async ({ page, request }) => {
+  await page.goto(pageUrl())
+  let release!: () => void
+  let started = false
+  const pending = new Promise<void>(resolve => { release = resolve })
+  await page.route(`**/api/phases/${phaseId}*`, async route => {
+    if (route.request().method() !== 'GET') return route.continue()
+    started = true
+    await pending
+    await route.continue()
+  })
+  await name(page).fill('Original attempt')
+  const result = save(page)
+  try {
+    await expect.poll(() => started).toBe(true)
+    await page.evaluate(() => { document.querySelector<HTMLInputElement>('.wiki-header [data-field="name"]')!.value = 'Later retained draft' })
+  } finally { release() }
+  expect(await result).toBe(true)
+  await expect(name(page)).toHaveValue('Later retained draft')
+  expect((await (await request.get(`/api/phases/${phaseId}`)).json()).phase.name).toBe('Original attempt')
+  await page.locator('.wiki-header a').click()
+  await expect(page.locator('[data-base-draft-dialog]')).toBeVisible()
+  await page.keyboard.press('Escape')
+  await expect(name(page)).toHaveValue('Later retained draft')
+})
+
+test('phase detail aggregate coordinates instruction and metadata control ownership', async ({ page, request }) => {
+  const created = await request.post(`/api/instructions?namespace_id=${namespaceId}`, { data: { phase_id: phaseId, description: 'Instruction baseline', step_num: 1 } })
+  expect(created.ok(), await created.text()).toBeTruthy()
+  const instructionId = (await created.json()).instruction.id as number
+  await page.goto(pageUrl())
+  const description = page.locator('.timeline-name-input').first()
+  let release!: () => void
+  let started = false
+  let phaseWrites = 0
+  const pending = new Promise<void>(resolve => { release = resolve })
+  await page.route(`**/api/instructions/${instructionId}*`, async route => {
+    if (route.request().method() !== 'PUT') return route.continue()
+    started = true
+    await pending
+    await route.continue()
+  })
+  await page.route(`**/api/phases/${phaseId}*`, async route => {
+    if (route.request().method() === 'PUT') phaseWrites++
+    await route.continue()
+  })
+  await description.fill('Confirmed instruction')
+  const instructionSave = page.evaluate(() => (window as unknown as { saveInstructionDescription: (input: Element) => Promise<void> }).saveInstructionDescription(document.querySelector('.timeline-name-input')!))
+  try {
+    await expect.poll(() => started).toBe(true)
+    await expect(name(page)).toBeDisabled()
+    expect(await save(page)).toBe(false)
+    expect(phaseWrites).toBe(0)
+    await expect(page.locator('.move-up-btn').first()).toBeDisabled()
+    await expect(page.locator('.wiki-header a').first()).toBeVisible()
+    await page.locator('.wiki-header a').first().click()
+    await expect(page.locator('[data-base-draft-dialog]')).toBeVisible()
+    await page.keyboard.press('Escape')
+  } finally { release() }
+  await instructionSave
+  await expect(description).toBeEnabled()
+  await expect(name(page)).toBeEnabled()
+  await expect(description).toHaveValue('Confirmed instruction')
+  await expect(page.locator('.move-up-btn').first()).toBeDisabled()
+  await name(page).fill('Metadata after instruction')
+  expect(await save(page)).toBe(true)
+  await expect(description).toBeEnabled()
+  expect(phaseWrites).toBe(1)
+})
+
+for (const status of [409, 500]) {
+  test(`phase detail aggregate retains rejected instruction draft (${status})`, async ({ page, request }) => {
+    expect((await request.post(`/api/instructions?namespace_id=${namespaceId}`, { data: { phase_id: phaseId, description: 'Instruction baseline', step_num: 1 } })).ok()).toBeTruthy()
+    await page.goto(pageUrl())
+    const description = page.locator('.timeline-name-input').first()
+    await page.route('**/api/instructions/*', route => route.fulfill({ status, json: { ok: false, error: 'Isolated rejection' } }))
+    await description.fill('Retained instruction draft')
+    await page.evaluate(() => (window as unknown as { saveInstructionDescription: (input: Element) => Promise<void> }).saveInstructionDescription(document.querySelector('.timeline-name-input')!))
+    await expect(description).toHaveValue('Retained instruction draft')
+    await expect(description).toBeEnabled()
+    await expect(name(page)).toBeEnabled()
+    await page.locator('.wiki-header a').first().click()
+    await expect(page.locator('[data-base-draft-dialog]')).toBeVisible()
+    await page.keyboard.press('Escape')
+    await expect(description).toHaveValue('Retained instruction draft')
+  })
+}
+
+test('phase detail aggregate does not deadlock multiple instruction drafts', async ({ page, request }) => {
+  for (const step of [1, 2]) expect((await request.post(`/api/instructions?namespace_id=${namespaceId}`, { data: { phase_id: phaseId, description: `Instruction ${step}`, step_num: step } })).ok()).toBeTruthy()
+  await page.goto(pageUrl())
+  await page.evaluate(() => {
+    const fields = document.querySelectorAll<HTMLTextAreaElement>('.timeline-name-input')
+    fields[0].value = 'First retained draft'
+    fields[1].value = 'Second retained draft'
+  })
+  for (const index of [0, 1]) {
+    await page.evaluate(index => (window as unknown as { saveInstructionDescription: (input: Element) => Promise<void> }).saveInstructionDescription(document.querySelectorAll('.timeline-name-input')[index]), index)
+    await expect(page.locator('.timeline-name-input').nth(index)).toHaveAttribute('data-original-description', index === 0 ? 'First retained draft' : 'Second retained draft')
+  }
+  await expect(name(page)).toBeEnabled()
+  await expect(page.locator('.move-up-btn').first()).toBeDisabled()
+  await expect(page.locator('.move-down-btn').first()).toBeEnabled()
+})
+
+test('phase detail aggregate blocks reload-based actions with another unsaved draft', async ({ page, request }) => {
+  expect((await request.post(`/api/instructions?namespace_id=${namespaceId}`, { data: { phase_id: phaseId, description: 'Instruction baseline', step_num: 1 } })).ok()).toBeTruthy()
+  await page.goto(pageUrl())
+  let writes = 0
+  await page.route('**/api/instructions*', async route => {
+    if (route.request().method() !== 'GET') writes++
+    await route.continue()
+  })
+  await page.evaluate(() => {
+    document.querySelector<HTMLInputElement>('.wiki-header [data-field="name"]')!.value = 'Other retained draft'
+    return (window as unknown as { addInstructionLast: () => Promise<void> }).addInstructionLast()
+  })
+  expect(writes).toBe(0)
+  await expect(saveState(page)).toHaveAttribute('data-page-state', 'error')
+  await expect(name(page)).toHaveValue('Other retained draft')
+  await expect(name(page)).toBeEnabled()
+})
+
+test('phase detail aggregate protects an instruction draft after metadata ACK', async ({ page, request }) => {
+  expect((await request.post(`/api/instructions?namespace_id=${namespaceId}`, { data: { phase_id: phaseId, description: 'Instruction baseline', step_num: 1 } })).ok()).toBeTruthy()
+  await page.goto(pageUrl())
+  await page.evaluate(() => {
+    document.querySelector<HTMLTextAreaElement>('.timeline-name-input')!.value = 'Unsaved instruction draft'
+    document.querySelector<HTMLInputElement>('.wiki-header [data-field="name"]')!.value = 'Confirmed metadata'
+  })
+  expect(await save(page)).toBe(true)
+  await expect(page.locator('.timeline-name-input').first()).toHaveValue('Unsaved instruction draft')
+  await page.locator('.wiki-header a').first().click()
+  await expect(page.locator('[data-base-draft-dialog]')).toBeVisible()
+  await page.keyboard.press('Escape')
+  await expect(page.locator('.timeline-name-input').first()).toHaveValue('Unsaved instruction draft')
+})
+
+test('phase detail aggregate keeps reorder controls locked and restores boundary targets', async ({ page, request }) => {
+  for (const step of [1, 2]) expect((await request.post(`/api/instructions?namespace_id=${namespaceId}`, { data: { phase_id: phaseId, description: `Instruction ${step}`, step_num: step } })).ok()).toBeTruthy()
+  await page.goto(pageUrl())
+  let release!: () => void
+  let writes = 0
+  const pending = new Promise<void>(resolve => { release = resolve })
+  await page.route(`**/api/phases/${phaseId}/instructions/reorder*`, async route => {
+    writes++
+    await pending
+    await route.continue()
+  })
+  const action = page.evaluate(() => (window as unknown as { moveInstruction: (button: Element, direction: number) => Promise<void> }).moveInstruction(document.querySelector('.move-down-btn')!, 1))
+  try {
+    await expect.poll(() => writes).toBe(1)
+    await expect(name(page)).toBeDisabled()
+    for (const button of await page.locator('.move-up-btn,.move-down-btn').all()) await expect(button).toBeDisabled()
+    expect(await save(page)).toBe(false)
+  } finally { release() }
+  await action
+  await expect(name(page)).toBeEnabled()
+  await expect(page.locator('.move-up-btn').first()).toBeDisabled()
+  await expect(page.locator('.move-down-btn').first()).toBeEnabled()
+  await expect(page.locator('.move-up-btn').last()).toBeEnabled()
+  await expect(page.locator('.move-down-btn').last()).toBeDisabled()
+  await expect(page.locator('.timeline-name-input').first()).toHaveValue('Instruction 2')
+  expect(writes).toBe(1)
+})
+
+test('phase detail aggregate locks writes while instruction confirmation is open', async ({ page, request }) => {
+  expect((await request.post(`/api/instructions?namespace_id=${namespaceId}`, { data: { phase_id: phaseId, description: 'Instruction baseline', step_num: 1 } })).ok()).toBeTruthy()
+  await page.goto(pageUrl())
+  const trigger = page.locator('.phase-delete-btn').first()
+  await trigger.click()
+  await expect(page.locator('#confirmDialog')).toBeVisible()
+  await expect(name(page)).toBeDisabled()
+  expect(await save(page)).toBe(false)
+  await page.keyboard.press('Escape')
+  await expect(page.locator('#confirmDialog')).not.toBeVisible()
+  await expect(name(page)).toBeEnabled()
+  await expect(trigger).toBeFocused()
+})
+
+test('phase detail aggregate preserves later instruction input after a valid ACK', async ({ page, request }) => {
+  const created = await request.post(`/api/instructions?namespace_id=${namespaceId}`, { data: { phase_id: phaseId, description: 'Instruction baseline', step_num: 1 } })
+  const instructionId = (await created.json()).instruction.id as number
+  await page.goto(pageUrl())
+  let release!: () => void
+  let started = false
+  const pending = new Promise<void>(resolve => { release = resolve })
+  await page.route(`**/api/instructions/${instructionId}*`, async route => {
+    started = true
+    await pending
+    await route.continue()
+  })
+  await page.locator('.timeline-name-input').first().fill('Original instruction attempt')
+  const action = page.evaluate(() => (window as unknown as { saveInstructionDescription: (input: Element) => Promise<void> }).saveInstructionDescription(document.querySelector('.timeline-name-input')!))
+  try {
+    await expect.poll(() => started).toBe(true)
+    await page.evaluate(() => { document.querySelector<HTMLTextAreaElement>('.timeline-name-input')!.value = 'Later retained instruction draft' })
+  } finally { release() }
+  await action
+  const description = page.locator('.timeline-name-input').first()
+  await expect(description).toHaveValue('Later retained instruction draft')
+  await expect(description).toHaveAttribute('data-original-description', 'Original instruction attempt')
+  await expect(description).toBeEnabled()
+})
+
+test('phase detail aggregate resumes deferred autosave after instruction settlement', async ({ page, request }) => {
+  for (const step of [1, 2]) expect((await request.post(`/api/instructions?namespace_id=${namespaceId}`, { data: { phase_id: phaseId, description: `Instruction ${step}`, step_num: step } })).ok()).toBeTruthy()
+  await page.goto(pageUrl())
+  let release!: () => void
+  let instructionStarted = false
+  let phaseWrites = 0
+  const pending = new Promise<void>(resolve => { release = resolve })
+  await page.route(`**/api/phases/${phaseId}/instructions/reorder*`, async route => {
+    instructionStarted = true
+    await pending
+    await route.continue()
+  })
+  await page.route(`**/api/phases/${phaseId}?*`, async route => {
+    if (route.request().method() === 'PUT') phaseWrites++
+    await route.continue()
+  })
+  const action = page.evaluate(() => {
+    const controller = window as unknown as { scheduleSave: () => void, moveInstruction: (button: Element, direction: number) => Promise<void> }
+    document.querySelector<HTMLInputElement>('.wiki-header [data-field="name"]')!.value = 'Deferred metadata draft'
+    controller.scheduleSave()
+    return controller.moveInstruction(document.querySelector('.move-down-btn')!, 1)
+  })
+  try {
+    await expect.poll(() => instructionStarted).toBe(true)
+    await page.waitForTimeout(750)
+    expect(phaseWrites).toBe(0)
+    await expect(name(page)).toBeDisabled()
+  } finally { release() }
+  await action
+  await expect.poll(() => phaseWrites).toBe(1)
+  await expect(name(page)).toBeEnabled()
+  await expect(saveState(page)).toBeHidden()
+  expect((await (await request.get(`/api/phases/${phaseId}`)).json()).phase.name).toBe('Deferred metadata draft')
+})
+
+test.afterEach(async ({ request }) => {
+  if (namespaceId) expect((await request.delete(`/api/namespaces/${namespaceId}`)).ok()).toBeTruthy()
+  if (workflowId) expect((await request.delete(`/api/workflows/${workflowId}`)).ok()).toBeTruthy()
+})
+
+test('phase detail aggregate same-tick lock protects original rows and pending navigation', async ({ page }) => {
+  await page.goto(pageUrl())
+  let writes = 0
+  let release!: () => void
+  const pending = new Promise<void>(resolve => { release = resolve })
+  await page.route(`**/api/phases/${phaseId}*`, async route => {
+    if (route.request().method() !== 'PUT') return route.continue()
+    writes++
+    await pending
+    await route.fulfill({ status: 422, json: { ok: false, error: 'Validation fixture' } })
+  })
+  try {
+    await page.locator('.wiki-header [data-field="name"]').fill('Retained draft')
+    await page.evaluate(() => {
+      const controller = window as unknown as { savePhase: () => Promise<boolean> }
+      void controller.savePhase()
+      void controller.savePhase()
+    })
+    await expect.poll(() => writes).toBe(1)
+    await expect(page.locator('#checks-list .item-delete').first()).toBeDisabled()
+    await expect(page.locator('#checks-list textarea').first()).toBeDisabled()
+    await expect(page.locator('.wiki-header [data-field="name"]')).toBeDisabled()
+    await expect(page.locator('#phaseSaveStatus')).toHaveAttribute('data-page-state', 'loading')
+    await page.locator('.wiki-header a').click()
+    await expect(page.locator('[data-base-draft-dialog]')).toBeVisible()
+    await page.keyboard.press('Escape')
+    expect(new URL(page.url()).pathname).toBe(`/phase/${phaseId}`)
+  } finally {
+    release()
+  }
+  await expect(page.locator('.wiki-header [data-field="name"]')).toBeEnabled()
+  await expect(page.locator('.wiki-header [data-field="name"]')).toHaveValue('Retained draft')
+  expect(writes).toBe(1)
+})
