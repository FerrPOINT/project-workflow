 - Standalone-режим: репозиторий собирается и запускается без соседнего `services-base` (убраны extra `cli-platform`, uv source, Docker additional_context и CI checkout). Token-режим CLI без `sdlc-cli-core` выдаёт понятную ошибку; запуск без `AUTH_ISSUER` работает без авторизации.
 
 ### Fixed
+- Agent editors use Base SSR controls and draft protection for navigation and
+  disclosure/cancel. Pending create/update locks fields and actions and rejects
+  direct duplicate handlers; rejected HTTP responses cannot announce success.
+  Unknown create/update outcome reconciliation remains a separate follow-up.
 - Jinja deletion confirmations use the shared Base SSR native dialog instead
   of a local modal shell. Pending callbacks keep the dialog locked until API
   acknowledgement; uncertain deletes block repeat writes across cancel/reopen
diff --git a/docs/UI_UX_MAP.md b/docs/UI_UX_MAP.md
index 849a9b9..7d02a12 100644
--- a/docs/UI_UX_MAP.md
+++ b/docs/UI_UX_MAP.md
@@ -83,3 +83,19 @@ cancel/reopen, и предоставляет только явную GET-све
 Начальный preview namespace получает SVG без дополнительного ввода в форму.
 Это не завершение backlog: workflows/agents create/update draft safety,
 pending/unknown/ACK lifecycle и оставшиеся controls требуют отдельной миграции.
+
+## Agent Draft And Pending Candidate
+
+Редакторы `/agents` подключают Base SSR input/textarea/button targets и общий
+draft guard. Выход через navigation и закрытие disclosure/cancel защищают
+черновик; подтверждение сбрасывает только выбранную форму. Pending create/update
+блокирует поля/actions, закрытие disclosure и повторный прямой вызов handler.
+HTTP rejection сохраняет значения и не объявляет успех, даже если тело содержит
+`ok: true`. После ACK create сохраняется защита других открытых редакторов.
+Новый root `.base-revision` закрепляет d22 для установленного React package;
+SSR assets сохраняют собственную byte-for-byte drift проверку. Read-only pilot
+не добавляет notification store или host без producers.
+
+Это узкий кандидат, не закрытие полного agent/workflow lifecycle. Unknown outcome,
+read-only reconcile, authoritative ACK payload и terminal 401/403/404 create/update
+ещё OPEN. Release/images/SSO и полный quality gate фиксируются отдельным evidence.
diff --git a/docs/plans/2026-10-05-agent-drafts.md b/docs/plans/2026-10-05-agent-drafts.md
new file mode 100644
index 0000000..c392260
--- /dev/null
+++ b/docs/plans/2026-10-05-agent-drafts.md
@@ -0,0 +1,26 @@
+# Agent Editor Draft And Pending Protection
+
+## Scope
+
+Подключить Base SSR controls/draft guard на существующей `/agents` без изменения
+доменных API, Python services, DB, CLI, auth и read-only React pilot.
+
+- Сохранять черновик при cancel/Escape navigation и закрытии disclosure.
+- Подтверждённый discard сбрасывает только текущий редактор и возвращает focus.
+- Pending create/update блокирует fields/actions/disclosure и direct duplicate
+  handlers; HTTP failure не становится success из-за `ok: true` в теле.
+- Base controls задают 40/44 targets; продукт сохраняет profile pattern/bounds.
+- После create ACK навигация учитывает другие несохранённые agent editors.
+
+## Checks
+
+Targeted Python/template checks, frontend checks, SSR drift и installed fingerprint;
+browser fixtures desktop/mobile, три темы, drafts/cancel/pending/HTTP rejection;
+полный Python/PostgreSQL/coverage94/Ruff/mypy/resources gate до source commit.
+Не считать fixture доказательством accepted images/SSO/README release.
+
+## Remaining Work
+
+Unknown create/update outcome reconciliation, authoritative ACK comparison,
+terminal states и workflows create/update lifecycle остаются в общем backlog.
+Эта правка не заявляет полный UI/UX audit или release acceptance завершёнными.
diff --git a/frontend/e2e/agent-drafts.spec.ts b/frontend/e2e/agent-drafts.spec.ts
new file mode 100644
index 0000000..6686100
--- /dev/null
+++ b/frontend/e2e/agent-drafts.spec.ts
@@ -0,0 +1,123 @@
+import { expect, test, type Page } from '@playwright/test'
+
+if (process.env.WORKFLOW_UI_QA_MUTATIONS !== 'isolated-fixture') {
+  throw new Error('Agent editor QA requires an isolated fixture')
+}
+
+const draftDialog = (page: Page) => page.locator('[data-base-draft-dialog]')
+
+async function openCreate(page: Page) {
+  await page.goto('/agents?namespace_id=1')
+  await page.locator('#agentCreatePanel > summary').click()
+  await page.locator('#newName').fill('Unsaved agent draft')
+}
+
+for (const theme of ['dark', 'gray', 'light']) {
+  test(`Base guards agent draft, cancel and control targets (${theme})`, async ({ page }) => {
+    await page.addInitScript(value => localStorage.setItem('workflow-theme', value), theme)
+    await openCreate(page)
+    const initialUrl = page.url()
+    const input = page.locator('#newName')
+    const form = page.locator('#agentCreatePanel form')
+    const width = page.viewportSize()!.width
+    for (const control of [input, form.locator('button[type="submit"]'), form.getByRole('button', { name: 'Отмена', exact: true })]) {
+      expect((await control.boundingBox())!.height).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
+    }
+    await page.locator('#agentCreatePanel > summary').click()
+    await expect(page.locator('#confirmDialog')).toBeVisible()
+    await page.keyboard.press('Escape')
+    await expect(input).toHaveValue('Unsaved agent draft')
+    await expect(page.locator('#agentCreatePanel')).toHaveAttribute('open', '')
+    if (width < 768) await page.locator('#burgerBtn').click()
+    await page.locator('.sidebar-link:visible[href^="/tasks"]').first().click()
+    await expect(draftDialog(page)).toBeVisible()
+    await page.keyboard.press('Escape')
+    await expect(input).toHaveValue('Unsaved agent draft')
+    expect(page.url()).toBe(initialUrl)
+    if (width < 768) {
+      const drawer = page.locator('[data-base-drawer]')
+      await expect(drawer).toBeVisible()
+      expect(await drawer.evaluate(element => element.contains(document.activeElement))).toBeTruthy()
+      await page.keyboard.press('Escape')
+      await expect(drawer).not.toBeVisible()
+      await expect(page.locator('#burgerBtn')).toBeFocused()
+    }
+    await page.screenshot({ path: test.info().outputPath(`agent-draft-${theme}-${width}.png`), fullPage: true })
+    // Cancel the particular form, not another editor on the same page.
+    await form.getByRole('button', { name: 'Отмена', exact: true }).click()
+    await page.locator('[data-base-confirm-accept]').click()
+    await expect(page.locator('#agentCreatePanel')).not.toHaveAttribute('open', '')
+    await expect(page.locator('#agentCreatePanel > summary')).toBeFocused()
+    await expect(input).toHaveValue('')
+  })
+}
+
+test('pending create protects fields, disclosure and direct duplicate handlers', async ({ page }) => {
+  let writes = 0
+  let release!: () => void
+  const held = new Promise<void>(resolve => { release = resolve })
+  await page.route('**/api/agents', async route => {
+    expect(route.request().method()).toBe('POST')
+    writes++
+    await held
+    await route.fulfill({ status: 422, json: { ok: false, error: 'Fixture validation rejected' } })
+  })
+  await openCreate(page)
+  const form = page.locator('#agentCreatePanel form')
+  try {
+    await form.locator('[type="submit"]').click()
+    await expect(form).toHaveAttribute('aria-busy', 'true')
+    await expect(page.locator('#newName')).toBeDisabled()
+    await expect(form.getByRole('button', { name: 'Отмена', exact: true })).toBeDisabled()
+    await page.locator('#agentCreatePanel > summary').click()
+    await expect(page.locator('#agentCreatePanel')).toHaveAttribute('open', '')
+    await page.evaluate(() => {
+      const ui = window as unknown as { addAgent: (event: { preventDefault: () => void; target: HTMLFormElement }) => Promise<void> }
+      const target = document.querySelector<HTMLFormElement>('#agentCreatePanel form')!
+      const event = { target, preventDefault() {} }
+      void ui.addAgent(event)
+      void ui.addAgent(event)
+    })
+    expect(writes).toBe(1)
+    release()
+    await expect(form).toHaveAttribute('aria-busy', 'false')
+    await expect(page.locator('#newName')).toBeEnabled()
+    await expect(page.locator('#newName')).toHaveValue('Unsaved agent draft')
+    await expect(page.locator('#toast')).toHaveText('Fixture validation rejected')
+    expect(writes).toBe(1)
+  } finally { release() }
+})
+
+test('cancelled update preserves server values and draft; HTTP failure cannot announce success', async ({ page, request }) => {
+  const response = await request.post('/api/agents', { data: { name: `agent-draft-${crypto.randomUUID()}`, description: 'Disposable agent editor fixture' } })
+  expect(response.ok()).toBeTruthy()
+  const id = (await response.json()).agent_id as number
+  try {
+    await page.goto('/agents?namespace_id=1')
+    const entry = page.locator(`.agent-entry[data-id="${id}"]`)
+    await entry.locator('summary').click()
+    const input = entry.locator('[name="name"]')
+    const original = await input.inputValue()
+    await input.fill('Unsaved updated agent')
+    await entry.getByRole('button', { name: 'Отмена', exact: true }).click()
+    await page.keyboard.press('Escape')
+    await expect(input).toHaveValue('Unsaved updated agent')
+    let writes = 0
+    await page.route(`**/api/agents/${id}`, async route => {
+      expect(route.request().method()).toBe('PUT')
+      writes++
+      await route.fulfill({ status: 503, json: { ok: true } })
+    })
+    await entry.locator('[type="submit"]').click()
+    await expect(entry.locator('form')).toHaveAttribute('aria-busy', 'false')
+    await expect(input).toHaveValue('Unsaved updated agent')
+    await expect(entry.locator('.agent-name')).toHaveText(original)
+    await expect(page.locator('#toast')).toHaveClass(/toast-error/)
+    expect(writes).toBe(1)
+    await entry.getByRole('button', { name: 'Отмена', exact: true }).click()
+    await page.locator('[data-base-confirm-accept]').click()
+    await expect(input).toHaveValue(original)
+  } finally {
+    expect((await request.delete(`/api/agents/${id}`)).ok()).toBeTruthy()
+  }
+})
