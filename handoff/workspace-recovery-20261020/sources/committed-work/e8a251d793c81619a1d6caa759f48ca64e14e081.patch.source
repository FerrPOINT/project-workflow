+var agentDraftBaselines=new WeakMap();
+var agentPendingForms=new Set();
+var agentDisabledControls=new WeakMap();
+function agentDraftSnapshot(form){
+  return JSON.stringify(Array.from(form.querySelectorAll('input,textarea')).map(function(field){ return field.value; }));
+}
+function agentFormDirty(form){ return agentDraftSnapshot(form)!==agentDraftBaselines.get(form); }
+function setAgentPending(form,pending){
+  if(pending){
+    agentPendingForms.add(form);
+    agentDisabledControls.set(form,Array.from(form.querySelectorAll('input,textarea,button')).map(function(control){
+      var state={control:control,disabled:control.disabled};
+      control.disabled=true;
+      return state;
+    }));
+  }else{
+    agentPendingForms.delete(form);
+    (agentDisabledControls.get(form)||[]).forEach(function(state){ state.control.disabled=state.disabled; });
+    agentDisabledControls.delete(form);
+  }
+  form.setAttribute('aria-busy',String(pending));
+  refreshWorkflowDraftGuard();
+}
+async function cancelAgent(button){
+  var entry=button.closest('.agent-entry,.agent-create');
+  var form=entry.querySelector('form');
+  if(agentPendingForms.size)return;
+  if(agentFormDirty(form)&&!await requestConfirmation({
+    title:'Отменить изменения агента?',message:'Несохранённые значения этой формы будут потеряны.',
+    confirmLabel:'Отменить изменения',returnFocus:button,fallbackFocus:entry.querySelector('summary'),
+    onConfirm:function(){},
+  }))return;
+  form.reset();
+  agentDraftBaselines.set(form,agentDraftSnapshot(form));
   entry.open=false;
   entry.querySelector('summary').focus();
+  refreshWorkflowDraftGuard();
 }
