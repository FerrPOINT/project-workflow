+        if (!create) {
+          const remove = page.locator('#deleteWorkflowButton')
+          for (const interaction of ['normal', 'hover', 'focus']) {
+            if (interaction === 'normal') await page.mouse.move(0, 0)
+            if (interaction === 'hover') await remove.hover()
+            if (interaction === 'focus') {
+              await page.mouse.move(0, 0)
+              await remove.focus()
+              await expect(remove).toBeFocused()
+            }
+            const colors = await remove.evaluate(element => {
+              const style = getComputedStyle(element)
+              const luminance = (value: string) => {
+                const match = value.match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)$/)
+                if (!match || (match[4] !== undefined && Number(match[4]) !== 1)) throw new Error(`Expected opaque RGB: ${value}`)
+                const [red, green, blue] = match.slice(1, 4).map(value => {
+                  const channel = Number(value) / 255
+                  return channel <= 0.04045 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4
+                })
+                return 0.2126 * red + 0.7152 * green + 0.0722 * blue
+              }
+              const values = [luminance(style.color), luminance(style.backgroundColor)].sort((a, b) => b - a)
+              return { foreground: style.color, background: style.backgroundColor, ratio: (values[0] + 0.05) / (values[1] + 0.05) }
+            })
+            expect(colors.ratio, `${theme}/${width}/${interaction}: ${colors.foreground} on ${colors.background}`).toBeGreaterThanOrEqual(4.5)
+          }
+          await page.locator('#workflowName').focus()
+        }
         for (const selector of ['#workflowName', '#workflowDescription', '#workflowSubmitButton', '#newWorkflowButton', '#workflowSelect']) {
           const box = await page.locator(selector).boundingBox()
           if (box) {
