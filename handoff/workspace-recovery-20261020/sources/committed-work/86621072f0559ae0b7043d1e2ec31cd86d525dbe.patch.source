-  const context = <><label htmlFor="namespace" className="sr-only">Неймспейс</label><Select id="namespace" className="max-w-48" value={namespace} onChange={event => { const next = new URLSearchParams(params); if (event.target.value) next.set('namespace_id', event.target.value); else next.delete('namespace_id'); next.delete('page'); if (/^\/phases\//.test(location.pathname)) window.location.assign(`/react/phases?${next}`); else setParams(next) }} disabled={namespaces.isLoading || namespaces.isError}><option value="">{location.pathname.startsWith('/phases') ? 'Воркфлоу по умолчанию' : 'Все неймспейсы'}</option>{namespaces.data?.namespaces.map(item => <option key={item.id} value={item.id}>{item.name}</option>)}</Select></>
-  return <AppShell currentServiceKey="project-workflow" title="Workflow" navigation={navigation} layout={/^\/phases\//.test(location.pathname) ? 'detail-with-aside' : 'wide'} context={context} account={identity?.subject ? { label: identity.name ?? 'Project Workflow', secondary: identity.subject, onLogout: () => window.location.assign('/logout') } : undefined}>{namespaces.error && <ResourceStateView state={{ kind: 'partial-error', message: 'Неймспейсы не загружены', onRetry: () => void namespaces.refetch() }} />}{restoreNamespace ? <ResourceStateView state={{ kind: 'loading' }} /> : invalidNamespace ? <ResourceStateView state={{ kind: 'error', message: 'Некорректный namespace_id: ожидается положительное целое число.' }} /> : <Routes><Route path="/tasks" element={<Tasks />} /><Route path="/phases" element={<Phases />} /><Route path="/phases/:id" element={<PhaseDetail />} /><Route path="/" element={<Navigate to={scopedPath('/tasks', namespace)} replace />} /><Route path="*" element={<ResourceStateView state={{ kind: 'not-found' }} />} /></Routes>}</AppShell>
+  function changeNamespace(value: string) {
+    const patch = { namespace_id: value }
+    if (/^\/phases\//.test(location.pathname)) {
+      setPhaseListParams(current => updateQuery(current, patch, true))
+    } else {
+      setParams(current => updateQuery(current, patch, true))
+    }
+  }
+  const context = <><label htmlFor="namespace" className="sr-only">Неймспейс</label><Select id="namespace" className="max-w-48" value={namespace} onChange={event => changeNamespace(event.target.value)} disabled={namespaces.isLoading || namespaces.isError}><option value="">{location.pathname.startsWith('/phases') ? 'Воркфлоу по умолчанию' : 'Все неймспейсы'}</option>{namespaces.data?.namespaces.map(item => <option key={item.id} value={item.id}>{item.name}</option>)}</Select></>
+  return <AppShell currentServiceKey="project-workflow" title="Workflow" navigation={navigation} layout={/^\/phases\//.test(location.pathname) ? 'detail-with-aside' : 'wide'} context={context} account={identity?.subject ? { label: identity.name ?? 'Project Workflow', secondary: identity.subject, onLogout: () => window.location.assign('/logout') } : undefined}>{namespaces.error && <ResourceStateView state={resourceErrorState(namespaces.error, () => void namespaces.refetch(), { hasData: true, message: 'Неймспейсы не загружены' })} />}{restoreNamespace ? <ResourceStateView state={{ kind: 'loading' }} /> : invalidNamespace ? <ResourceStateView state={{ kind: 'error', message: 'Некорректный namespace_id: ожидается положительное целое число.' }} /> : <Routes><Route path="/tasks" element={<Tasks />} /><Route path="/phases" element={<Phases />} /><Route path="/phases/:id" element={<PhaseDetail />} /><Route path="/" element={<Navigate to={scopedPath('/tasks', namespace)} replace />} /><Route path="*" element={<ResourceStateView state={{ kind: 'not-found' }} />} /></Routes>}</AppShell>
 }
