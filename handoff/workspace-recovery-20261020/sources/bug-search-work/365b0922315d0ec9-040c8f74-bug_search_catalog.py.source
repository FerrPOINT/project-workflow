"""Read a coherent real profession catalog and reuse existing phase contracts."""

from project_workflow.domain.bug_search_catalog import (
    BugSearchCatalog,
    FrozenCriterion,
    FrozenInstruction,
    FrozenMode,
    FrozenPhase,
    Purpose,
    qualified_catalog,
)
from project_workflow.domain.exceptions import ConflictError, NotFoundError
from project_workflow.infrastructure.db.bug_search_profession import PROFESSION_CODE, WORKFLOW_KEY
from project_workflow.infrastructure.db.uow import SAUnitOfWork
from project_workflow.supervisor.contracts import PhaseContractBuilder
from project_workflow.supervisor.models import Phase, PhaseCheck, PhaseEvidence, PhaseInstruction


def observe_bug_search_catalog(uow: SAUnitOfWork, profession_id: int | None = None) -> BugSearchCatalog:
    """Hold existing editor locks until the caller's transaction ends; never provision."""
    uow.lock_catalog_state(shared=True)
    candidate = (uow.projects.get_by_code(PROFESSION_CODE) if profession_id is None
                 else uow.projects.get_by_id(profession_id))
    if candidate is None or candidate.id is None:
        raise NotFoundError("Bug search profession not installed")
    profession_id = int(candidate.id)
    workflow = next((item for item in uow.workflows.list_by_profession(profession_id)
                     if item.key == WORKFLOW_KEY), None)
    if workflow is None or workflow.id is None:
        raise ConflictError("Canonical bug search workflow membership missing")
    # ProjectService and instruction/phase editors take workflow then profession
    # locks. Preserve that order; the legacy default workflow is not authority.
    uow.workflows.lock(workflow.id)
    uow.projects.lock(profession_id)
    # A row lock does not refresh SQLAlchemy's already-loaded identity map.
    # Re-read after waiting for editors, rather than qualifying stale profile data.
    uow.refresh()
    locked_workflow = uow.workflows.get_by_id(workflow.id)
    profession = uow.projects.get_by_id(profession_id)
    if (locked_workflow is None or profession is None or profession.code != PROFESSION_CODE
            or locked_workflow.key != WORKFLOW_KEY or not profession.launch_profile
            or not uow.workflows.belongs_to_profession(workflow.id, profession_id)):
        raise ConflictError("Bug search profession profile/membership unavailable")
    modes_by_key = {mode.key: mode for mode in uow.workflows.list_modes(workflow.id)}
    if set(modes_by_key) != {"search", "verification"}:
        raise ConflictError("Exact search and verification modes required")
    modes: list[FrozenMode] = []
    purposes: tuple[Purpose, ...] = ("search", "verification")
    for purpose in purposes:
        mode = modes_by_key[purpose]
        if mode.id is None or any(value is not None for value in (
            mode.role_key, mode.execution_scope, mode.execution_scopes, mode.tech_workspace_policy,
        )):
            raise ConflictError("Task assignment policy cannot authorize a project execution")
        rows = list(uow.phases.list(workflow.id, mode.id))
        phase_ids = [row.id for row in rows if row.id is not None]
        instructions = uow.phase_instructions.list_for_phases(phase_ids)
        checks = uow.phase_checks.list_for_phases(phase_ids)
        evidence = uow.phase_evidence_requirements.list_for_phases(phase_ids)
        phases: list[FrozenPhase] = []
        for row in rows:
            if (row.id is None or row.parallel_with_phase_id is not None or row.rollback_target_phase_id is not None
                    or row.execution_type != "sync"):
                raise ConflictError("Project execution v1 requires three sequential synchronous phases")
            phases.append(FrozenPhase(
                id=row.id, code=row.code, name=row.name, description=row.description or "",
                phase_order=row.phase_order, execution_type="sync",
                instructions=tuple(FrozenInstruction(
                    id=item["id"], step_num=item["step_num"], description=item["description"],
                    execution_type=item.get("execution_type", "sync"), skills=tuple(item.get("skills") or ()),
                ) for item in instructions.get(row.id, ())),
                checks=tuple(FrozenCriterion(id=item["id"], description=item["description"])
                             for item in checks.get(row.id, ())),
                evidence=tuple(FrozenCriterion(id=item["id"], description=item["description"])
                               for item in evidence.get(row.id, ())),
            ))
        modes.append(FrozenMode(
            mode_id=mode.id, mode_key=purpose, catalog_version=mode.catalog_version, phases=tuple(phases),
        ))
    catalog = qualified_catalog(
        profession_id=profession_id, launch_profile=profession.launch_profile, workflow_id=workflow.id,
        catalog_version=locked_workflow.active_catalog_version, modes=tuple(modes),
    )
    from project_workflow.domain.runtime_assignment import canonical_json

    for frozen_mode in catalog.modes:
        builder = phase_contracts(frozen_mode, catalog.profession.catalog_sha256)
        if any(len(canonical_json(builder.build(phase).to_dict()).encode("utf-8")) > 32_768
               for phase in phase_models(frozen_mode)):
            raise ConflictError("Frozen phase exceeds bounded project receipt capacity")
    return catalog


def phase_models(mode: FrozenMode) -> list[Phase]:
    """Recreate fresh existing Phase values from immutable source, without delegates/tasks."""
    return [Phase(
        id=phase.id, code=phase.code, name=phase.name, description=phase.description,
        instructions=[PhaseInstruction(
            id=item.id, step_num=item.step_num, step=item.description,
            execution_type="sync", skills=list(item.skills),
        ) for item in phase.instructions],
        checks=[PhaseCheck(id=item.id, description=item.description) for item in phase.checks],
        evidence=[PhaseEvidence(id=item.id, item=item.description) for item in phase.evidence],
    ) for phase in mode.phases]


def phase_contracts(mode: FrozenMode, catalog_sha256: str) -> PhaseContractBuilder:
    return PhaseContractBuilder(phase_models(mode), workflow_revision=catalog_sha256)
