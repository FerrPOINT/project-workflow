"""Fixed owner readers and execution/run HMAC; credentials never enter worker scope."""

import hashlib
import hmac
import json
import time

import httpx

from project_workflow import config
from project_workflow.domain.bug_search_execution import ExecutionBinding, GrantReadback
from project_workflow.domain.namespace_ownership import canonical_uuid, exact_instance
from project_workflow.domain.runtime_assignment import canonical_json
from project_workflow.infrastructure.namespace_auth import (
    NamespaceAuthError,
    NamespacePrincipal,
    _root,
    introspect,
    unique_object,
)


def authorize_fleet(authorization: str | None, *, write: bool) -> NamespacePrincipal:
    settings = config.get_settings()
    try:
        subject = canonical_uuid(settings.PROJECT_WORKFLOW_BUG_SEARCH_FLEET_SUBJECT)
    except ValueError:
        raise NamespaceAuthError(503) from None
    principal, scopes = introspect(authorization)
    required = "project-workflow:write" if write else "project-workflow:read"
    if (principal.subject != subject or required not in scopes or len(scopes) != len(set(scopes))
            or not set(scopes) <= {"project-workflow:read", "project-workflow:write"}):
        raise NamespaceAuthError(403)
    return principal


def read_grant(binding: ExecutionBinding) -> GrantReadback:
    settings = config.get_settings()
    try:
        root = _root(settings.PROJECT_WORKFLOW_BUG_SEARCH_TRACKER_ROOT)
        if (binding.tracker_instance_id != exact_instance(settings.PROJECT_WORKFLOW_BUG_SEARCH_TRACKER_INSTANCE_ID)
                or binding.tracker_instance_uuid != canonical_uuid(
                    settings.PROJECT_WORKFLOW_BUG_SEARCH_TRACKER_INSTANCE_UUID)):
            raise ValueError("Unregistered Tracker instance")
        reader_subject = canonical_uuid(settings.PROJECT_WORKFLOW_BUG_SEARCH_TRACKER_READER_SUBJECT)
        if reader_subject == canonical_uuid(settings.PROJECT_WORKFLOW_BUG_SEARCH_FLEET_SUBJECT):
            raise ValueError("Separate Workflow Tracker reader required")
        token = settings.PROJECT_WORKFLOW_BUG_SEARCH_TRACKER_TOKEN
        principal, scopes = introspect("Bearer " + token)
        if principal.subject != reader_subject or scopes != ["task-tracker:read"]:
            raise NamespaceAuthError(503)
        path = f"/api/v1/projects/{binding.project_id}/sdlc/bug-search/executions/{binding.execution_id}/grant"
        with httpx.Client(timeout=5, follow_redirects=False, trust_env=False) as client:
            started = time.monotonic()
            with client.stream("GET", root + path, headers={
                "Authorization": "Bearer " + token, "Accept-Encoding": "identity",
                "Cache-Control": "no-cache, no-store",
            }) as response:
                if response.status_code != 200 or response.headers.get("Content-Encoding", "identity") != "identity":
                    raise NamespaceAuthError(503)
                body = bytearray()
                for chunk in response.iter_bytes(chunk_size=1024):
                    body.extend(chunk)
                    if len(body) > 16_384 or time.monotonic() - started > 5:
                        raise NamespaceAuthError(503)
        value = json.loads(body, object_pairs_hook=unique_object)
        # JSON-aware parsing accepts arrays/dates while retaining strict scalar types.
        return GrantReadback.model_validate_json(canonical_json(value))
    except (httpx.HTTPError, ValueError, TypeError):
        raise NamespaceAuthError(503) from None


def scope_token(claims: dict[str, object]) -> str:
    """Deterministic replay-safe token; active state, fence and grant are checked per step."""
    settings = config.get_settings()
    secret = settings.PROJECT_WORKFLOW_BUG_SEARCH_SCOPE_SECRET
    if (len(secret.encode("utf-8")) < 32 or secret in {
        settings.PROJECT_WORKFLOW_BUG_SEARCH_TRACKER_TOKEN, settings.PROJECT_WORKFLOW_PM_SCOPE_SECRET,
        settings.PROJECT_WORKFLOW_PM_READBACK_TOKEN, settings.PROJECT_WORKFLOW_FLEET_CATALOG_TOKEN,
    }):
        raise NamespaceAuthError(503)
    return "wf_bug_v1_" + hmac.new(
        secret.encode("utf-8"), canonical_json(claims).encode("utf-8"), hashlib.sha256,
    ).hexdigest()


def require_scope(claims: dict[str, object], authorization: str | None) -> None:
    if not authorization or not authorization.startswith("Bearer wf_bug_v1_"):
        raise NamespaceAuthError(401)
    expected = scope_token(claims)
    if not hmac.compare_digest(authorization[7:].encode("utf-8"), expected.encode("utf-8")):
        raise NamespaceAuthError(403)
