"""Separate adapter and HMAC worker surfaces; ordinary human sessions grant no access."""

from collections.abc import Callable
from typing import Any

from fastapi import Header, Path, Query
from fastapi.responses import JSONResponse
from pydantic import ValidationError
from sqlalchemy.exc import IntegrityError, SQLAlchemyError

from project_workflow.application.bug_search_catalog import observe_bug_search_catalog
from project_workflow.application.bug_search_execution import BugSearchExecutionService, ExecutionActor
from project_workflow.domain.bug_search_execution import (
    BindExecution,
    ExecutionCommand,
    PrepareExecution,
    StepExecution,
)
from project_workflow.domain.exceptions import ConflictError, NotFoundError
from project_workflow.domain.namespace_ownership import canonical_uuid
from project_workflow.infrastructure import bug_search_authority as authority
from project_workflow.infrastructure.db.uow import SAUnitOfWork
from project_workflow.infrastructure.namespace_auth import NamespaceAuthError


def _response(callback: Callable[[], dict[str, Any]]) -> JSONResponse:
    try:
        return JSONResponse({"ok": True, **callback()}, headers={"Cache-Control": "no-store"})
    except NamespaceAuthError as error:
        status = error.status
        code = "authorization-unavailable" if status == 503 else "access-denied"
    except NotFoundError:
        status, code = 404, "execution-not-found"
    except (ConflictError, IntegrityError):
        status, code = 409, "execution-conflict"
    except (ValidationError, ValueError):
        status, code = 422, "execution-invalid"
    except SQLAlchemyError:
        status, code = 503, "execution-storage-unavailable"
    except RuntimeError:
        status, code = 503, "execution-dependency-unavailable"
    return JSONResponse({"ok": False, "error_code": code, "error": "Bug Search request rejected"},
                        status_code=status, headers={"Cache-Control": "no-store"})


def catalog(profession_id: int = Path(gt=0), authorization: str | None = Header(default=None)) -> JSONResponse:
    def execute() -> dict[str, Any]:
        authority.authorize_fleet(authorization, write=False)
        with SAUnitOfWork() as uow:
            return {"result": observe_bug_search_catalog(uow, profession_id).model_dump(mode="json")}
    return _response(execute)


def installed_catalog(authorization: str | None = Header(default=None)) -> JSONResponse:
    """Resolve the unique owner profession code; callers never guess numeric IDs."""
    def execute() -> dict[str, Any]:
        authority.authorize_fleet(authorization, write=False)
        with SAUnitOfWork() as uow:
            return {"result": observe_bug_search_catalog(uow).model_dump(mode="json")}
    return _response(execute)


def prepare(payload: PrepareExecution, authorization: str | None = Header(default=None)) -> JSONResponse:
    def execute() -> dict[str, Any]:
        principal = authority.authorize_fleet(authorization, write=True)
        with SAUnitOfWork() as uow:
            return {"result": BugSearchExecutionService(uow).prepare(payload, principal)}
    return _response(execute)


def readback(execution_id: str, authorization: str | None = Header(default=None)) -> JSONResponse:
    def execute() -> dict[str, Any]:
        principal = authority.authorize_fleet(authorization, write=False)
        with SAUnitOfWork() as uow:
            return {"result": BugSearchExecutionService(uow).readback(
                canonical_uuid(execution_id), ExecutionActor(principal=principal),
            )}
    return _response(execute)


def bind(
    execution_id: str, payload: BindExecution, authorization: str | None = Header(default=None),
) -> JSONResponse:
    def execute() -> dict[str, Any]:
        principal = authority.authorize_fleet(authorization, write=True)
        with SAUnitOfWork() as uow:
            service = BugSearchExecutionService(uow)
            result = service.bind(canonical_uuid(execution_id), payload, principal)
            row = service._load(execution_id)
            # Issue only for a durably accepted exact run. Fleet delivers this in
            # its existing continuation after bind; the initial run gets no fake token.
            token = authority.scope_token(service.claims(row)) if row.state == "active" else None
        return {"result": result, "execution_token": token}
    return _response(execute)


def stop(
    execution_id: str, payload: ExecutionCommand, authorization: str | None = Header(default=None),
) -> JSONResponse:
    def execute() -> dict[str, Any]:
        principal = authority.authorize_fleet(authorization, write=True)
        with SAUnitOfWork() as uow:
            return {"result": BugSearchExecutionService(uow).stop(canonical_uuid(execution_id), payload, principal)}
    return _response(execute)


def step(
    execution_id: str, payload: StepExecution, authorization: str | None = Header(default=None),
) -> JSONResponse:
    def execute() -> dict[str, Any]:
        with SAUnitOfWork() as uow:
            return {"result": BugSearchExecutionService(uow).step(canonical_uuid(execution_id), payload, authorization)}
    return _response(execute)


def history(
    execution_id: str, authorization: str | None = Header(default=None),
    after_operation_key: str | None = Query(default=None, min_length=1, max_length=128),
) -> JSONResponse:
    def execute() -> dict[str, Any]:
        with SAUnitOfWork() as uow:
            return {"result": BugSearchExecutionService(uow).history(
                canonical_uuid(execution_id), ExecutionActor(runtime_authorization=authorization), after_operation_key,
            )}
    return _response(execute)
