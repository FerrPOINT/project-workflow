"""Reuse the existing Developer engine with a fresh, exact BugWork owner fence."""

from __future__ import annotations

import json
import time
from typing import TYPE_CHECKING, Any

from project_workflow.domain.bug_work import BugWorkBind, BugWorkStep, BugWorkStepFence, checked_grant
from project_workflow.domain.bug_work_origin import BugWorkOriginReadback
from project_workflow.domain.exceptions import ConflictError
from project_workflow.domain.runtime_assignment import canonical_json, payload_sha256, phase_allowed_tools
from project_workflow.infrastructure.db import models as m

if TYPE_CHECKING:
    from project_workflow.application.bug_work import BugWorkService


def attested_binding(service: BugWorkService, row: m.TaskRuntimeAssignment) -> BugWorkBind:
    if row.bug_work_stop_receipt is not None or row.bug_work_binding_json is None:
        raise ConflictError("Нет действующего фактического BugWork binding")
    binding = BugWorkBind.model_validate_json(row.bug_work_binding_json)
    context = service._retained(row)
    if binding.runtime_attestation is None or "source_origin" not in context:
        from project_workflow.application.bug_work import execution_blocker

        raise ConflictError(execution_blocker(context))
    binding.runtime_attestation.require_original(
        checked_grant(context["grant"]),
        BugWorkOriginReadback.model_validate_json(canonical_json(context["source_origin"])),
        context["catalog"]["catalog_sha256"], binding,
    )
    if row.bind_request_sha256 != payload_sha256(binding.model_dump(mode="json")):
        raise ConflictError("Исходный producer attestation изменён")
    return binding


class BugWorkCustody:
    """Refresh only outside SQL locks; require does no I/O during locked CAS."""

    def __init__(self, service: BugWorkService, row: m.TaskRuntimeAssignment):
        self.service = service
        self.assignment_id = str(row.bug_work_assignment_id)
        self.tracker_uuid = str(row.bug_work_tracker_uuid)
        self.binding_sha256 = payload_sha256(json.loads(row.bug_work_binding_json or "null"))
        self.observed_at: float | None = None

    def refresh(self) -> None:
        session = self.service.session
        # Never flush/commit business/audit state merely to perform owner I/O.
        if session.new or session.dirty or session.deleted:
            raise ConflictError("Fresh Bug authority требует чистую границу транзакции")
        row = self.service._row(self.assignment_id, self.tracker_uuid)
        binding = attested_binding(self.service, row)
        if payload_sha256(binding.model_dump(mode="json")) != self.binding_sha256:
            raise ConflictError("Исходный Bug binding изменён")
        observed = self.service._fresh(row)  # closes the read TX before fixed owner HTTP
        grant = checked_grant(observed)
        expected = {
            "runtime_context_id": binding.runtime_context_id,
            "runtime_generation": binding.runtime_generation,
            "session_id": binding.session_id,
            "session_run_id": binding.session_run_id,
            "hermes_run_ref": binding.hermes_run_ref,
            "workflow_task_id": row.task_id,
            "workflow_assignment_revision": row.assignment_revision,
            "workflow_operation_key": row.operation_key,
            "workflow_binding_ref": binding.binding_ref,
        }
        if grant.binding is None or grant.binding.model_dump(mode="json") != expected:
            raise ConflictError("Tracker не подтвердил исходный фактический Bug binding")
        self.observed_at = time.monotonic()
        context = self.service._retained(row)
        if self.service.catalog(row.project_id) != context["catalog"]:
            raise ConflictError("Исходный каталог Developer изменён")

    def require(self, row: m.TaskRuntimeAssignment) -> None:
        if self.observed_at is None or time.monotonic() - self.observed_at > 5:
            raise ConflictError("Свежая authority назначения Bug устарела")
        binding = attested_binding(self.service, row)
        if payload_sha256(binding.model_dump(mode="json")) != self.binding_sha256:
            raise ConflictError("Фактический Bug binding изменён")


def execute(service: BugWorkService, row: m.TaskRuntimeAssignment, command: BugWorkStep) -> dict[str, Any]:
    binding = attested_binding(service, row)
    context = service._retained(row)
    custody = BugWorkCustody(service, row)
    custody.refresh()
    service._advisory("step:" + command.operation_key)
    row = service._row(str(row.bug_work_assignment_id), str(row.bug_work_tracker_uuid), locked=True)
    custody.require(row)
    request_sha256 = payload_sha256(command.model_dump(mode="json"))
    previous = service.uow.step_history.get_by_step_operation_key(command.operation_key)
    if previous is not None:
        saved = previous.to_dict()
        if previous.task_id != row.task_id or saved.get("request_sha256") != request_sha256 or (
            saved.get("assignment_operation_key"), saved.get("binding_ref"), saved.get("hermes_run_ref")
        ) != (row.operation_key, binding.binding_ref, binding.hermes_run_ref):
            raise ConflictError("Исходный step key относится к другому Bug/body")
        response = saved.get("supervisor_response")
        if not isinstance(response, dict):
            raise ConflictError("Исходный результат step недоступен")
        return {**response, "replayed": True, "bug_resolved": False}
    task = service.uow.tasks.get_by_id(row.task_id)
    if task is None:
        raise ConflictError("Исходный cursor Bug отсутствует")
    cursor = task.to_dict()
    if (
        command.expected_assignment_revision != row.assignment_revision
        or command.expected_fence != checked_grant(context["grant"]).assignment.fence
        or command.expected_phase_code != cursor.get("current_phase_code")
        or command.expected_status != cursor.get("status")
    ):
        raise ConflictError("Устаревший step fence Bug")
    phase_id = cursor.get("current_phase_id")
    if not isinstance(phase_id, int) or isinstance(phase_id, bool) or phase_id <= 0:
        raise ConflictError("Не подтверждена исходная фаза Developer")
    fence = BugWorkStepFence(
        step_operation_key=command.operation_key, request_sha256=request_sha256,
        assignment_revision=row.assignment_revision, assignment_operation_key=row.operation_key,
        assignment_ref=row.assignment_ref, binding_ref=binding.binding_ref, hermes_run_ref=binding.hermes_run_ref,
        mode_id=row.mode_id, mode_key="initial", cycle_number=0, attempt_number=1, role_key="developer",
        expected_phase_id=phase_id, expected_phase_code=command.expected_phase_code,
        expected_status=command.expected_status, bug_work_assignment_id=str(row.bug_work_assignment_id),
        bug_work_assignment_sha256=context["request"]["assignment_sha256"],
        bug_work_binding_sha256=custody.binding_sha256, bug_work_fence=command.expected_fence, custody=custody,
    )
    # Release the read/advisory transaction before the engine performs any provider I/O.
    service.uow.commit()
    from project_workflow.supervisor import SupervisorEngine

    engine = SupervisorEngine(
        task.task_key, uow=service.uow, create_if_missing=False, project_id=row.project_id, runtime_fence=fence,
    )
    if command.report is not None:
        return {**engine.evaluate(command.report), "bug_resolved": False}
    contract = engine.get_phase_contract()
    if contract is not None:
        contract["allowed_tools"] = phase_allowed_tools("developer", command.expected_phase_code)
    return {
        "contract_version": 1, "assignment_id": row.bug_work_assignment_id, "phase_code": engine.current_phase_code,
        "status": engine.task.get("status") if engine.task else None,
        "instructions": engine.format_current_phase_instructions(), "phase_contract": contract, "bug_resolved": False,
    }
