"""Issue-backed Developer cursor, using the existing assignment and step ledgers."""

import sqlalchemy as sa
from alembic import op

revision = "0016_bug_work_assignment"
down_revision = "0015_bug_search_execution"
branch_labels = None
depends_on = None

BINDING_COMPLETE = (
    "(bug_work_assignment_id IS NULL AND bug_work_tracker_uuid IS NULL AND bug_work_binding_json IS NULL "
    "AND bug_work_stop_key IS NULL AND bug_work_stop_receipt IS NULL AND ((workflow_key IS NULL AND "
    "role_key IS NULL AND execution_scope IS NULL AND stage_key IS NULL AND attempt_number IS NULL AND "
    "business_task_ref IS NULL AND root_task_ref IS NULL AND work_item_ref IS NULL AND work_item_revision "
    "IS NULL AND queue_item_ref IS NULL AND task_workspace_ref IS NULL AND workspace_revision IS NULL AND "
    "tech_execution_workspace_ref IS NULL AND tech_execution_attempt_ref IS NULL AND "
    "decomposition_revision_ref IS NULL AND stage_revision IS NULL AND assignment_ref IS NULL AND "
    "binding_ref IS NULL AND hermes_run_ref IS NULL AND bind_operation_key IS NULL AND bind_request_sha256 "
    "IS NULL AND workspace_generation IS NULL AND lease_generation IS NULL AND exact_input_refs IS NULL AND"
    " payload_sha256 IS NULL) OR (workflow_key IS NOT NULL AND role_key IS NOT NULL AND execution_scope IS "
    "NOT NULL AND stage_key IS NOT NULL AND attempt_number IS NOT NULL AND business_task_ref IS NOT NULL "
    "AND root_task_ref IS NOT NULL AND work_item_ref IS NOT NULL AND work_item_revision IS NOT NULL AND "
    "queue_item_ref IS NOT NULL AND task_workspace_ref IS NOT NULL AND workspace_revision IS NOT NULL AND "
    "decomposition_revision_ref IS NOT NULL AND stage_revision IS NOT NULL AND assignment_ref IS NOT NULL "
    "AND workspace_generation IS NOT NULL AND lease_generation IS NOT NULL AND exact_input_refs IS NOT NULL"
    " AND payload_sha256 IS NOT NULL AND ((binding_ref IS NULL AND hermes_run_ref IS NULL AND "
    "bind_operation_key IS NULL AND bind_request_sha256 IS NULL) OR (binding_ref IS NOT NULL AND "
    "hermes_run_ref IS NOT NULL AND ((bind_operation_key IS NULL AND bind_request_sha256 IS NULL) OR "
    "(bind_operation_key IS NOT NULL AND bind_request_sha256 IS NOT NULL))))) OR (workflow_key IS NOT NULL "
    "AND workflow_key = 'hermes-sdlc:project_manager' AND role_key IS NOT NULL AND role_key = "
    "'project_manager' AND execution_scope IS NOT NULL AND execution_scope = 'business' AND stage_key IS "
    "NOT NULL AND stage_key = 'draft' AND attempt_number IS NOT NULL AND attempt_number = 1 AND "
    "cycle_number = 0 AND business_task_ref IS NOT NULL AND root_task_ref IS NOT NULL AND work_item_ref IS "
    "NULL AND work_item_revision IS NULL AND queue_item_ref IS NULL AND task_workspace_ref IS NULL AND "
    "workspace_revision IS NULL AND workspace_generation IS NULL AND tech_execution_workspace_ref IS NULL "
    "AND tech_execution_attempt_ref IS NULL AND decomposition_revision_ref IS NULL AND stage_revision IS "
    "NOT NULL AND assignment_ref IS NOT NULL AND lease_generation IS NOT NULL AND exact_input_refs IS NOT "
    "NULL AND payload_sha256 IS NOT NULL AND ((binding_ref IS NULL AND hermes_run_ref IS NULL AND "
    "bind_operation_key IS NULL AND bind_request_sha256 IS NULL) OR (binding_ref IS NOT NULL AND "
    "hermes_run_ref IS NOT NULL AND bind_operation_key IS NOT NULL AND bind_request_sha256 IS NOT NULL)))))"
    " OR (bug_work_assignment_id IS NOT NULL AND length(bug_work_assignment_id)=36 AND "
    "bug_work_tracker_uuid IS NOT NULL AND length(bug_work_tracker_uuid)=36 AND workflow_key IS NOT NULL "
    "AND workflow_key='hermes-sdlc:developer' AND role_key IS NOT NULL AND role_key='developer' AND "
    "execution_scope IS NOT NULL AND execution_scope='delivery' AND stage_key IS NOT NULL AND "
    "stage_key='bug_work' AND attempt_number IS NOT NULL AND attempt_number=1 AND cycle_number=0 AND "
    "business_task_ref IS NULL AND root_task_ref IS NULL AND work_item_ref IS NULL AND work_item_revision "
    "IS NULL AND queue_item_ref IS NULL AND task_workspace_ref IS NULL AND workspace_revision IS NULL AND "
    "tech_execution_workspace_ref IS NULL AND tech_execution_attempt_ref IS NULL AND "
    "decomposition_revision_ref IS NULL AND workspace_generation IS NULL AND lease_generation IS NULL AND "
    "stage_revision IS NOT NULL AND assignment_ref IS NOT NULL AND exact_input_refs IS NOT NULL AND "
    "payload_sha256 IS NOT NULL AND ((binding_ref IS NULL AND hermes_run_ref IS NULL AND bind_operation_key"
    " IS NULL AND bind_request_sha256 IS NULL AND concrete_agent_ref IS NULL AND bug_work_binding_json IS "
    "NULL) OR (binding_ref IS NOT NULL AND hermes_run_ref IS NOT NULL AND bind_operation_key IS NOT NULL "
    "AND bind_request_sha256 IS NOT NULL AND concrete_agent_ref IS NOT NULL AND bug_work_binding_json IS "
    "NOT NULL)) AND ((bug_work_stop_key IS NULL AND bug_work_stop_receipt IS NULL) OR (bug_work_stop_key IS"
    " NOT NULL AND bug_work_stop_receipt IS NOT NULL)))"
)


SCOPE_TECH_REFS = (
    "(bug_work_assignment_id IS NULL AND (execution_scope IS NULL OR "
    "(execution_scope = 'business' AND tech_execution_workspace_ref IS NULL AND "
    "tech_execution_attempt_ref IS NULL) OR "
    "(execution_scope IN ('delivery', 'aggregate') AND tech_execution_workspace_ref IS NOT NULL AND "
    "tech_execution_attempt_ref IS NOT NULL))) OR "
    "(bug_work_assignment_id IS NOT NULL AND bug_work_tracker_uuid IS NOT NULL "
    "AND workflow_key='hermes-sdlc:developer' AND role_key='developer' "
    "AND execution_scope='delivery' AND stage_key='bug_work' "
    "AND tech_execution_workspace_ref IS NULL AND tech_execution_attempt_ref IS NULL)"
)


def upgrade() -> None:
    with op.batch_alter_table("task_runtime_assignments") as batch:
        batch.add_column(sa.Column("bug_work_assignment_id", sa.String(36), nullable=True))
        batch.add_column(sa.Column("bug_work_tracker_uuid", sa.String(36), nullable=True))
        batch.add_column(sa.Column("bug_work_binding_json", sa.Text(), nullable=True))
        batch.add_column(sa.Column("bug_work_stop_key", sa.String(128), nullable=True))
        batch.add_column(sa.Column("bug_work_stop_receipt", sa.Text(), nullable=True))
        batch.create_unique_constraint(
            "uq_bug_work_owner_assignment", ["bug_work_tracker_uuid", "bug_work_assignment_id"]
        )
        batch.create_unique_constraint("uq_bug_work_stop_key", ["bug_work_stop_key"])
        batch.drop_constraint("ck_task_runtime_assignments_binding_complete", type_="check")
        batch.create_check_constraint("ck_task_runtime_assignments_binding_complete", BINDING_COMPLETE)
        batch.drop_constraint("ck_task_runtime_assignments_scope_tech_refs", type_="check")
        batch.create_check_constraint("ck_task_runtime_assignments_scope_tech_refs", SCOPE_TECH_REFS)

    op.create_index(
        "uq_bug_work_native_run",
        "task_runtime_assignments",
        ["concrete_agent_ref", "hermes_run_ref"],
        unique=True,
        postgresql_where=sa.text("bug_work_assignment_id IS NOT NULL"),
        sqlite_where=sa.text("bug_work_assignment_id IS NOT NULL"),
    )
    immutable = (
        "id",
        "operation_key",
        "task_id",
        "project_id",
        "workflow_id",
        "workflow_key",
        "mode_id",
        "cycle_number",
        "attempt_number",
        "assignment_revision",
        "role_key",
        "execution_scope",
        "stage_key",
        "business_task_ref",
        "root_task_ref",
        "work_item_ref",
        "work_item_revision",
        "queue_item_ref",
        "task_workspace_ref",
        "workspace_revision",
        "tech_execution_workspace_ref",
        "tech_execution_attempt_ref",
        "decomposition_revision_ref",
        "stage_revision",
        "assignment_ref",
        "workspace_generation",
        "lease_generation",
        "exact_input_refs",
        "payload",
        "payload_sha256",
        "created_at",
        "bug_work_assignment_id",
        "bug_work_tracker_uuid",
    )
    binding = (
        "binding_ref",
        "hermes_run_ref",
        "bind_operation_key",
        "bind_request_sha256",
        "concrete_agent_ref",
        "bug_work_binding_json",
    )
    if op.get_bind().dialect.name == "postgresql":
        unchanged = " OR ".join(f"NEW.{name} IS DISTINCT FROM OLD.{name}" for name in immutable)
        same_binding = " OR ".join(f"NEW.{name} IS DISTINCT FROM OLD.{name}" for name in binding)
        op.execute(
            "CREATE FUNCTION bug_work_assignment_guard() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN "
            "IF TG_OP='DELETE' THEN IF OLD.bug_work_assignment_id IS NOT NULL THEN "
            "RAISE EXCEPTION 'Bug work assignment is retained'; END IF; RETURN OLD; END IF; "
            "IF OLD.bug_work_assignment_id IS NULL THEN IF NEW.bug_work_assignment_id IS NOT NULL THEN "
            "RAISE EXCEPTION 'Ordinary assignment cannot become Bug work'; END IF; RETURN NEW; END IF; "
            "IF " + unchanged + " OR (OLD.bug_work_binding_json IS NOT NULL AND (" + same_binding + "))"
            " OR (OLD.bug_work_stop_receipt IS NOT NULL AND (NEW.bug_work_stop_key IS DISTINCT FROM "
            "OLD.bug_work_stop_key OR NEW.bug_work_stop_receipt IS DISTINCT FROM OLD.bug_work_stop_receipt)) "
            "THEN RAISE EXCEPTION 'Bug work identity and receipts are immutable'; END IF; RETURN NEW; END; $$"
        )
        op.execute(
            "CREATE TRIGGER bug_work_assignment_guard BEFORE UPDATE OR DELETE ON task_runtime_assignments "
            "FOR EACH ROW EXECUTE FUNCTION bug_work_assignment_guard()"
        )
    else:
        unchanged = " OR ".join(f"NEW.{name} IS NOT OLD.{name}" for name in immutable)
        same_binding = " OR ".join(f"NEW.{name} IS NOT OLD.{name}" for name in binding)
        op.execute(
            "CREATE TRIGGER bug_work_assignment_guard BEFORE UPDATE ON task_runtime_assignments WHEN "
            "(OLD.bug_work_assignment_id IS NULL AND NEW.bug_work_assignment_id IS NOT NULL) OR "
            "(OLD.bug_work_assignment_id IS NOT NULL AND (" + unchanged + " OR "
            "(OLD.bug_work_binding_json IS NOT NULL AND (" + same_binding + ")) OR "
            "(OLD.bug_work_stop_receipt IS NOT NULL AND (NEW.bug_work_stop_key IS NOT OLD.bug_work_stop_key OR "
            "NEW.bug_work_stop_receipt IS NOT OLD.bug_work_stop_receipt)))) "
            "BEGIN SELECT RAISE(ABORT, 'Bug work identity and receipts are immutable'); END"
        )
        op.execute(
            "CREATE TRIGGER bug_work_assignment_retain BEFORE DELETE ON task_runtime_assignments "
            "WHEN OLD.bug_work_assignment_id IS NOT NULL BEGIN "
            "SELECT RAISE(ABORT, 'Bug work assignment is retained'); END"
        )


def downgrade() -> None:
    raise RuntimeError("Bug work downgrade refused: retained Issue assignments require reconciliation")
