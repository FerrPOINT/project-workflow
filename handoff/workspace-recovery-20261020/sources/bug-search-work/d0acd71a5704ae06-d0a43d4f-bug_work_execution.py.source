"""HMAC-only Issue-backed worker transport; no PAT or local database fallback."""

import json
import os
import re
import time
from pathlib import Path
from typing import Any

import httpx

from project_workflow.domain.bug_search_catalog import FrozenCatalogModel
from project_workflow.domain.bug_work import BugWorkStep, UUIDRef, Version
from project_workflow.infrastructure.namespace_auth import _root, unique_object


class BugWorkRequest(FrozenCatalogModel):
    assignment_id: UUIDRef
    tracker_instance_uuid: UUIDRef
    profession_id: Version
    step: BugWorkStep | None = None


def execute(request_file: Path, token_file: Path | None, *, history: bool) -> dict[str, Any]:
    try:
        if token_file is None or os.environ.get("SDLC_API_TOKEN", "").strip():
            raise ValueError
        with request_file.open("rb") as source:
            raw = source.read(262_145)
        with token_file.open("rb") as source:
            token_raw = source.read(129)
        if len(raw) > 262_144 or len(token_raw) > 128:
            raise ValueError
        content = json.loads(raw, object_pairs_hook=unique_object)
        request = BugWorkRequest.model_validate_json(json.dumps(content, ensure_ascii=False))
        token = token_raw.decode("ascii").strip()
        if (
            not re.fullmatch(r"wf_bug_work_v1_[0-9a-f]{64}", token)
            or os.environ.get("PROJECT_WORKFLOW_NAMESPACE_ID", "") != str(request.profession_id)
            or (history and request.step is not None)
            or (not history and request.step is None)
        ):
            raise ValueError
        root = _root(os.environ.get("PROJECT_WORKFLOW_URL", ""))
        path = f"/internal/bug-work/v1/assignments/{request.assignment_id}/" + ("history" if history else "step")
        with httpx.Client(timeout=150, follow_redirects=False, trust_env=False) as client:
            started = time.monotonic()
            with client.stream(
                "GET" if history else "POST",
                root + path,
                params={"tracker_instance_uuid": request.tracker_instance_uuid},
                json=request.step.model_dump(mode="json") if request.step is not None else None,
                headers={
                    "Authorization": "Bearer " + token,
                    "Accept-Encoding": "identity",
                    "Cache-Control": "no-store",
                },
            ) as response:
                if response.status_code != 200 or response.headers.get("Content-Encoding", "identity") != "identity":
                    raise ValueError
                body = bytearray()
                for chunk in response.iter_bytes(chunk_size=4096):
                    body.extend(chunk)
                    if len(body) > 2_097_152 or time.monotonic() - started > 150:
                        raise ValueError
        value = json.loads(body, object_pairs_hook=unique_object)
        if not isinstance(value, dict) or value.get("ok") is not True or not isinstance(value.get("result"), dict):
            raise ValueError
        return dict(value)
    except (OSError, ValueError, TypeError, UnicodeError, RecursionError, httpx.HTTPError):
        raise ValueError("BugWork не подтверждён; автоматический повтор и DB fallback запрещены") from None
