"""Real bounded HTTP readers send only their own fixed-owner credentials."""

import json
from datetime import datetime, timedelta, timezone

import httpx
import pytest

from project_workflow import config
from project_workflow.domain.bug_search_execution import ExecutionSnapshot
from project_workflow.infrastructure import bug_search_authority as authority
from project_workflow.infrastructure import bug_search_targets as targets
from project_workflow.infrastructure.namespace_auth import NamespaceAuthError, NamespacePrincipal
from tests.test_bug_search_execution import grant, uid
from tests.test_bug_search_execution import source as source
from tests.test_bug_target_source import identity

READ_GRANT = authority.read_grant


def settings(monkeypatch, **values):
    for name, value in values.items():
        monkeypatch.setenv("PROJECT_WORKFLOW_BUG_SEARCH_" + name, value)
    config.get_settings.cache_clear()


def transport(monkeypatch, module, handler):
    client = httpx.Client
    monkeypatch.setattr(module.httpx, "Client", lambda **kwargs: client(
        **kwargs, transport=httpx.MockTransport(handler),
    ))


def test_grant_reader_uses_own_pat_and_explicit_instance_uuid(source, monkeypatch):
    binding = source[0].binding
    reader = uid()
    settings(monkeypatch, TRACKER_ROOT="http://tracker.invalid", TRACKER_INSTANCE_ID=binding.tracker_instance_id,
             TRACKER_INSTANCE_UUID=binding.tracker_instance_uuid, TRACKER_READER_SUBJECT=reader,
             TRACKER_TOKEN="sdlc_pat_workflow_reader", FLEET_SUBJECT=binding.machine_subject)
    observed = []

    def introspect(header):
        assert header == "Bearer sdlc_pat_workflow_reader"
        return NamespacePrincipal(issuer="http://central.invalid", subject=reader), ["task-tracker:read"]

    def handle(request):
        observed.append(request)
        assert request.headers["authorization"] == "Bearer sdlc_pat_workflow_reader"
        assert request.url.path == (
            f"/api/v1/projects/{binding.project_id}/sdlc/bug-search/executions/{binding.execution_id}/grant"
        )
        return httpx.Response(200, json=grant(binding).model_dump(mode="json"))

    monkeypatch.setattr(authority, "introspect", introspect)
    transport(monkeypatch, authority, handle)
    readback = READ_GRANT(binding)
    readback.require(binding, dispatch=True)
    assert len(observed) == 1
    settings(monkeypatch, TRACKER_INSTANCE_UUID=uid())
    with pytest.raises(NamespaceAuthError):
        READ_GRANT(binding)
    assert len(observed) == 1


@pytest.mark.parametrize("scopes", [["project-workflow:read", "project-workflow:read"],
                                    ["project-workflow:write"], ["project-workflow:read", "api:write"]])
def test_adapter_authorization_rejects_wrong_or_duplicate_scopes(source, monkeypatch, scopes):
    principal = source[1]
    settings(monkeypatch, FLEET_SUBJECT=principal.subject)
    monkeypatch.setattr(authority, "introspect", lambda _: (principal, scopes))
    with pytest.raises(NamespaceAuthError) as error:
        authority.authorize_fleet("Bearer sdlc_pat_incoming", write=False)
    assert error.value.status == 403


def qa_context(source):
    payload = source[0].snapshot.content()
    payload["mode"] = "qa"
    payload["targets"][0].update(target_ref="qa:portal", deployment_ref="forge:delivered:" + "d" * 64)
    return ExecutionSnapshot.model_validate_json(json.dumps(payload)), source[0].binding


def owner_readback(snapshot, binding, mapping):
    now = datetime.now(timezone.utc).isoformat()
    return {"schema": "forge/delivered-target/v1", "producerVersion": "1.0.0",
            "project": {"trackerInstanceId": binding.tracker_instance_uuid, "projectId": binding.project_id},
            "configurationId": mapping["configuration_id"], "repositoryId": mapping["repository_id"],
            "environmentId": mapping["environment_id"], "targetRef": "qa:portal", "status": "confirmed",
            "observedAt": now, "blockedReasons": [], "target": {
                "deliveryRef": snapshot.targets[0].deployment_ref, "operationKey": "publish:1",
                "generation": str((1 << 64) - 1), "manifestSha256": "a" * 64, "commitSha": "a" * 40,
                "artifactId": uid(), "artifactDigest": "sha256:" + "b" * 64, "targetUrl": "http://qa.invalid",
                "servingIdentity": {"versionBodySha256": "a" * 64, "artifactBodySha256": "b" * 64,
                                    "observedAt": now},
            }}


def test_forge_owner_reader_binds_every_locator_and_real_body_hashes(source, monkeypatch):
    snapshot, binding = qa_context(source)
    mapping = {"tracker_instance_id": binding.tracker_instance_id,
               "tracker_instance_uuid": binding.tracker_instance_uuid,
               "project_id": binding.project_id, "repository_ref": "repo:portal", "target_ref": "qa:portal",
               "configuration_id": uid(), "repository_id": uid(), "environment_id": uid()}
    settings(monkeypatch, CI_ROOT="http://forge.invalid", DELIVERED_TARGETS_JSON=json.dumps({"targets": [mapping]}),
             CI_TOKENS_JSON=json.dumps({mapping["configuration_id"]: "forge_sat_project_reader"}))
    value = owner_readback(snapshot, binding, mapping)

    def handle(request):
        assert request.headers["authorization"] == "Bearer forge_sat_project_reader"
        assert request.url.path == f"/api/v1/projects/{mapping['configuration_id']}/delivered-targets/qa:portal"
        assert dict(request.url.params) == {"tracker_instance_id": binding.tracker_instance_uuid,
                                            "project_id": binding.project_id, "repository_id": mapping["repository_id"]}
        return httpx.Response(200, json=value)

    transport(monkeypatch, targets, handle)
    before = targets.observe_targets(snapshot, binding)
    value["target"]["servingIdentity"]["observedAt"] = (
        datetime.now(timezone.utc) + timedelta(milliseconds=5)
    ).isoformat()
    after = targets.observe_targets(snapshot, binding)
    assert targets.same_targets(before, after)
    value["target"]["generation"] = "1"
    changed = targets.observe_targets(snapshot, binding)
    assert not targets.same_targets(before, changed)
    old_timestamp = value["observedAt"]
    value["observedAt"] = "2020-01-01T00:00:00Z"
    with pytest.raises(NamespaceAuthError):
        targets.observe_targets(snapshot, binding)
    value["observedAt"] = old_timestamp
    value["target"]["servingIdentity"]["artifactBodySha256"] = "c" * 64
    with pytest.raises(NamespaceAuthError):
        targets.observe_targets(snapshot, binding)


def test_changed_owner_observation_can_only_support_explicit_inconclusive(source, monkeypatch):
    snapshot, binding = qa_context(source)
    mapping = {"tracker_instance_id": binding.tracker_instance_id,
               "tracker_instance_uuid": binding.tracker_instance_uuid,
               "project_id": binding.project_id, "repository_ref": "repo:portal", "target_ref": "qa:portal",
               "configuration_id": uid(), "repository_id": uid(), "environment_id": uid()}
    settings(monkeypatch, CI_ROOT="http://forge.invalid", DELIVERED_TARGETS_JSON=json.dumps({"targets": [mapping]}),
             CI_TOKENS_JSON=json.dumps({mapping["configuration_id"]: "forge_sat_project_reader"}))
    value = owner_readback(snapshot, binding, mapping)
    value.update(status="changed", blockedReasons=["target_generation_changed"], target=None)
    transport(monkeypatch, targets, lambda _: httpx.Response(200, json=value))
    with pytest.raises(NamespaceAuthError):
        targets.observe_targets(snapshot, binding)
    assert targets.observe_targets(snapshot, binding, require_expected=False)[0]["status"] == "changed"


@pytest.mark.parametrize("field,value", [
    ("status", "changed"), ("blockedReasons", ["owner_changed"]),
    ("configurationId", "00000000-0000-4000-8000-000000000001"),
    ("repositoryId", "00000000-0000-4000-8000-000000000001"), ("environmentId", "00000000-0000-4000-8000-000000000001"),
    ("targetRef", "qa:other"),
])
def test_same_target_bodies_cannot_override_status_or_scope_authority(source, field, value):
    snapshot, binding = qa_context(source)
    before = owner_readback(snapshot, binding, {
        "configuration_id": uid(), "repository_id": uid(), "environment_id": uid(),
    })
    after = json.loads(json.dumps(before))
    after[field] = value
    assert not targets.same_targets([before], [after])


@pytest.mark.parametrize("field", ["trackerInstanceId", "projectId", "configurationId", "repositoryId"])
def test_equal_qa_observations_must_match_original_source_identity(source, field):
    snapshot, binding = qa_context(source)
    raw = snapshot.content()
    pin = identity(binding.project_id, binding.tracker_instance_uuid, "b" * 40)
    raw["targets"][0]["source"] = pin
    snapshot = ExecutionSnapshot.model_validate_json(json.dumps(raw))
    observation = owner_readback(snapshot, binding, {**pin, "environment_id": uid()})
    assert targets.same_targets([observation], [observation], snapshot)
    if field in {"trackerInstanceId", "projectId"}:
        observation["project"][field] = uid()
    else:
        observation[field] = uid()
    # Stable before/after is insufficient: both may attest the same remapped repository.
    assert targets.same_targets([observation], [observation])
    assert not targets.same_targets([observation], [observation], snapshot)
    assert not targets.same_targets([observation], [], snapshot)


@pytest.mark.parametrize("remapped", [False, True])
def test_qa_mapping_is_checked_against_original_source_before_owner_http(source, monkeypatch, remapped):
    snapshot, binding = qa_context(source)
    raw = snapshot.content()
    pin = identity(binding.project_id, binding.tracker_instance_uuid, "b" * 40)
    raw["targets"][0]["source"] = pin
    snapshot = ExecutionSnapshot.model_validate_json(json.dumps(raw))
    mapping = {"tracker_instance_id": binding.tracker_instance_id,
               "tracker_instance_uuid": binding.tracker_instance_uuid,
               "project_id": binding.project_id, "repository_ref": "repo:portal", "target_ref": "qa:portal",
               "configuration_id": pin["configuration_id"], "repository_id": pin["repository_id"],
               "environment_id": uid()}
    if remapped:
        mapping["repository_id"] = uid()
    settings(monkeypatch, CI_ROOT="http://forge.invalid", DELIVERED_TARGETS_JSON=json.dumps({"targets": [mapping]}),
             CI_TOKENS_JSON=json.dumps({mapping["configuration_id"]: "forge_sat_project_reader"}))
    seen = []

    def handle(request):
        seen.append(request)
        return httpx.Response(200, json=owner_readback(snapshot, binding, mapping))

    transport(monkeypatch, targets, handle)
    if remapped:
        with pytest.raises(NamespaceAuthError):
            targets.observe_targets(snapshot, binding)
        assert not seen
    else:
        observed = targets.observe_targets(snapshot, binding)
        assert len(seen) == 1
        assert targets.same_targets(observed, observed, snapshot)
