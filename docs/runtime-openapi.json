    "/internal/runtime/history": {
      "get": {
        "description": "Read configured operations or retained history through the same authority.",
        "operationId": "runtime_history_internal_runtime_history_get",
        "parameters": [
          {
            "in": "query",
            "name": "task",
            "required": true,
            "schema": {
              "title": "Task",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "n",
            "required": false,
            "schema": {
              "default": 200,
              "maximum": 200,
              "minimum": 1,
              "title": "N",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "interaction_protocol",
            "required": true,
            "schema": {
              "const": "configured-cli-v1",
              "title": "Interaction Protocol",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "namespace_id",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "title": "Namespace Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "execution_ref",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Execution Ref"
            }
          },
          {
            "in": "query",
            "name": "operation_key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Operation Key"
            }
          },
          {
            "in": "query",
            "name": "assignment_operation_key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Assignment Operation Key"
            }
          },
          {
            "in": "query",
            "name": "projection",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "const": "fleet-summary-v1",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Projection"
            }
          },
          {
            "in": "query",
            "name": "before_history_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "description": "Canonical ASCII decimal database ID in 1..9223372036854775807",
                  "maxLength": 19,
                  "pattern": "^[1-9][0-9]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before History Id"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Runtime History"
      }
    },
