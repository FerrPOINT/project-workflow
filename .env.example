# Database
DATABASE_URL=postgresql+psycopg://project_workflow:project_workflow@localhost:5432/project_workflow
DB_SCHEMA=project_workflow

# UI
UI_HOST=127.0.0.1
UI_PORT=8811

# Logging
LOG_LEVEL=INFO

# Required OpenAI-compatible Supervisor evaluator (Octo LiteLLM, no fallback)
OPENAI_BASE_URL=http://192.168.10.1:4000/v1
OPENAI_MODEL=app-test
OPENAI_TIMEOUT=120
OPENAI_MAX_TOKENS=4000
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=none

# Optional service catalog for cross-service links in the header.
PLATFORM_SERVICES_URL=http://localhost:7771/api/v1/runtime/services

# Optional Central Auth browser SSO. Keep AUTH_ISSUER public/browser-reachable
# and AUTH_INTERNAL_BASE_URL reachable from this process/container.
AUTH_ISSUER=
AUTH_INTERNAL_BASE_URL=
AUTH_PUBLIC_ORIGIN=http://localhost:8812
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=false

# Token-mode CLI uses Central Auth personal tokens and the protected HTTP API.
PROJECT_WORKFLOW_URL=http://localhost:8812
SDLC_API_TOKEN=

# Optional bridge for isolated agent containers; keep it on an internal network.
PROJECT_WORKFLOW_RUNTIME_TOKENS_JSON=
