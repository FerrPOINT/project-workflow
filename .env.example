# Database
DATABASE_URL=postgresql+psycopg://project_workflow:project_workflow@localhost:5432/project_workflow
DB_SCHEMA=project_workflow

# UI
UI_HOST=127.0.0.1
UI_PORT=8811

# Logging
LOG_LEVEL=INFO

# Required OpenAI-compatible Supervisor evaluator (Octo LiteLLM, no fallback)
OPENAI_BASE_URL=http://192.168.10.1:4000/v1
OPENAI_MODEL=app-test
OPENAI_TIMEOUT=120
OPENAI_MAX_TOKENS=4000
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=none

# Optional private agent bridge: unique role tokens, minimum 32 characters each.
# Keep this endpoint on an internal network or host loopback.
PROJECT_WORKFLOW_RUNTIME_TOKENS_JSON=
